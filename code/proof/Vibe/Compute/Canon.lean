/-!
# Vibe Computation Lab: Canonical Restatements in Mathlib's Vocabulary

The core files `PairRules`, `PartitionedStep`, `NoContraction` and the L02 round state their results
over our own finite enumerations (mixed-radix codes, `List` filters, integer metrics on `Fin n`).
This module restates each one in Mathlib's vocabulary, so a referee reads the headline statements
below knowing only Mathlib and `Vibe.Tone` (the three tones `neg`, `zero`, `pos` with values
`-1, 0, 1` and the negation `Tone.dual`). Every canonical statement is proved from the core theorem
and comes with a bridge theorem tying it to the core statement, so nothing is restated loosely.

Canonical statements (each bridge is named beside it):

1. `ruleGroup`: the permutations of `Tone × Tone` that keep the pair sum, a `Subgroup` of
   `Equiv.Perm (Tone × Tone)`. `thm_canon_rule_group_card`: `Fintype.card ruleGroup = 24`.
   Bridges: `thm_canon_rule_group_iff_core` (a map is a conservative reversible pair rule iff it is
   an element of `ruleGroup`), `thm_canon_rule_code_equiv` (the explicit bijection with the 24
   codes of `prRuleCodes`), `thm_canon_rule_group_gen` (the elements are exactly the decoded tables
   the TypeScript census exported).
2. `klein`: the subgroup generated by the cell swap and the pair negation, of order 4
   (`thm_canon_klein`), acting on `ruleGroup` by conjugation. `thm_canon_rule_classes`: the action
   has exactly 12 orbits (`Nat.card (MulAction.orbitRel.Quotient klein ruleGroup) = 12`). Bridges:
   `thm_canon_orbit_iff_core` (two rules share an orbit iff the code of one is in the core orbit
   list `prOrbit` of the other), and the quotient is in explicit bijection with `prClassReps`.
3. `blockPerm`: one partitioned block on `Fin n` (a list of disjoint cell pairs, each updated by
   `Function.update`) as an `Equiv.Perm (Fin n → Tone)`. `thm_canon_block_perm`: its inverse is
   the block of `σ⁻¹`, it keeps `∑ i, (x i).value`, it keeps `D` when `σ` does, and it commutes
   with global negation when `σ` commutes with the pair negation. Bridge:
   `thm_canon_block_eq_core` (`blockPerm` is `psBlock`, the sum is `psTotal`).
4. `thm_canon_round_perm`: the L02 round `roundPerm σ s` is an `Equiv.Perm` whose group inverse is
   the round of `σ⁻¹` over the reversed schedule, and on a finite vertex type it keeps
   `∑ v, (x v).value` for every `σ ∈ ruleGroup`. Bridge: `thm_canon_round_eq_core`.
5. `thm_canon_no_strict_contraction`: no bijection of a finite `MetricSpace` with at least 2 points
   is a strict contraction. Bridge: `thm_canon_no_contraction_int_iff` (restricted to integer-valued
   metrics, the canonical statement is equivalent to the core headline
   `thm_ms_reversible_no_global_contraction`).
6. `thm_canon_bijection_no_collapse`: the claim the memory argument needs
   and the core file does not prove. Every bijection `f` of a finite metric space has `f ^ k = 1`
   for some `k > 0`, and no pair of distinct points has a distance along the orbit that tends to
   `0`. This one is new, not a restatement: it has no core counterpart.

Mathlib (`Equiv.Perm`, `Subgroup`, `Subgroup.closure`, `MulAction.orbitRel`, `Fintype.card`,
`Nat.card`, `Function.update`, `Finset.sum`, `MetricSpace`, `orderOf`, `Filter.Tendsto`), zero
`sorry`, zero `native_decide`.
-/

set_option autoImplicit false

namespace Vibe

namespace Compute

namespace Canon

open Function Filter Topology

/-! ## Vocabulary: tones, pairs, the swap and the negation -/

/-- The three tones form a finite type. -/
instance toneFintype : Fintype Tone where
  elems := {.neg, .zero, .pos}
  complete := by intro t; cases t <;> decide

/-- Negation of a tone as a permutation (`Tone.dual`: `-1 ↔ +1`, `0` fixed). -/
def toneNeg : Equiv.Perm Tone where
  toFun := Tone.dual
  invFun := Tone.dual
  left_inv t := by cases t <;> rfl
  right_inv t := by cases t <;> rfl

/-- The cell swap `(a, b) ↦ (b, a)`. -/
def pairSwap : Equiv.Perm (Tone × Tone) := Equiv.prodComm Tone Tone

/-- The pair negation `(a, b) ↦ (-a, -b)`. -/
def pairNeg : Equiv.Perm (Tone × Tone) := Equiv.prodCongr toneNeg toneNeg

/-- The sum of a pair, `a + b`. -/
def pairSum (p : Tone × Tone) : ℤ := p.1.value + p.2.value

/-- The excitation count of a pair, `a² + b²`. -/
def pairSq (p : Tone × Tone) : ℤ := p.1.value ^ 2 + p.2.value ^ 2

/-! ## 1. The 24 rules as a subgroup of `Equiv.Perm (Tone × Tone)` -/

/-- The permutations of `Tone × Tone` that keep the pair sum. -/
def ruleGroup : Subgroup (Equiv.Perm (Tone × Tone)) where
  carrier := {σ | ∀ p, pairSum (σ p) = pairSum p}
  one_mem' := fun _ => rfl
  mul_mem' := by
    intro σ τ hσ hτ p
    show pairSum (σ (τ p)) = pairSum p
    rw [hσ, hτ]
  inv_mem' := by
    intro σ hσ p
    have h := hσ (σ⁻¹ p)
    rw [show σ (σ⁻¹ p) = p from σ.apply_symm_apply p] at h
    exact h.symm

-- [helper]
theorem mem_ruleGroup {σ : Equiv.Perm (Tone × Tone)} :
    σ ∈ ruleGroup ↔ ∀ p, pairSum (σ p) = pairSum p := Iff.rfl

instance : DecidablePred (· ∈ ruleGroup) := fun σ =>
  decidable_of_iff (∀ p, pairSum (σ p) = pairSum p) mem_ruleGroup.symm

private theorem pairSum_eq_prSum (p : Pair) : pairSum p = prSum p := rfl

private theorem sumPres_iff (f : Pair → Pair) : PrSumPres f ↔ ∀ p, pairSum (f p) = pairSum p :=
  Iff.rfl

private theorem inj_iff (f : Pair → Pair) : PrInj f ↔ Injective f := Iff.rfl

/-- A sum-preserving map is the table of its own code. -/
private theorem table_code (f : Pair → Pair) (h : PrSumPres f) : ∀ p, prTable (prCodeOf f) p = f p :=
  fun p => ((pr_table_code f h).2 p).symm

private theorem lt_of_mem_codes {n : Nat} (h : n ∈ prRuleCodes) : n < 432 := by
  unfold prRuleCodes at h
  exact List.mem_range.1 (List.mem_filter.1 h).1

private theorem code_mem (σ : ruleGroup) : prCodeOf σ.1 ∈ prRuleCodes := by
  obtain ⟨n, hn, hT⟩ := (thm_pair_rules_card.2.2.2.2.2 σ.1).1 ⟨σ.2, σ.1.injective⟩
  have hf : (σ.1 : Pair → Pair) = prTable n := funext hT
  rw [hf, pr_code_table n (lt_of_mem_codes hn)]
  exact hn

private theorem table_inj {n : Nat} (h : n ∈ prRuleCodes) : Injective (prTable n) :=
  ((thm_pair_rules_card.2.2.2.2.2 (prTable n)).2 ⟨n, h, fun _ => rfl⟩).2

/-- The rule of code `n` as a permutation. -/
noncomputable def permOfCode (n : Nat) (h : n ∈ prRuleCodes) : Equiv.Perm Pair :=
  Equiv.ofBijective (prTable n) (Finite.injective_iff_bijective.1 (table_inj h))

private theorem permOfCode_mem (n : Nat) (h : n ∈ prRuleCodes) : permOfCode n h ∈ ruleGroup :=
  fun p => pr_table_sumPres n p

/-- Two elements of `ruleGroup` with the same code are equal. -/
private theorem code_inj {σ τ : Equiv.Perm Pair} (hσ : σ ∈ ruleGroup) (hτ : τ ∈ ruleGroup)
    (h : prCodeOf σ = prCodeOf τ) : σ = τ := by
  apply Equiv.ext
  intro p
  rw [← table_code σ hσ p, ← table_code τ hτ p, h]

/-- The elements of `ruleGroup` are in bijection with the 24 codes of `prRuleCodes`. -/
noncomputable def ruleCodeEquiv : ruleGroup ≃ {n : Nat // n ∈ prRuleCodes} where
  toFun σ := ⟨prCodeOf σ.1, code_mem σ⟩
  invFun n := ⟨permOfCode n.1 n.2, permOfCode_mem n.1 n.2⟩
  left_inv σ := by
    apply Subtype.ext
    apply Equiv.ext
    intro p
    exact table_code σ.1 σ.2 p
  right_inv n := by
    apply Subtype.ext
    exact pr_code_table n.1 (lt_of_mem_codes n.2)

private theorem natCard_list_subtype (l : List Nat) (h : l.Nodup) : Nat.card {x // x ∈ l} = l.length := by
  have e : {x // x ∈ l} ≃ {x // x ∈ l.toFinset} :=
    Equiv.subtypeEquivRight (fun x => (List.mem_toFinset).symm)
  rw [Nat.card_congr e, Nat.card_eq_fintype_card, Fintype.card_coe, List.card_toFinset,
    h.dedup]

/-- **Bridge (24 rules).** A map of `Tone × Tone` is a conservative reversible pair rule in the
    sense of `PairRules` (sum-preserving and injective) iff it is an element of `ruleGroup`, and an
    element of `ruleGroup` is exactly a permutation that is sum-preserving in the core sense. -/
theorem thm_canon_rule_group_iff_core :
    (∀ σ : Equiv.Perm (Tone × Tone), σ ∈ ruleGroup ↔ PrSumPres σ) ∧
    (∀ B : Tone × Tone → Tone × Tone,
      (PrSumPres B ∧ PrInj B) ↔ ∃ σ ∈ ruleGroup, (σ : Tone × Tone → Tone × Tone) = B) := by
  refine ⟨fun σ => Iff.rfl, fun B => ⟨?_, ?_⟩⟩
  · rintro ⟨hS, hI⟩
    exact ⟨Equiv.ofBijective B (Finite.injective_iff_bijective.1 hI), hS, rfl⟩
  · rintro ⟨σ, hσ, rfl⟩
    exact ⟨hσ, σ.injective⟩

/-- **Bridge (codes).** `ruleCodeEquiv` sends a rule to its core code `prCodeOf`, and its inverse
    sends a code `n` to the permutation whose underlying map is the core table `prTable n`. -/
theorem thm_canon_rule_code_equiv :
    (∀ σ : ruleGroup, (ruleCodeEquiv σ).1 = prCodeOf σ.1) ∧
    (∀ n : {n : Nat // n ∈ prRuleCodes},
      ((ruleCodeEquiv.symm n).1 : Tone × Tone → Tone × Tone) = prTable n.1) :=
  ⟨fun _ => rfl, fun _ => rfl⟩

/-- **The 24 rules, canonically.** Exactly 24 permutations of `Tone × Tone` keep the pair sum:
    `ruleGroup` is a subgroup of `Equiv.Perm (Tone × Tone)` of order 24. Proved from
    `thm_pair_rules_card` through `ruleCodeEquiv`. -/
theorem thm_canon_rule_group_card :
    Fintype.card ruleGroup = 24 ∧ Nat.card ruleGroup = 24 := by
  have h : Nat.card ruleGroup = 24 := by
    rw [Nat.card_congr ruleCodeEquiv,
      natCard_list_subtype _ thm_pair_rules_card.2.2.2.2.1, thm_pair_rules_card.2.2.2.1]
  exact ⟨by rw [← Nat.card_eq_fintype_card]; exact h, h⟩

/-- **Bridge (the code that ran).** The elements of `ruleGroup` are exactly the decoded rule tables
    `task/lean-export.ts` exported from the TypeScript census (`gen_pair_rules_eq`). -/
theorem thm_canon_rule_group_gen (B : Tone × Tone → Tone × Tone) :
    (∃ σ ∈ ruleGroup, (σ : Tone × Tone → Tone × Tone) = B) ↔
      ∃ t ∈ Generated.pairRuleTables, ∀ p, B p = PairRuleLink.decodeRule t p := by
  rw [← (thm_canon_rule_group_iff_core.2 B)]
  exact PairRuleLink.gen_pair_rules_eq.2.2.2.2 B

/-! ## 2. The 12 classes as the orbits of the swap-and-negation group -/

/-- The group generated by the cell swap and the pair negation. -/
def klein : Subgroup (Equiv.Perm (Tone × Tone)) := Subgroup.closure {pairSwap, pairNeg}

private theorem perm_ext {g h : Equiv.Perm (Tone × Tone)}
    (H : ∀ a b : Tone, g (a, b) = h (a, b)) : g = h :=
  Equiv.ext fun p => H p.1 p.2

private theorem swap_swap : pairSwap * pairSwap = 1 :=
  perm_ext fun _ _ => rfl

private theorem neg_neg : pairNeg * pairNeg = 1 :=
  perm_ext fun a b => by cases a <;> cases b <;> rfl

private theorem swap_neg_comm : pairNeg * pairSwap = pairSwap * pairNeg :=
  perm_ext fun _ _ => rfl

/-- The four elements `1, P, C, PC`, as a predicate. -/
private def IsKlein (g : Equiv.Perm (Tone × Tone)) : Prop :=
  g = 1 ∨ g = pairSwap ∨ g = pairNeg ∨ g = pairSwap * pairNeg

private theorem isKlein_mul {g h : Equiv.Perm (Tone × Tone)} (hg : IsKlein g) (hh : IsKlein h) :
    IsKlein (g * h) := by
  unfold IsKlein at *
  rcases hg with rfl | rfl | rfl | rfl <;> rcases hh with rfl | rfl | rfl | rfl <;>
    first
    | (left; apply perm_ext; intro a b; cases a <;> cases b <;> rfl)
    | (right; left; apply perm_ext; intro a b; cases a <;> cases b <;> rfl)
    | (right; right; left; apply perm_ext; intro a b; cases a <;> cases b <;> rfl)
    | (right; right; right; apply perm_ext; intro a b; cases a <;> cases b <;> rfl)

private theorem isKlein_inv {g : Equiv.Perm (Tone × Tone)} (hg : IsKlein g) : IsKlein g⁻¹ := by
  unfold IsKlein at *
  rcases hg with rfl | rfl | rfl | rfl
  · left; exact inv_one
  · right; left; exact inv_eq_of_mul_eq_one_right swap_swap
  · right; right; left; exact inv_eq_of_mul_eq_one_right neg_neg
  · right; right; right
    apply inv_eq_of_mul_eq_one_right
    apply perm_ext; intro a b; cases a <;> cases b <;> rfl

private theorem mem_klein_iff (g : Equiv.Perm (Tone × Tone)) : g ∈ klein ↔ IsKlein g := by
  constructor
  · intro hg
    induction hg using Subgroup.closure_induction with
    | mem x hx =>
      rcases hx with rfl | hx
      · exact Or.inr (Or.inl rfl)
      · rw [Set.mem_singleton_iff] at hx
        exact Or.inr (Or.inr (Or.inl hx))
    | one => exact Or.inl rfl
    | mul x y _ _ hx hy => exact isKlein_mul hx hy
    | inv x _ hx => exact isKlein_inv hx
  · intro hg
    have hP : pairSwap ∈ klein := Subgroup.subset_closure (Set.mem_insert _ _)
    have hC : pairNeg ∈ klein := Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)
    rcases hg with rfl | rfl | rfl | rfl
    · exact klein.one_mem
    · exact hP
    · exact hC
    · exact klein.mul_mem hP hC

private theorem klein_distinct :
    (1 : Equiv.Perm (Tone × Tone)) ≠ pairSwap ∧ (1 : Equiv.Perm (Tone × Tone)) ≠ pairNeg ∧
    (1 : Equiv.Perm (Tone × Tone)) ≠ pairSwap * pairNeg ∧ pairSwap ≠ pairNeg ∧
    pairSwap ≠ pairSwap * pairNeg ∧ pairNeg ≠ pairSwap * pairNeg := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> intro h
  · exact absurd (congrArg (fun g => g (.neg, .zero)) h) (by decide)
  · exact absurd (congrArg (fun g => g (.neg, .zero)) h) (by decide)
  · exact absurd (congrArg (fun g => g (.neg, .neg)) h) (by decide)
  · exact absurd (congrArg (fun g => g (.neg, .zero)) h) (by decide)
  · exact absurd (congrArg (fun g => g (.neg, .zero)) h) (by decide)
  · exact absurd (congrArg (fun g => g (.neg, .zero)) h) (by decide)

/-- `klein` is the Klein four-group `{1, P, C, PC}`: `P` and `C` are commuting involutions, and the
    four elements are distinct. -/
theorem thm_canon_klein :
    (∀ g, g ∈ klein ↔ g = 1 ∨ g = pairSwap ∨ g = pairNeg ∨ g = pairSwap * pairNeg) ∧
    pairSwap * pairSwap = 1 ∧ pairNeg * pairNeg = 1 ∧ pairNeg * pairSwap = pairSwap * pairNeg ∧
    Nat.card klein = 4 := by
  refine ⟨mem_klein_iff, swap_swap, neg_neg, swap_neg_comm, ?_⟩
  obtain ⟨d1, d2, d3, d4, d5, d6⟩ := klein_distinct
  have e : klein ≃ {g // g ∈ ({1, pairSwap, pairNeg, pairSwap * pairNeg} :
      Finset (Equiv.Perm (Tone × Tone)))} :=
    Equiv.subtypeEquivRight fun g => by
      rw [mem_klein_iff]
      simp only [IsKlein, Finset.mem_insert, Finset.mem_singleton]
  rw [Nat.card_congr e, Nat.card_eq_fintype_card, Fintype.card_coe]
  rw [Finset.card_insert_of_notMem (by simp [d1, d2, d3]),
    Finset.card_insert_of_notMem (by simp [d4, d5]),
    Finset.card_insert_of_notMem (by simp [d6]), Finset.card_singleton]

/-- Each element of `klein` scales the pair sum by a sign. -/
private theorem klein_sum_sign {g : Equiv.Perm (Tone × Tone)} (hg : g ∈ klein) :
    ∃ ε : ℤ, ∀ p, pairSum (g p) = ε * pairSum p := by
  rcases (mem_klein_iff g).1 hg with rfl | rfl | rfl | rfl
  · exact ⟨1, fun p => (one_mul _).symm⟩
  · refine ⟨1, fun p => ?_⟩
    rcases p with ⟨a, b⟩; cases a <;> cases b <;> decide
  · refine ⟨-1, fun p => ?_⟩
    rcases p with ⟨a, b⟩; cases a <;> cases b <;> decide
  · refine ⟨-1, fun p => ?_⟩
    rcases p with ⟨a, b⟩; cases a <;> cases b <;> decide

/-- `klein` normalizes `ruleGroup`. -/
private theorem conj_mem {g σ : Equiv.Perm (Tone × Tone)} (hg : g ∈ klein) (hσ : σ ∈ ruleGroup) :
    g * σ * g⁻¹ ∈ ruleGroup := by
  obtain ⟨ε, hε⟩ := klein_sum_sign hg
  intro p
  show pairSum (g (σ (g⁻¹ p))) = pairSum p
  have h1 := hε (g⁻¹ p)
  rw [show g (g⁻¹ p) = p from g.apply_symm_apply p] at h1
  rw [hε, hσ, ← h1]

/-- `klein` acts on `ruleGroup` by conjugation, `g • σ = g * σ * g⁻¹`. -/
instance kleinConj : MulAction klein ruleGroup where
  smul g σ := ⟨g.1 * σ.1 * g.1⁻¹, conj_mem g.2 σ.2⟩
  one_smul σ := Subtype.ext (by show 1 * σ.1 * 1⁻¹ = σ.1; simp)
  mul_smul g h σ := Subtype.ext (by
    show g.1 * h.1 * σ.1 * (g.1 * h.1)⁻¹ = g.1 * (h.1 * σ.1 * h.1⁻¹) * g.1⁻¹
    simp only [mul_inv_rev, mul_assoc])

-- [helper]
theorem smul_coe (g : klein) (σ : ruleGroup) :
    ((g • σ : ruleGroup) : Equiv.Perm (Tone × Tone)) = g.1 * σ.1 * g.1⁻¹ := rfl

/-- The conjugate by `P`, `C`, `PC` is the core conjugate `prConjP`, `prConjC`, both. -/
private theorem conj_P (σ : Equiv.Perm Pair) :
    ((pairSwap * σ * pairSwap⁻¹ : Equiv.Perm Pair) : Pair → Pair) = prConjP σ := rfl

private theorem conj_C (σ : Equiv.Perm Pair) :
    ((pairNeg * σ * pairNeg⁻¹ : Equiv.Perm Pair) : Pair → Pair) = prConjC σ := rfl

private theorem conj_PC (σ : Equiv.Perm Pair) :
    (((pairSwap * pairNeg) * σ * (pairSwap * pairNeg)⁻¹ : Equiv.Perm Pair) : Pair → Pair) =
      prConjP (prConjC σ) := rfl

private theorem orbit_list (σ : ruleGroup) :
    prOrbit (prCodeOf σ.1) = [prCodeOf σ.1, prCodeOf (prConjP σ.1), prCodeOf (prConjC σ.1),
      prCodeOf (prConjP (prConjC σ.1))] := by
  have hf : prTable (prCodeOf σ.1) = σ.1 := funext (table_code σ.1 σ.2)
  unfold prOrbit
  rw [hf]

/-- The code of `g • σ` is in the core orbit list of the code of `σ`. -/
private theorem code_smul_mem (g : klein) (σ : ruleGroup) :
    prCodeOf (g • σ).1 ∈ prOrbit (prCodeOf σ.1) := by
  rw [orbit_list, smul_coe]
  rcases (mem_klein_iff g.1).1 g.2 with h | h | h | h <;> rw [h]
  · simp
  · rw [conj_P]; simp
  · rw [conj_C]; simp
  · rw [conj_PC]; simp

/-- **Bridge (orbits).** Two rules lie in one `klein` orbit iff the code of one is in the core orbit
    list `prOrbit` of the code of the other. -/
theorem thm_canon_orbit_iff_core (σ τ : ruleGroup) :
    τ ∈ MulAction.orbit klein σ ↔ prCodeOf τ.1 ∈ prOrbit (prCodeOf σ.1) := by
  constructor
  · rintro ⟨g, rfl⟩
    exact code_smul_mem g σ
  · intro h
    have hP : pairSwap ∈ klein := Subgroup.subset_closure (Set.mem_insert _ _)
    have hC : pairNeg ∈ klein := Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)
    have hPC : pairSwap * pairNeg ∈ klein := klein.mul_mem hP hC
    have key : ∀ g : klein, prCodeOf τ.1 = prCodeOf (g • σ).1 → τ ∈ MulAction.orbit klein σ :=
      fun g hg => ⟨g, Subtype.ext (code_inj (g • σ).2 τ.2 hg.symm)⟩
    rw [orbit_list] at h
    simp only [List.mem_cons, List.not_mem_nil, or_false] at h
    rcases h with h | h | h | h
    · exact key 1 (by rw [one_smul]; exact h)
    · exact key ⟨_, hP⟩ (by rw [smul_coe, conj_P]; exact h)
    · exact key ⟨_, hC⟩ (by rw [smul_coe, conj_C]; exact h)
    · exact key ⟨_, hPC⟩ (by rw [smul_coe, conj_PC]; exact h)

private theorem min_mem_reps : ∀ n ∈ prRuleCodes, prOrbitMin n ∈ prClassReps := by
  unfold prClassReps
  rw [pr_rule_codes_eq]; decide

private theorem min_orbit : ∀ n ∈ prRuleCodes, ∀ m ∈ prOrbit n, prOrbitMin m = prOrbitMin n := by
  rw [pr_rule_codes_eq]; decide

private theorem min_eq_orbit :
    ∀ n ∈ prRuleCodes, ∀ m ∈ prRuleCodes, prOrbitMin n = prOrbitMin m → m ∈ prOrbit n := by
  rw [pr_rule_codes_eq]; decide

private theorem rep_min {r : Nat} (h : r ∈ prClassReps) : prOrbitMin r = r := by
  unfold prClassReps at h
  exact of_decide_eq_true (List.mem_filter.1 h).2

private theorem rep_mem {r : Nat} (h : r ∈ prClassReps) : r ∈ prRuleCodes :=
  thm_pair_rule_classes.2.2.2.2.2.2.1 h

/-- The class of a rule: the least code in its orbit, a member of `prClassReps`. -/
private def classOf (σ : ruleGroup) : {r : Nat // r ∈ prClassReps} :=
  ⟨prOrbitMin (prCodeOf σ.1), min_mem_reps _ (code_mem σ)⟩

/-- The orbits of `klein` on `ruleGroup` are in bijection with the core class representatives
    `prClassReps`. -/
noncomputable def orbitClassEquiv :
    MulAction.orbitRel.Quotient klein ruleGroup ≃ {r : Nat // r ∈ prClassReps} :=
  Equiv.ofBijective
    (Quotient.lift classOf (by
      intro a b hab
      have hab' : a ∈ MulAction.orbit klein b := hab
      rw [thm_canon_orbit_iff_core] at hab'
      exact Subtype.ext (min_orbit _ (code_mem b) _ hab')))
    (by
      constructor
      · intro qa qb h
        induction qa using Quotient.inductionOn with
        | h a =>
          induction qb using Quotient.inductionOn with
          | h b =>
            apply Quotient.sound
            show a ∈ MulAction.orbit klein b
            rw [thm_canon_orbit_iff_core]
            exact min_eq_orbit _ (code_mem b) _ (code_mem a) (congrArg Subtype.val h).symm
      · intro r
        refine ⟨Quotient.mk _ (ruleCodeEquiv.symm ⟨r.1, rep_mem r.2⟩), ?_⟩
        apply Subtype.ext
        show prOrbitMin (prCodeOf (ruleCodeEquiv.symm ⟨r.1, rep_mem r.2⟩).1) = r.1
        have hc : prCodeOf (ruleCodeEquiv.symm ⟨r.1, rep_mem r.2⟩).1 = r.1 :=
          congrArg Subtype.val (ruleCodeEquiv.apply_symm_apply ⟨r.1, rep_mem r.2⟩)
        rw [hc, rep_min r.2])

/-- **The 12 classes, canonically.** The Klein four-group generated by the cell swap and the pair
    negation acts on `ruleGroup` by conjugation with exactly 12 orbits. Proved from
    `thm_pair_rule_classes` through `orbitClassEquiv`, which sends each orbit to its core class
    representative (the least code in it). -/
theorem thm_canon_rule_classes :
    Nat.card (MulAction.orbitRel.Quotient klein ruleGroup) = 12 ∧
    (∀ σ : ruleGroup, (orbitClassEquiv (Quotient.mk _ σ)).1 = prOrbitMin (prCodeOf σ.1)) := by
  refine ⟨?_, fun _ => rfl⟩
  have hnd : prClassReps.Nodup := thm_pair_rules_card.2.2.2.2.1.sublist List.filter_sublist
  rw [Nat.card_congr orbitClassEquiv, natCard_list_subtype _ hnd,
    thm_pair_rule_classes.2.2.2.2.2.2.2.1]

/-! ## 3. One partitioned block as an `Equiv.Perm` of configurations on `Fin n` -/

/-- One partitioned block: apply the pair map `σ` to the listed cell pairs in turn, writing the two
    new tones with `Function.update`. -/
def canonBlock {n : Nat} (σ : Tone × Tone → Tone × Tone) (es : List (Fin n × Fin n))
    (x : Fin n → Tone) : Fin n → Tone :=
  es.foldl (fun y e => update (update y e.1 (σ (y e.1, y e.2)).1) e.2 (σ (y e.1, y e.2)).2) x

/-- The cells of a block are pairwise distinct (the block is a matching). -/
def BlockDisjoint {n : Nat} (es : List (Fin n × Fin n)) : Prop :=
  (es.flatMap fun e => [e.1, e.2]).Nodup

private theorem disjoint_ne {n : Nat} {es : List (Fin n × Fin n)} (h : BlockDisjoint es) :
    ∀ e ∈ es, e.1 ≠ e.2 := by
  intro e he
  have h2 := (List.nodup_flatMap.1 h).1 e he
  simpa using h2

private theorem apply_eq_update {n : Nat} (f : Pair → Pair) (e : Fin n × Fin n) (h : e.1 ≠ e.2)
    (x : Fin n → Tone) :
    update (update x e.1 (f (x e.1, x e.2)).1) e.2 (f (x e.1, x e.2)).2 = psApplyPair f e x := by
  funext k
  simp only [update_apply, psApplyPair]
  by_cases h1 : k = e.1
  · simp [h1, h]
  · by_cases h2 : k = e.2
    · simp [h2, Ne.symm h]
    · simp [h1, h2]

private theorem canonBlock_eq {n : Nat} (f : Pair → Pair) (es : List (Fin n × Fin n))
    (h : ∀ e ∈ es, e.1 ≠ e.2) (x : Fin n → Tone) : canonBlock f es x = psBlock f es x := by
  induction es generalizing x with
  | nil => rfl
  | cons e rest ih =>
    show canonBlock f rest (update (update x e.1 (f (x e.1, x e.2)).1) e.2 (f (x e.1, x e.2)).2) =
      psBlock f rest (psApplyPair f e x)
    rw [apply_eq_update f e (h e List.mem_cons_self) x,
      ih (fun d hd => h d (List.mem_cons_of_mem e hd))]

private theorem sum_eq_psTotal {n : Nat} (w : Tone → ℤ) (x : Fin n → Tone) :
    ∑ i, w (x i) = psTotal w x := by
  rw [Fin.sum_univ_def]
  rfl

/-- The core invariants of one block, for an element of `ruleGroup`. -/
private theorem block_core {n : Nat} {σ : Equiv.Perm (Tone × Tone)} (hσ : σ ∈ ruleGroup)
    {es : List (Fin n × Fin n)} (hD : BlockDisjoint es) :
    (∀ x, psBlock σ.symm es (psBlock σ es x) = x) ∧
    (∀ x, psBlock σ es (psBlock σ.symm es x) = x) ∧
    (∀ x, psBlock σ.symm es.reverse (psBlock σ es x) = x) ∧
    (∀ x, psTotal Tone.value (psBlock σ es x) = psTotal Tone.value x) ∧
    (PrDCons σ → ∀ x, psTotal psSq (psBlock σ es x) = psTotal psSq x) ∧
    ((∀ p, σ (prNeg p) = prNeg (σ p)) →
      ∀ x, psBlock σ es (psNegate x) = psNegate (psBlock σ es x)) :=
  thm_cf_partitioned_block_global_invariants es hD σ σ.symm
    (fun p => σ.symm_apply_apply p) (fun p => σ.apply_symm_apply p) hσ

/-- One partitioned block of a sum-preserving permutation `σ` of `Tone × Tone` on a disjoint
    block, as a permutation of the configurations `Fin n → Tone`. -/
def blockPerm {n : Nat} (σ : Equiv.Perm (Tone × Tone)) (hσ : σ ∈ ruleGroup)
    (es : List (Fin n × Fin n)) (hD : BlockDisjoint es) : Equiv.Perm (Fin n → Tone) where
  toFun := canonBlock σ es
  invFun := canonBlock (σ⁻¹ : Equiv.Perm (Tone × Tone)) es
  left_inv x := by
    have hne := disjoint_ne hD
    show canonBlock (σ⁻¹ : Equiv.Perm (Tone × Tone)) es (canonBlock σ es x) = x
    rw [canonBlock_eq _ es hne, canonBlock_eq _ es hne]
    exact (block_core hσ hD).1 x
  right_inv x := by
    have hne := disjoint_ne hD
    show canonBlock σ es (canonBlock (σ⁻¹ : Equiv.Perm (Tone × Tone)) es x) = x
    rw [canonBlock_eq _ es hne, canonBlock_eq _ es hne]
    exact (block_core hσ hD).2.1 x

/-- **Bridge (block).** `blockPerm` is the core block `psBlock`, and `∑ i, w (x i)` is the core
    total `psTotal w x`. -/
theorem thm_canon_block_eq_core {n : Nat} (σ : Equiv.Perm (Tone × Tone)) (hσ : σ ∈ ruleGroup)
    (es : List (Fin n × Fin n)) (hD : BlockDisjoint es) :
    ((blockPerm σ hσ es hD : Equiv.Perm (Fin n → Tone)) : (Fin n → Tone) → Fin n → Tone) =
      psBlock σ es ∧
    BlockDisjoint es = PsDisjoint es ∧
    (∀ (w : Tone → ℤ) (x : Fin n → Tone), ∑ i, w (x i) = psTotal w x) :=
  ⟨funext (canonBlock_eq σ es (disjoint_ne hD)), rfl, sum_eq_psTotal⟩

/-- **One block, canonically.** For a sum-preserving permutation `σ` of `Tone × Tone` and a block
    of disjoint cell pairs on `Fin n`: the block is a permutation of `Fin n → Tone` whose group
    inverse is the block of `σ⁻¹`; it keeps the total charge `∑ i, (x i).value`; it keeps
    `∑ i, (x i).value ^ 2` when `σ` keeps `a² + b²`; and it commutes with global negation when `σ`
    commutes with the pair negation. Proved from `thm_cf_partitioned_block_global_invariants`. -/
theorem thm_canon_block_perm {n : Nat} (σ : Equiv.Perm (Tone × Tone)) (hσ : σ ∈ ruleGroup)
    (es : List (Fin n × Fin n)) (hD : BlockDisjoint es) :
    (∀ x, (blockPerm σ hσ es hD)⁻¹ x = canonBlock (σ⁻¹ : Equiv.Perm (Tone × Tone)) es x) ∧
    (∀ x, ∑ i, (blockPerm σ hσ es hD x i).value = ∑ i, (x i).value) ∧
    ((∀ p, pairSq (σ p) = pairSq p) →
      ∀ x, ∑ i, (blockPerm σ hσ es hD x i).value ^ 2 = ∑ i, (x i).value ^ 2) ∧
    (σ * pairNeg = pairNeg * σ →
      ∀ x, blockPerm σ hσ es hD (fun i => (x i).dual) = fun i => (blockPerm σ hσ es hD x i).dual) := by
  have hne := disjoint_ne hD
  have hb : ∀ x, blockPerm σ hσ es hD x = psBlock σ es x := fun x => canonBlock_eq σ es hne x
  obtain ⟨_, _, _, hQ, hDc, hN⟩ := block_core hσ hD
  refine ⟨fun _ => rfl, ?_, ?_, ?_⟩
  · intro x
    rw [hb, sum_eq_psTotal, sum_eq_psTotal]
    exact hQ x
  · intro hsq x
    have hw : ∀ t : Tone, t.value ^ 2 = psSq t := fun t => by unfold psSq; ring
    simp only [hw]
    rw [hb, sum_eq_psTotal, sum_eq_psTotal]
    refine hDc (fun p => ?_) x
    have h := hsq p
    unfold pairSq at h
    unfold prD
    nlinarith [h]
  · intro hc x
    rw [hb, hb]
    refine hN (fun p => ?_) x
    exact congrArg (fun g : Equiv.Perm (Tone × Tone) => g p) hc

/-! ## 4. The L02 round, canonically -/

/-- **The round, canonically.** For any vertex type and schedule, the round of a permutation `σ`
    of `Tone × Tone` is a permutation of `V → Tone` whose group inverse is the round of `σ⁻¹` over
    the reversed schedule; on a finite vertex type, for every `σ ∈ ruleGroup`, it keeps the total
    charge `∑ v, (x v).value`. Proved from `thm_cmp_round_perm_charge_negation`. -/
theorem thm_canon_round_perm {V : Type*} [DecidableEq V] (σ : Equiv.Perm (Tone × Tone))
    (s : Schedule V) :
    (roundPerm σ s)⁻¹ = roundPerm σ⁻¹ s.reverse ∧
    ([Fintype V] → σ ∈ ruleGroup →
      ∀ x : V → Tone, ∑ v, (roundPerm σ s x v).value = ∑ v, (x v).value) := by
  refine ⟨Equiv.ext fun _ => rfl, ?_⟩
  intro _ hσ x
  have hk : ∀ M ∈ s, M.Keeps σ := fun M _ => Or.inr (Set.toFinite _)
  have h := (thm_cmp_round_perm_charge_negation σ hσ s hk).2.2.2.1 ⟨x, Set.toFinite _⟩
  unfold charge total at h
  rw [finsum_eq_sum_of_fintype, finsum_eq_sum_of_fintype] at h
  exact h

/-- **Bridge (round).** The canonical round is the core `round`, and its group inverse is the core
    `roundBack` of `σ.symm`. -/
theorem thm_canon_round_eq_core {V : Type*} [DecidableEq V] (σ : Equiv.Perm (Tone × Tone))
    (s : Schedule V) :
    ((roundPerm σ s : Equiv.Perm (V → Tone)) : (V → Tone) → V → Tone) = round σ s ∧
    (((roundPerm σ s)⁻¹ : Equiv.Perm (V → Tone)) : (V → Tone) → V → Tone) =
      roundBack σ.symm s :=
  ⟨rfl, rfl⟩

/-! ## 5. No strict contraction of a finite metric space -/

/-- **No global contraction, canonically.** No bijection of a finite metric space with at least two
    points is a strict contraction. Proved from `thm_ms_no_strict_contraction_of_surjective`. -/
theorem thm_canon_no_strict_contraction {X : Type*} [MetricSpace X] [Finite X] [Nontrivial X]
    (f : X ≃ X) : ¬ ∀ x y, x ≠ y → dist (f x) (f y) < dist x y := by
  intro hc
  obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin X
  obtain ⟨a, b, hab⟩ := exists_pair_ne X
  refine thm_ms_no_strict_contraction_of_surjective (fun u v : ℝ => u < v) (fun u => lt_irrefl u)
    (fun _ _ _ => lt_trans) (fun i j => dist (e.symm i) (e.symm j)) (fun i => e (f (e.symm i)))
    (fun j => ⟨e (f.symm (e.symm j)), by simp⟩) (e a) (e b) (e.injective.ne hab) ?_
  intro i j hij
  simp only [Equiv.symm_apply_apply]
  exact hc _ _ (fun h => hij (e.symm.injective h))

/-- An integer metric on `Fin n` as a `MetricSpace`. -/
@[instance_reducible]
private def intMetric {n : Nat} (d : Fin n → Fin n → ℤ) (hd : MsFinMetric d) :
    MetricSpace (Fin n) where
  dist x y := (d x y : ℝ)
  dist_self x := by simp [hd.self_zero x]
  dist_comm x y := by rw [hd.symm x y]
  dist_triangle x y z := by exact_mod_cast hd.triangle x y z
  eq_of_dist_eq_zero := by
    intro x y h
    by_contra hne
    have hp := hd.pos_of_ne x y hne
    have h' : (d x y : ℝ) = 0 := h
    exact absurd (by exact_mod_cast h' : d x y = 0) (ne_of_gt hp)

/-- **Bridge (no contraction).** Restricted to integer-valued metrics, the canonical statement is
    exactly the core headline `thm_ms_reversible_no_global_contraction`: each implies the other. -/
theorem thm_canon_no_contraction_int_iff :
    (∀ (X : Type) [MetricSpace X] [Finite X] [Nontrivial X],
      (∀ x y : X, ∃ k : ℤ, dist x y = k) →
      ∀ f : X ≃ X, ¬ ∀ x y, x ≠ y → dist (f x) (f y) < dist x y) ↔
    (∀ n : Nat, 2 ≤ n → ∀ d : Fin n → Fin n → ℤ, MsFinMetric d →
      ∀ f : Fin n → Fin n, (∀ x y, f x = f y → x = y) → (∀ y, ∃ x, f x = y) →
      ¬ ∀ x y, x ≠ y → d (f x) (f y) < d x y) := by
  constructor
  · intro H n hn d hd f hinj hsurj hc
    refine @H (Fin n) (intMetric d hd) _ (Fin.nontrivial_iff_two_le.2 hn) (fun x y => ⟨d x y, rfl⟩) (Equiv.ofBijective f ⟨fun x y h => hinj x y h, hsurj⟩) ?_
    intro x y hxy
    show (d (f x) (f y) : ℝ) < d x y
    exact_mod_cast hc x y hxy
  · intro H X _ _ _ hint f hc
    obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin X
    have _ : Nontrivial (Fin n) := e.symm.nontrivial
    have hn : 2 ≤ n := Fin.nontrivial_iff_two_le.1 inferInstance
    choose d hdd using fun i j : Fin n => hint (e.symm i) (e.symm j)
    have hd : MsFinMetric d := by
      refine ⟨fun x => ?_, fun x y hxy => ?_, fun x y => ?_, fun x y z => ?_⟩
      · have h := hdd x x
        rw [dist_self] at h
        exact_mod_cast h.symm
      · have h := hdd x y
        have hp : 0 < dist (e.symm x) (e.symm y) := dist_pos.2 (e.symm.injective.ne hxy)
        rw [h] at hp
        exact_mod_cast hp
      · have h1 := hdd x y
        have h2 := hdd y x
        rw [dist_comm, h2] at h1
        exact_mod_cast h1.symm
      · have h := dist_triangle (e.symm x) (e.symm y) (e.symm z)
        rw [hdd, hdd, hdd] at h
        exact_mod_cast h
    refine H n hn d hd (fun i => e (f (e.symm i))) (fun x y h => ?_) (fun j => ⟨e (f.symm (e.symm j)), by simp⟩) ?_
    · simpa using h
    · intro i j hij
      have h := hc (e.symm i) (e.symm j) (fun h => hij (e.symm.injective h))
      have h1 := hdd (e (f (e.symm i))) (e (f (e.symm j)))
      simp only [Equiv.symm_apply_apply] at h1
      rw [h1, hdd] at h
      exact_mod_cast h

/-! ## 6. The corrected claim -/

/-- **No pair collapses under a bijection.** Every bijection `f` of a finite
    metric space has `f ^ k = 1` for some `k > 0`, and for every pair of distinct points the
    distance along the orbit, `dist ((f ^ t) x) ((f ^ t) y)`, does not tend to `0`. This is the fact
    the memory argument needs; `NoContraction` proves only the weaker statement that `f` is not a
    strict global contraction. -/
theorem thm_canon_bijection_no_collapse {X : Type*} [MetricSpace X] [Finite X] (f : X ≃ X) :
    (∃ k : ℕ, 0 < k ∧ f ^ k = 1) ∧
    ∀ x y : X, x ≠ y →
      ¬ Tendsto (fun t : ℕ => dist ((f ^ t) x) ((f ^ t) y)) atTop (𝓝 0) := by
  have hk : 0 < orderOf f := orderOf_pos f
  refine ⟨⟨orderOf f, hk, pow_orderOf_eq_one f⟩, fun x y hxy h => ?_⟩
  have hmul : Tendsto (fun t : ℕ => orderOf f * t) atTop atTop :=
    tendsto_atTop_atTop.2 fun b => ⟨b, fun a ha => ha.trans (Nat.le_mul_of_pos_left a hk)⟩
  have hc := h.comp hmul
  have hconst : ((fun t : ℕ => dist ((f ^ t) x) ((f ^ t) y)) ∘ fun t : ℕ => orderOf f * t) =
      fun _ => dist x y := by
    funext t
    simp only [comp_apply, pow_mul, pow_orderOf_eq_one, one_pow, Equiv.Perm.coe_one, id_eq]
  rw [hconst, tendsto_const_nhds_iff] at hc
  exact hxy (dist_eq_zero.1 hc)

