private theorem mat4Vec_s3_1 (v : Vec4) :
    mat4Vec (s3Mat2 ⟨1, by decide⟩) v = negCoordVec ⟨3, by decide⟩ (mat4Vec (s3Mat2 ⟨4, by decide⟩) v) := by
