/-! ## Section 6: Exact `χ_odd` Polynomial Pseudoscalar, Transformation Law & Sharp `k* = 4` Witnesses -/

/-- Self-contained `Bool` membership on `List (Fin 24)` (zero stdlib API drift). -/
def inList24 (a : Fin 24) : List (Fin 24) → Bool
  | [] => false
  | x :: xs => decide (x = a) || inList24 a xs

/-- Self-contained duplicate-free predicate on `List (Fin 24)`. -/
def noDup24 : List (Fin 24) → Bool
  | [] => true
  | x :: xs => !(inList24 x xs) && noDup24 xs

/-- Self-contained single-occurrence erase on `List (Fin 24)`. -/
def erase24 (a : Fin 24) : List (Fin 24) → List (Fin 24)
  | [] => []
  | x :: xs => if x = a then xs else x :: erase24 a xs

/-- Recursive integer sum over `List (Fin 24)`. -/
def sumList24 (f : Fin 24 → Int) : List (Fin 24) → Int
  | [] => 0
  | x :: xs => f x + sumList24 f xs

/-- Canonical list of all 24 slots `0..23`. -/
def allSlots24 : List (Fin 24) := List.finRange 24

/-- Sum of `f : Fin 24 → Int` over all 24 slots. -/
def sumFin24 (f : Fin 24 → Int) : Int := sumList24 f allSlots24

private theorem inList24_erase_of_ne (a x : Fin 24) (l : List (Fin 24))
    (hne : x ≠ a) (h : inList24 x l = true) : inList24 x (erase24 a l) = true := by
  induction l with
  | nil => exact absurd h (by decide)
  | cons y ys ih =>
    simp only [inList24] at h
    if hya : y = a then
      simp only [erase24, if_pos hya]
      have hxy : decide (y = x) = false := decide_eq_false (fun eq => hne (eq.symm.trans hya))
      rw [hxy, Bool.false_or] at h
      exact h
    else
      simp only [erase24, if_neg hya, inList24]
      cases hdy : decide (y = x)
      · rw [hdy] at h
        simp only [Bool.false_or] at h ⊢
        exact ih h
      · simp only [Bool.true_or]

private theorem inList24_of_erase (a x : Fin 24) (l : List (Fin 24))
    (h : inList24 x (erase24 a l) = true) : inList24 x l = true := by
  induction l with
  | nil => exact absurd h (by decide)
  | cons y ys ih =>
    if hya : y = a then
      simp only [erase24, if_pos hya] at h
      simp only [inList24, h, Bool.or_true]
    else
      simp only [erase24, if_neg hya, inList24] at h
      simp only [inList24]
      cases hdy : decide (y = x)
      · rw [hdy] at h
        simp only [Bool.false_or] at h ⊢
        exact ih h
      · simp only [Bool.true_or]

private theorem bool_not_and_eq_true (a b : Bool) :
    (!a && b) = true ↔ a = false ∧ b = true := by
  cases a <;> cases b <;> decide

private theorem inList24_head (x : Fin 24) (xs : List (Fin 24)) :
    inList24 x (x :: xs) = true := by
  unfold inList24
  rw [decide_eq_true rfl, Bool.true_or]

private theorem not_inList24_erase_of_noDup (a : Fin 24) (l : List (Fin 24))
    (hnd : noDup24 l = true) : inList24 a (erase24 a l) = false := by
  induction l with
  | nil => rfl
  | cons y ys ih =>
    simp only [noDup24, bool_not_and_eq_true] at hnd
    if hya : y = a then
      simp only [erase24, if_pos hya]
      rw [← hya]
      exact hnd.1
    else
      simp only [erase24, if_neg hya, inList24]
      have hne : decide (y = a) = false := decide_eq_false hya
      rw [hne, ih hnd.2]
      rfl

private theorem noDup24_erase (a : Fin 24) (l : List (Fin 24))
    (hnd : noDup24 l = true) : noDup24 (erase24 a l) = true := by
  induction l with
  | nil => rfl
  | cons y ys ih =>
    simp only [noDup24, bool_not_and_eq_true] at hnd
    if hya : y = a then
      simp only [erase24, if_pos hya]
      exact hnd.2
    else
      simp only [erase24, if_neg hya, noDup24, bool_not_and_eq_true]
      refine ⟨?_, ih hnd.2⟩
      cases hin : inList24 y (erase24 a ys)
      · rfl
      · have hMem := inList24_of_erase a y ys hin
        rw [hnd.1] at hMem
        exact absurd hMem (by decide)

private theorem sumList24_erase (f : Fin 24 → Int) (a : Fin 24) (l : List (Fin 24))
    (h : inList24 a l = true) : sumList24 f l = f a + sumList24 f (erase24 a l) := by
  induction l with
  | nil => exact absurd h (by decide)
  | cons y ys ih =>
    if hya : y = a then
      simp only [erase24, if_pos hya, sumList24, hya]
    else
      simp only [inList24] at h
      have hne : decide (y = a) = false := decide_eq_false hya
      rw [hne, Bool.false_or] at h
      simp only [erase24, if_neg hya, sumList24]
      rw [ih h]
      omega

private theorem sumList24_eq_of_equiv (f : Fin 24 → Int) (l1 l2 : List (Fin 24))
    (hnd1 : noDup24 l1 = true) (hnd2 : noDup24 l2 = true)
    (heq : ∀ x : Fin 24, inList24 x l1 = inList24 x l2) :
    sumList24 f l1 = sumList24 f l2 := by
  induction l1 generalizing l2 with
  | nil =>
    cases l2 with
    | nil => rfl
    | cons y ys =>
      have hy := heq y
      rw [inList24_head] at hy
      exact absurd hy (by decide)
  | cons x xs ih =>
    simp only [noDup24, bool_not_and_eq_true] at hnd1
    have hx2 : inList24 x l2 = true := by
      rw [← heq x]
      exact inList24_head x xs
    rw [sumList24_erase f x l2 hx2]
    simp only [sumList24]
    have hRest := ih (erase24 x l2) hnd1.2 (noDup24_erase x l2 hnd2) (by
      intro y
      if hyx : y = x then
        rw [hyx, hnd1.1, not_inList24_erase_of_noDup x l2 hnd2]
      else
        have hxy : decide (x = y) = false := decide_eq_false (fun eq => hyx eq.symm)
        have h1 : inList24 y (x :: xs) = inList24 y xs := by
          simp only [inList24, hxy, Bool.false_or]
        cases hIn : inList24 y xs
        · cases hInE : inList24 y (erase24 x l2)
          · rfl
          · have hIn2 := inList24_of_erase x y l2 hInE
            rw [← heq y, h1, hIn] at hIn2
            exact absurd hIn2 (by decide)
        · have hIn2 : inList24 y l2 = true := by rw [← heq y, h1, hIn]
          exact (inList24_erase_of_ne x y l2 hyx hIn2).symm)
    omega

private theorem sumList24_map (f : Fin 24 → Int) (σ : Fin 24 → Fin 24) (l : List (Fin 24)) :
    sumList24 (fun i => f (σ i)) l = sumList24 f (l.map σ) := by
  induction l with
  | nil => rfl
  | cons x xs ih =>
    simp only [List.map_cons, sumList24]
    rw [ih]

private theorem inList24_map_iff (σ σInv : Fin 24 → Fin 24)
    (hLeft : ∀ i : Fin 24, σInv (σ i) = i) (hRight : ∀ i : Fin 24, σ (σInv i) = i)
    (y : Fin 24) (l : List (Fin 24)) :
    inList24 y (l.map σ) = inList24 (σInv y) l := by
  induction l with
  | nil => rfl
  | cons x xs ih =>
    simp only [List.map_cons, inList24]
    have hEq : decide (σ x = y) = decide (x = σInv y) := by
      if h : σ x = y then
        have h' : x = σInv y := by rw [← h, hLeft x]
        rw [decide_eq_true h, decide_eq_true h']
      else
        have h' : x ≠ σInv y := fun eq => h (by rw [eq, hRight y])
        rw [decide_eq_false h, decide_eq_false h']
    rw [hEq, ih]

private theorem noDup24_map_of_bij (σ σInv : Fin 24 → Fin 24)
    (hLeft : ∀ i : Fin 24, σInv (σ i) = i) (hRight : ∀ i : Fin 24, σ (σInv i) = i)
    (l : List (Fin 24)) (hnd : noDup24 l = true) : noDup24 (l.map σ) = true := by
  induction l with
  | nil => rfl
  | cons x xs ih =>
    simp only [noDup24, bool_not_and_eq_true] at hnd
    simp only [List.map_cons, noDup24, bool_not_and_eq_true]
    rw [inList24_map_iff σ σInv hLeft hRight (σ x) xs, hLeft x]
    exact ⟨hnd.1, ih hnd.2⟩

private theorem allSlots24_props :
    noDup24 allSlots24 = true ∧ ∀ x : Fin 24, inList24 x allSlots24 = true := by
  decide

private theorem sumFin24_reindex (f : Fin 24 → Int) (σ σInv : Fin 24 → Fin 24)
    (hLeft : ∀ i : Fin 24, σInv (σ i) = i) (hRight : ∀ i : Fin 24, σ (σInv i) = i) :
    sumFin24 (fun i => f (σ i)) = sumFin24 f := by
  unfold sumFin24
  rw [sumList24_map]
  apply sumList24_eq_of_equiv f (allSlots24.map σ) allSlots24
    (noDup24_map_of_bij σ σInv hLeft hRight allSlots24 allSlots24_props.1)
    allSlots24_props.1
  intro y
  rw [inList24_map_iff σ σInv hLeft hRight y allSlots24,
      allSlots24_props.2 (σInv y), allSlots24_props.2 y]

private theorem sumList24_scale (c : Int) (f : Fin 24 → Int) (l : List (Fin 24)) :
    sumList24 (fun i => c * f i) l = c * sumList24 f l := by
  induction l with
  | nil => simp only [sumList24, Int.mul_zero]
  | cons x xs ih =>
    simp only [sumList24]
    rw [ih, Int.mul_add]

private theorem sumList24_neg (f : Fin 24 → Int) (l : List (Fin 24)) :
    sumList24 (fun i => -(f i)) l = -(sumList24 f l) := by
  induction l with
  | nil => rfl
  | cons x xs ih =>
    simp only [sumList24]
    rw [ih]
    omega

private theorem sumList24_zero (f : Fin 24 → Int) (l : List (Fin 24))
    (hz : ∀ x : Fin 24, inList24 x l = true → f x = 0) : sumList24 f l = 0 := by
  induction l with
  | nil => rfl
  | cons x xs ih =>
    simp only [sumList24]
    have hx : f x = 0 := hz x (inList24_head x xs)
    have hxs : sumList24 f xs = 0 := ih (fun y hy => hz y (by simp only [inList24, hy, Bool.or_true]))
    rw [hx, hxs]; rfl

private theorem sumList24_support (f : Fin 24 → Int) (S L : List (Fin 24))
    (hndS : noDup24 S = true) (hndL : noDup24 L = true)
    (hSub : ∀ x : Fin 24, inList24 x S = true → inList24 x L = true)
    (hZero : ∀ x : Fin 24, inList24 x L = true → inList24 x S = false → f x = 0) :
    sumList24 f L = sumList24 f S := by
  induction S generalizing L with
  | nil =>
    exact sumList24_zero f L (fun x hx => hZero x hx rfl)
  | cons a rest ih =>
    simp only [noDup24, bool_not_and_eq_true] at hndS
    have haL : inList24 a L = true := hSub a (inList24_head a rest)
    rw [sumList24_erase f a L haL]
    simp only [sumList24]
    have hRest := ih (erase24 a L) hndS.2 (noDup24_erase a L hndL)
      (fun x hx => by
        have hne : x ≠ a := fun eq => by rw [eq, hndS.1] at hx; exact absurd hx (by decide)
        exact inList24_erase_of_ne a x L hne (hSub x (by simp only [inList24, hx, Bool.or_true])))
      (fun x hxL hxR => by
        have hne : x ≠ a := fun eq => by
          rw [eq, not_inList24_erase_of_noDup a L hndL] at hxL
          exact absurd hxL (by decide)
        have hda : decide (a = x) = false := decide_eq_false (fun eq => hne eq.symm)
        exact hZero x (inList24_of_erase a x L hxL) (by simp only [inList24, hda, hxR]; rfl))
    omega

private theorem sumFin24_support (f : Fin 24 → Int) (S : List (Fin 24))
    (hndS : noDup24 S = true)
    (hZero : ∀ x : Fin 24, inList24 x S = false → f x = 0) :
    sumFin24 f = sumList24 f S :=
  sumList24_support f S allSlots24 hndS allSlots24_props.1
    (fun x _ => allSlots24_props.2 x)
    (fun x _ hx => hZero x hx)

/-- Gram-invariant geometric kernel `P(r_a, r_b, r_c, r_d) = g_{ab} g_{ac} g_{bd} + 3 g_{ab} g_{bc} g_{cd}^2`,
    manifestly invariant under all of `W(F_4)` (`1,152` elements) and asymmetric on chiral 4-clusters. -/
def gramWeight4 (a b c d : Fin 24) : Int :=
  let g01 := dot4 (d4RootOf a) (d4RootOf b)
  let g02 := dot4 (d4RootOf a) (d4RootOf c)
  let g12 := dot4 (d4RootOf b) (d4RootOf c)
  let g13 := dot4 (d4RootOf b) (d4RootOf d)
  let g23 := dot4 (d4RootOf c) (d4RootOf d)
  g01 * g02 * g13 + 3 * g01 * g12 * g23 * g23

/-- Single ordered-quadruple summand of `chiOddPoly`:
    `det4(r_a, r_b, r_c, r_d) * t_a * t_b^2 * t_c^2 * t_d^2 * gramWeight4(a, b, c, d)`
    (`W(F_4)`-pseudoscalar, `C`-odd, nonzero only when all 4 slots are distinct and occupied). -/
def chiOddTerm (d : DockState) (a b c e : Fin 24) : Int :=
  let ta := (d a).value
  let tb := (d b).value
  let tc := (d c).value
  let te := (d e).value
  det4Vecs (d4RootOf a) (d4RootOf b) (d4RootOf c) (d4RootOf e) *
    (ta * (tb * tb) * (tc * tc) * (te * te) * gramWeight4 a b c e)

/-- Exact closed-form `W(F_4) × ℤ_2^C` pseudoscalar `chiOddPoly : DockState → Int`
    summed over all ordered 4-tuples `(a, b, c, e) ∈ (Fin 24)^4`. -/
def chiOddPoly (d : DockState) : Int :=
  sumFin24 (fun a => sumFin24 (fun b => sumFin24 (fun c => sumFin24 (fun e => chiOddTerm d a b c e))))

/-- Fast evaluation of `chiOddPoly` restricted to a duplicate-free support list `S`. -/
def chiOddPolyOn (S : List (Fin 24)) (d : DockState) : Int :=
  sumList24 (fun a => sumList24 (fun b => sumList24 (fun c => sumList24 (fun e => chiOddTerm d a b c e) S) S) S) S

private theorem chiOddPoly_eq_on_support (S : List (Fin 24)) (d : DockState)
    (hnd : noDup24 S = true)
    (hSupp : ∀ i : Fin 24, inList24 i S = false → d i = .zero) :
    chiOddPoly d = chiOddPolyOn S d := by
  have hTermZero : ∀ a b c e : Fin 24,
      (inList24 a S = false ∨ inList24 b S = false ∨ inList24 c S = false ∨ inList24 e S = false) →
      chiOddTerm d a b c e = 0 := by
    intro a b c e hOr
    unfold chiOddTerm
    rcases hOr with ha | hb | hc | he
    · rw [hSupp a ha]; simp only [Tone.value, Int.zero_mul, Int.mul_zero]
    · rw [hSupp b hb]; simp only [Tone.value, Int.zero_mul, Int.mul_zero]
    · rw [hSupp c hc]; simp only [Tone.value, Int.zero_mul, Int.mul_zero]
    · rw [hSupp e he]; simp only [Tone.value, Int.zero_mul, Int.mul_zero]
  unfold chiOddPoly chiOddPolyOn
  rw [sumFin24_support _ S hnd (fun a ha => by
    unfold sumFin24
    exact sumList24_zero _ allSlots24 (fun b _ =>
      sumList24_zero _ allSlots24 (fun c _ =>
        sumList24_zero _ allSlots24 (fun e _ => hTermZero a b c e (Or.inl ha)))))]
  have hA : ∀ a : Fin 24,
      sumFin24 (fun b => sumFin24 (fun c => sumFin24 (fun e => chiOddTerm d a b c e))) =
      sumList24 (fun b => sumList24 (fun c => sumList24 (fun e => chiOddTerm d a b c e) S) S) S := by
    intro a
    rw [sumFin24_support _ S hnd (fun b hb => by
      unfold sumFin24
      exact sumList24_zero _ allSlots24 (fun c _ =>
        sumList24_zero _ allSlots24 (fun e _ => hTermZero a b c e (Or.inr (Or.inl hb)))))]
    have hB : ∀ b : Fin 24,
        sumFin24 (fun c => sumFin24 (fun e => chiOddTerm d a b c e)) =
        sumList24 (fun c => sumList24 (fun e => chiOddTerm d a b c e) S) S := by
      intro b
      rw [sumFin24_support _ S hnd (fun c hc => by
        unfold sumFin24
        exact sumList24_zero _ allSlots24 (fun e _ => hTermZero a b c e (Or.inr (Or.inr (Or.inl hc)))))]
      have hC : ∀ c : Fin 24,
          sumFin24 (fun e => chiOddTerm d a b c e) = sumList24 (fun e => chiOddTerm d a b c e) S := by
        intro c
        exact sumFin24_support _ S hnd (fun e he => hTermZero a b c e (Or.inr (Or.inr (Or.inr he))))
      have hFunC : (fun c => sumFin24 (fun e => chiOddTerm d a b c e)) =
                   (fun c => sumList24 (fun e => chiOddTerm d a b c e) S) := funext hC
      rw [hFunC]
    have hFunB : (fun b => sumFin24 (fun c => sumFin24 (fun e => chiOddTerm d a b c e))) =
                 (fun b => sumList24 (fun c => sumList24 (fun e => chiOddTerm d a b c e) S) S) := funext hB
    rw [hFunB]
  have hFunA : (fun a => sumFin24 (fun b => sumFin24 (fun c => sumFin24 (fun e => chiOddTerm d a b c e)))) =
               (fun a => sumList24 (fun b => sumList24 (fun c => sumList24 (fun e => chiOddTerm d a b c e) S) S) S) :=
    funext hA
  rw [hFunA]

private theorem chir_tone_dual_value (t : Tone) : t.dual.value = -t.value := by
  cases t <;> decide

private theorem gramWeight4_wf4_inv (g : WF4Elem) (a b c e : Fin 24) :
    gramWeight4 (wf4Perm g a) (wf4Perm g b) (wf4Perm g c) (wf4Perm g e) = gramWeight4 a b c e := by
  have hDot := (thm_wf4_action_orthogonal_and_bijective g).2.2.2.2.1
  unfold gramWeight4
  rw [hDot a b, hDot a c, hDot b c, hDot b e, hDot c e]

/-- Headline Theorem 12: Exact global `W(F_4) × ℤ_2^C` transformation laws for `chiOddPoly`
    across ALL `g ∈ W(F_4)` (`1,152` elements), ALL `c ∈ ℤ_2^C`, and ALL `d : DockState`:
    1. `chiOddPoly (actWF4Dock g d) = wf4Det g * chiOddPoly d` (`W(F_4)`-pseudoscalar),
    2. `wf4Det g = 1 → chiOddPoly (actWF4Dock g d) = chiOddPoly d` (`W(F_4)^+`-invariant),
    3. `chiOddPoly (conjDock d) = -chiOddPoly d` (`C`-odd),
    4. `chiOddPoly (parityDock d) = -chiOddPoly d` (`P`-odd),
    5. `chiOddPoly (cpDock d) = chiOddPoly d` (`CP`-even),
    6. `chiOddPoly (actFullDock g c d) = fullChar g c * chiOddPoly d`. -/
theorem thm_chiOddPoly_transformation_laws :
    (∀ (g : WF4Elem) (d : DockState), chiOddPoly (actWF4Dock g d) = wf4Det g * chiOddPoly d) ∧
    (∀ (g : WF4Elem) (d : DockState), wf4Det g = 1 → chiOddPoly (actWF4Dock g d) = chiOddPoly d) ∧
    (∀ d : DockState, chiOddPoly (conjDock d) = -chiOddPoly d) ∧
    (∀ d : DockState, chiOddPoly (parityDock d) = -chiOddPoly d) ∧
    (∀ d : DockState, chiOddPoly (cpDock d) = chiOddPoly d) ∧
    (∀ (g : WF4Elem) (c : Bool) (d : DockState),
      chiOddPoly (actFullDock g c d) = fullChar g c * chiOddPoly d) := by
  have hWF4 : ∀ (g : WF4Elem) (d : DockState), chiOddPoly (actWF4Dock g d) = wf4Det g * chiOddPoly d := by
    intro g d
    have hBij := (thm_wf4_action_orthogonal_and_bijective g).2.2.1
    have hL : ∀ i, wf4PermInv g (wf4Perm g i) = i := fun i => (hBij i).1
    have hR : ∀ i, wf4Perm g (wf4PermInv g i) = i := fun i => (hBij i).2
    unfold chiOddPoly
    rw [← sumFin24_reindex _ (wf4Perm g) (wf4PermInv g) hL hR]
    have hStep1 : ∀ a : Fin 24,
        sumFin24 (fun b => sumFin24 (fun c => sumFin24 (fun e => chiOddTerm (actWF4Dock g d) (wf4Perm g a) b c e))) =
        wf4Det g * sumFin24 (fun b => sumFin24 (fun c => sumFin24 (fun e => chiOddTerm d a b c e))) := by
      intro a
      rw [← sumFin24_reindex _ (wf4Perm g) (wf4PermInv g) hL hR]
      have hStep2 : ∀ b : Fin 24,
          sumFin24 (fun c => sumFin24 (fun e => chiOddTerm (actWF4Dock g d) (wf4Perm g a) (wf4Perm g b) c e)) =
          wf4Det g * sumFin24 (fun c => sumFin24 (fun e => chiOddTerm d a b c e)) := by
        intro b
        rw [← sumFin24_reindex _ (wf4Perm g) (wf4PermInv g) hL hR]
        have hStep3 : ∀ c : Fin 24,
            sumFin24 (fun e => chiOddTerm (actWF4Dock g d) (wf4Perm g a) (wf4Perm g b) (wf4Perm g c) e) =
            wf4Det g * sumFin24 (fun e => chiOddTerm d a b c e) := by
          intro c
          rw [← sumFin24_reindex _ (wf4Perm g) (wf4PermInv g) hL hR]
          have hTerm : ∀ e : Fin 24,
              chiOddTerm (actWF4Dock g d) (wf4Perm g a) (wf4Perm g b) (wf4Perm g c) (wf4Perm g e) =
              wf4Det g * chiOddTerm d a b c e := by
            intro e
            unfold chiOddTerm actWF4Dock
            rw [hL a, hL b, hL c, hL e, thm_wf4_det4_transformation g a b c e,
                gramWeight4_wf4_inv g a b c e, Int.mul_assoc]
          have hFunE : (fun e => chiOddTerm (actWF4Dock g d) (wf4Perm g a) (wf4Perm g b) (wf4Perm g c) (wf4Perm g e)) =
                       (fun e => wf4Det g * chiOddTerm d a b c e) := funext hTerm
          rw [hFunE]
          exact sumList24_scale (wf4Det g) _ allSlots24
        have hFunC : (fun c => sumFin24 (fun e => chiOddTerm (actWF4Dock g d) (wf4Perm g a) (wf4Perm g b) (wf4Perm g c) e)) =
                     (fun c => wf4Det g * sumFin24 (fun e => chiOddTerm d a b c e)) := funext hStep3
        rw [hFunC]
        exact sumList24_scale (wf4Det g) _ allSlots24
      have hFunB : (fun b => sumFin24 (fun c => sumFin24 (fun e => chiOddTerm (actWF4Dock g d) (wf4Perm g a) (wf4Perm g b) c e))) =
                   (fun b => wf4Det g * sumFin24 (fun c => sumFin24 (fun e => chiOddTerm d a b c e))) := funext hStep2
      rw [hFunB]
      exact sumList24_scale (wf4Det g) _ allSlots24
    have hFunA : (fun a => sumFin24 (fun b => sumFin24 (fun c => sumFin24 (fun e => chiOddTerm (actWF4Dock g d) (wf4Perm g a) b c e)))) =
                 (fun a => wf4Det g * sumFin24 (fun b => sumFin24 (fun c => sumFin24 (fun e => chiOddTerm d a b c e)))) :=
      funext hStep1
    rw [hFunA]
    exact sumList24_scale (wf4Det g) _ allSlots24
  have hConj : ∀ d : DockState, chiOddPoly (conjDock d) = -chiOddPoly d := by
    intro d
    have hTerm : ∀ a b c e : Fin 24, chiOddTerm (conjDock d) a b c e = -chiOddTerm d a b c e := by
      intro a b c e
      unfold chiOddTerm conjDock
      rw [chir_tone_dual_value, chir_tone_dual_value, chir_tone_dual_value, chir_tone_dual_value]
      simp only [Int.neg_mul, Int.mul_neg, Int.neg_neg]
    unfold chiOddPoly sumFin24
    have h1 : ∀ a b c : Fin 24,
        sumList24 (fun e => chiOddTerm (conjDock d) a b c e) allSlots24 =
        -(sumList24 (fun e => chiOddTerm d a b c e) allSlots24) := by
      intro a b c
      have hf : (fun e => chiOddTerm (conjDock d) a b c e) = (fun e => -(chiOddTerm d a b c e)) :=
        funext (hTerm a b c)
      rw [hf]; exact sumList24_neg _ allSlots24
    have h2 : ∀ a b : Fin 24,
        sumList24 (fun c => sumList24 (fun e => chiOddTerm (conjDock d) a b c e) allSlots24) allSlots24 =
        -(sumList24 (fun c => sumList24 (fun e => chiOddTerm d a b c e) allSlots24) allSlots24) := by
      intro a b
      have hf : (fun c => sumList24 (fun e => chiOddTerm (conjDock d) a b c e) allSlots24) =
                (fun c => -(sumList24 (fun e => chiOddTerm d a b c e) allSlots24)) := funext (h1 a b)
      rw [hf]; exact sumList24_neg _ allSlots24
    have h3 : ∀ a : Fin 24,
        sumList24 (fun b => sumList24 (fun c => sumList24 (fun e => chiOddTerm (conjDock d) a b c e) allSlots24) allSlots24) allSlots24 =
        -(sumList24 (fun b => sumList24 (fun c => sumList24 (fun e => chiOddTerm d a b c e) allSlots24) allSlots24) allSlots24) := by
      intro a
      have hf : (fun b => sumList24 (fun c => sumList24 (fun e => chiOddTerm (conjDock d) a b c e) allSlots24) allSlots24) =
                (fun b => -(sumList24 (fun c => sumList24 (fun e => chiOddTerm d a b c e) allSlots24) allSlots24)) := funext (h2 a)
      rw [hf]; exact sumList24_neg _ allSlots24
    have hf : (fun a => sumList24 (fun b => sumList24 (fun c => sumList24 (fun e => chiOddTerm (conjDock d) a b c e) allSlots24) allSlots24) allSlots24) =
              (fun a => -(sumList24 (fun b => sumList24 (fun c => sumList24 (fun e => chiOddTerm d a b c e) allSlots24) allSlots24) allSlots24)) :=
      funext h3
    rw [hf]; exact sumList24_neg _ allSlots24
  have hParDet : wf4Det wf4Parity = -1 := by decide
  refine ⟨hWF4, ?_, hConj, ?_, ?_, ?_⟩
  · intro g d hg; rw [hWF4 g d, hg, Int.one_mul]
  · intro d; unfold parityDock; rw [hWF4 wf4Parity d, hParDet]; omega
  · intro d; unfold cpDock parityDock; rw [hConj, hWF4 wf4Parity d, hParDet]; omega
  · intro g c d
    cases c
    · simp only [actFullDock, fullChar]; exact hWF4 g d
    · simp only [actFullDock, fullChar]; rw [hConj, hWF4 g d, Int.neg_mul]

/-- Headline Theorem 13: `chiOddPoly` vanishes identically on the calm vacuum `v1Dock` and on
    EVERY dock configuration holding at most 3 excitations (`k ≤ 3`). -/
theorem thm_chiOddPoly_vanishes_k_le_3 :
    chiOddPoly v1Dock = 0 ∧
    (∀ (a b c : Fin 24) (d : DockState),
      (∀ i : Fin 24, i ≠ a → i ≠ b → i ≠ c → d i = .zero) → chiOddPoly d = 0) := by
  refine ⟨?_, ?_⟩
  · exact (thm_achiral_k1 ⟨0, by decide⟩ v1Dock (fun _ _ => rfl)).2.2
      chiOddPoly thm_chiOddPoly_transformation_laws.1
  · intro a b c d hSupp
    exact (thm_achiral_k3 a b c d hSupp).2.2 chiOddPoly thm_chiOddPoly_transformation_laws.1

/-- Construct a 4-slot dock configuration from 4 `(slot, tone)` pairs (all other slots `.zero`). -/
def mkDock4 (s0 : Fin 24) (t0 : Tone) (s1 : Fin 24) (t1 : Tone)
    (s2 : Fin 24) (t2 : Tone) (s3 : Fin 24) (t3 : Tone) : DockState :=
  fun i =>
    if i = s0 then t0
    else if i = s1 then t1
    else if i = s2 then t2
    else if i = s3 then t3
    else .zero

/-- Concrete mixed-tone chiral 4-cluster `[0+, 1-, 4+, 10+]` (`test/universe.ts:chiralVibes`). -/
def dockMixed : DockState :=
  mkDock4 ⟨0, by decide⟩ .pos ⟨1, by decide⟩ .neg ⟨4, by decide⟩ .pos ⟨10, by decide⟩ .pos

/-- Concrete all-`+1` chiral 4-cluster `X_1 = [0+, 1+, 4+, 16+]` (`test/universe.ts:x1Vibes`). -/
def dockX1 : DockState :=
  mkDock4 ⟨0, by decide⟩ .pos ⟨1, by decide⟩ .pos ⟨4, by decide⟩ .pos ⟨16, by decide⟩ .pos

/-- Concrete `E-FND-0184` active all-`+1` chiral 4-cluster `[1+, 3+, 4+, 10+]`. -/
def dockE184Active : DockState :=
  mkDock4 ⟨1, by decide⟩ .pos ⟨3, by decide⟩ .pos ⟨4, by decide⟩ .pos ⟨10, by decide⟩ .pos

/-- Concrete `E-FND-0184` achiral all-`+1` 4-cluster `[0+, 1+, 4+, 10+]` (fixed by `diag(1,-1,1,1)`). -/
def dockE184Achiral : DockState :=
  mkDock4 ⟨0, by decide⟩ .pos ⟨1, by decide⟩ .pos ⟨4, by decide⟩ .pos ⟨10, by decide⟩ .pos

private theorem chiral_of_chiOddPoly_ne_zero (d : DockState) (h : chiOddPoly d ≠ 0) :
    isChiralUnderG d := by
  intro g c hFix
  have hLaw := thm_chiOddPoly_transformation_laws.2.2.2.2.2 g c d
  rw [hFix] at hLaw
  have hChar : fullChar g c = 1 ∨ fullChar g c = -1 := by
    cases c
    · simp only [fullChar]
      exact wf4Det_pm_one g
    · simp only [fullChar]
      rcases wf4Det_pm_one g with hd | hd <;> rw [hd]
      · exact Or.inr rfl
      · exact Or.inl rfl
  rcases hChar with h1 | hm1
  · exact h1
  · rw [hm1] at hLaw
    omega

/-- Headline Theorem 14 (Sharp `k* = 4` Chiral Witnesses & Achiral `E-FND-0184` Control):
    1. `chiOddPoly dockMixed = 32 ≠ 0` and `isChiralUnderG dockMixed`,
    2. `chiOddPoly dockX1 = -8 ≠ 0` and `isChiralUnderG dockX1` (all-`+1` chiral witness!),
    3. `chiOddPoly dockE184Active = 8 ≠ 0` and `isChiralUnderG dockE184Active`,
    4. `chiOddPoly dockE184Achiral = 0` and `¬ isChiralUnderG dockE184Achiral`
       (witnessed explicitly by the `det = -1` reflection `diag(1, -1, 1, 1) = f4ReflWF4 13`). -/
theorem thm_k4_chiral_witnesses_sharp :
    (chiOddPoly dockMixed = 32 ∧ isChiralUnderG dockMixed) ∧
    (chiOddPoly dockX1 = -8 ∧ isChiralUnderG dockX1) ∧
    (chiOddPoly dockE184Active = 8 ∧ isChiralUnderG dockE184Active) ∧
    (chiOddPoly dockE184Achiral = 0 ∧ ¬ isChiralUnderG dockE184Achiral) := by
  let sMixed : List (Fin 24) := [⟨0, by decide⟩, ⟨1, by decide⟩, ⟨4, by decide⟩, ⟨10, by decide⟩]
  let sX1 : List (Fin 24) := [⟨0, by decide⟩, ⟨1, by decide⟩, ⟨4, by decide⟩, ⟨16, by decide⟩]
  let s184 : List (Fin 24) := [⟨1, by decide⟩, ⟨3, by decide⟩, ⟨4, by decide⟩, ⟨10, by decide⟩]
  have hMixed : chiOddPoly dockMixed = 32 := by
    rw [chiOddPoly_eq_on_support sMixed dockMixed (by decide) (by decide)]
    decide
  have hX1 : chiOddPoly dockX1 = -8 := by
    rw [chiOddPoly_eq_on_support sX1 dockX1 (by decide) (by decide)]
    decide
  have h184A : chiOddPoly dockE184Active = 8 := by
    rw [chiOddPoly_eq_on_support s184 dockE184Active (by decide) (by decide)]
    decide
  have h184Z : chiOddPoly dockE184Achiral = 0 := by
    rw [chiOddPoly_eq_on_support sMixed dockE184Achiral (by decide) (by decide)]
    decide
  have hNotCh : ¬ isChiralUnderG dockE184Achiral := by
    intro hCh
    let g := f4ReflWF4 ⟨13, by decide⟩
    have hFix : actFullDock g false dockE184Achiral = dockE184Achiral := by
      funext i
      exact (by decide : ∀ x : Fin 24,
        actFullDock (f4ReflWF4 ⟨13, by decide⟩) false dockE184Achiral x = dockE184Achiral x) i
    have h1 := hCh g false hFix
    have hDet : fullChar g false = -1 := by decide
    omega
  refine ⟨⟨hMixed, chiral_of_chiOddPoly_ne_zero dockMixed (by omega)⟩,
          ⟨hX1, chiral_of_chiOddPoly_ne_zero dockX1 (by omega)⟩,
          ⟨h184A, chiral_of_chiOddPoly_ne_zero dockE184Active (by omega)⟩,
          ⟨h184Z, hNotCh⟩⟩

/-- Headline Theorem 15 (Genuine Individual `C` and `P` Breaking with Exact `CP` Invariance):
    both `dockMixed` and all-`+1` `dockX1` genuinely break `C` and `P` individually while `CP`
    holds identically across every `DockState`. -/
theorem thm_individual_C_and_P_broken_CP_exact :
    chiOddPoly (conjDock dockMixed) ≠ chiOddPoly dockMixed ∧
    chiOddPoly (parityDock dockMixed) ≠ chiOddPoly dockMixed ∧
    chiOddPoly (conjDock dockX1) ≠ chiOddPoly dockX1 ∧
    chiOddPoly (parityDock dockX1) ≠ chiOddPoly dockX1 ∧
    (∀ d : DockState, chiOddPoly (cpDock d) = chiOddPoly d) := by
  have hM := thm_k4_chiral_witnesses_sharp.1.1
  have hX := thm_k4_chiral_witnesses_sharp.2.1.1
  have hC := thm_chiOddPoly_transformation_laws.2.2.1
  have hP := thm_chiOddPoly_transformation_laws.2.2.2.1
  have hCP := thm_chiOddPoly_transformation_laws.2.2.2.2.1
  refine ⟨?_, ?_, ?_, ?_, hCP⟩
  · rw [hC dockMixed, hM]; omega
  · rw [hP dockMixed, hM]; omega
  · rw [hC dockX1, hX]; omega
  · rw [hP dockX1, hX]; omega


/-! ## Section 7: Abstract Canonical `G`-Orbit Sign Theorem (`value-phase.ts` / `test/universe.ts`) -/

/-- Headline Theorem 16 (Abstract Canonical Orbit-Sign Transformation Law):
    for ANY group `(G, mul, inv)` with pseudoscalar character `χ : G → Int` (`χ(g h) = χ(g) χ(h)`,
    `χ(g) ∈ {-1, +1}`) acting on a pattern space `X`, and ANY orbit representative map `rep : X → X`
    constant on orbits (`rep (h · x) = rep x`), any canonical orbit-sign function `eps : X → Int`
    satisfying:
    - `eps x = 0` whenever an improper stabilizer exists (`∃ s, s · x = x ∧ χ s = -1`),
    - `eps x = χ g` whenever no improper stabilizer exists and `g · x = rep x`
    automatically obeys the exact pseudoscalar law `eps (h · x) = χ h * eps x` for ALL `h : G`, `x : X`! -/
theorem thm_abstract_canonical_orbit_sign_law {G X : Type}
    (mul : G → G → G) (inv : G → G) (act : G → X → X)
    (chi : G → Int) (rep : X → X) (eps : X → Int)
    (hActMul : ∀ g h x, act (mul g h) x = act g (act h x))
    (hActInvL : ∀ g x, act (inv g) (act g x) = x)
    (hChiMul : ∀ g h, chi (mul g h) = chi g * chi h)
    (hChiSign : ∀ g, chi g = 1 ∨ chi g = -1)
    (hChiInv : ∀ g, chi (inv g) = chi g)
    (hRepOrb : ∀ x, ∃ g, act g x = rep x)
    (hRepInv : ∀ h x, rep (act h x) = rep x)
    (hEpsZero : ∀ x, (∃ s, act s x = x ∧ chi s = -1) → eps x = 0)
    (hEpsSign : ∀ x g, (¬ ∃ s, act s x = x ∧ chi s = -1) → act g x = rep x → eps x = chi g) :
    ∀ (h : G) (x : X), eps (act h x) = chi h * eps x := by
  intro h x
  rcases Classical.em (∃ s, act s x = x ∧ chi s = -1) with hStab | hStab
  · obtain ⟨s, hsAct, hsChi⟩ := hStab
    have hStabH : ∃ s', act s' (act h x) = act h x ∧ chi s' = -1 := by
      refine ⟨mul h (mul s (inv h)), ?_, ?_⟩
      · rw [hActMul, hActMul, hActInvL, hsAct]
      · rw [hChiMul, hChiMul, hChiInv, hsChi]
        rcases hChiSign h with hh | hh <;> rw [hh] <;> decide
    rw [hEpsZero x ⟨s, hsAct, hsChi⟩, hEpsZero (act h x) hStabH, Int.mul_zero]
  · have hNoStabH : ¬ ∃ s', act s' (act h x) = act h x ∧ chi s' = -1 := by
      intro ⟨s', hs'Act, hs'Chi⟩
      apply hStab
      refine ⟨mul (inv h) (mul s' h), ?_, ?_⟩
      · rw [hActMul, hActMul, hs'Act, hActInvL]
      · rw [hChiMul, hChiMul, hChiInv, hs'Chi]
        rcases hChiSign h with hh | hh <;> rw [hh] <;> decide
    obtain ⟨g, hg⟩ := hRepOrb (act h x)
    have hgh : act (mul g h) x = rep x := by
      rw [hActMul, hg, hRepInv]
    rw [hEpsSign (act h x) g hNoStabH hg, hEpsSign x (mul g h) hStab hgh, hChiMul]
    rcases hChiSign h with hh | hh <;> rcases hChiSign g with hg1 | hg1 <;> rw [hh, hg1] <;> decide


/-! ## Section 8: Exact `ℤ[ζ_9]` Parity-Odd Phase `Φ_odd` & Global Order-576 `W(F_4)^+` Covariance -/

/-- Sign of an integer `n ∈ {-1, 0, +1}`. -/
def intSign (n : Int) : Int :=
  if n > 0 then 1 else if n < 0 then -1 else 0

/-- Exact `ζ_18^n` inside `ℤ[ζ_9]` for ANY signed integer exponent `n : Int` (via `n mod 18`). -/
def zeta18IntPow (n : Int) : Ninth :=
  Ninth.pow Ninth.zeta18 (n % 18).toNat

/-- Exact `ζ_6^n = (ζ_18^3)^n` inside `ℤ[ζ_9]` for ANY signed integer exponent `n : Int`. -/
def zeta6IntPow (n : Int) : Ninth :=
  zeta18IntPow (3 * n)

/-- Parity-odd `ℤ[ζ_9]` phase `exp(i π/9 · sgn(χ_odd(d))) = ζ_18^{sgn(χ_odd(d))}` on a dock. -/
def phiOddPhase18 (d : DockState) : Ninth :=
  zeta18IntPow (intSign (chiOddPoly d))

/-- Parity-odd `ℤ[ζ_9]` phase `ζ_6^{χ_odd(d)}` (`code/rule/value-phase.ts`) on a dock. -/
def phiOddPhase6 (d : DockState) : Ninth :=
  zeta6IntPow (chiOddPoly d)

/-- Dock-local Fock wavefunction over `ℤ[ζ_9]`: `ψ : DockState → Ninth`. -/
abbrev DockFock := DockState → Ninth

/-- Exact `W(F_4)` unitary action on dock Fock wavefunctions: `(g · ψ)(d) = ψ(g^{-1} · d)`. -/
def wf4FockAct (g : WF4Elem) (ψ : DockFock) : DockFock :=
  fun d => ψ (actWF4Dock (wf4Inv g) d)

/-- Diagonal chiral phase operator `Φ_odd` (`ζ_18^{sgn(χ)}`) on dock Fock wavefunctions. -/
def applyPhiOdd18 (ψ : DockFock) : DockFock :=
  fun d => Ninth.mul (phiOddPhase18 d) (ψ d)

/-- Diagonal chiral phase operator `Φ_odd` (`ζ_6^{χ}`) on dock Fock wavefunctions. -/
def applyPhiOdd6 (ψ : DockFock) : DockFock :=
  fun d => Ninth.mul (phiOddPhase6 d) (ψ d)

private theorem zeta18IntPow_unit (n : Int) :
    Ninth.mul (Ninth.conj (zeta18IntPow n)) (zeta18IntPow n) = Ninth.one := by
  unfold zeta18IntPow
  cases h : (n % 18) with
  | negSucc _ =>
    have hGe : 0 ≤ n % 18 := by omega
    rw [h] at hGe
    omega
  | ofNat m =>
    have hm : m < 18 := by
      have hLt : n % 18 < 18 := by omega
      rw [h] at hLt
      omega
    exact (by decide : ∀ k : Fin 18,
      Ninth.mul (Ninth.conj (Ninth.pow Ninth.zeta18 k.val)) (Ninth.pow Ninth.zeta18 k.val) = Ninth.one) ⟨m, hm⟩

private theorem zeta18IntPow_neg (n : Int) :
    zeta18IntPow (-n) = Ninth.conj (zeta18IntPow n) := by
  unfold zeta18IntPow
  cases h : (n % 18) with
  | negSucc _ =>
    have hGe : 0 ≤ n % 18 := by omega
    rw [h] at hGe
    omega
  | ofNat m =>
    have hm : m < 18 := by
      have hLt : n % 18 < 18 := by omega
      rw [h] at hLt
      omega
    cases hNeg : ((-n) % 18) with
    | negSucc _ =>
      have hGe : 0 ≤ (-n) % 18 := by omega
      rw [hNeg] at hGe
      omega
    | ofNat m2 =>
      have hm2Lt : m2 < 18 := by
        have hLt : (-n) % 18 < 18 := by omega
        rw [hNeg] at hLt
        omega
      have hDiv1 : 18 * (n / 18) + n % 18 = n := by omega
      have hDiv2 : 18 * ((-n) / 18) + (-n) % 18 = -n := by omega
      rw [h] at hDiv1
      rw [hNeg] at hDiv2
      have hm2 : m2 = (18 - m) % 18 := by omega
      change Ninth.pow Ninth.zeta18 m2 = Ninth.conj (Ninth.pow Ninth.zeta18 m)
      rw [hm2]
      exact (by decide : ∀ k : Fin 18,
        Ninth.pow Ninth.zeta18 ((18 - k.val) % 18) = Ninth.conj (Ninth.pow Ninth.zeta18 k.val)) ⟨m, hm⟩

private theorem intSign_neg (n : Int) : intSign (-n) = -intSign n := by
  unfold intSign
  if hPos : n > 0 then
    have h1 : ¬ (-n > 0) := by omega
    have h2 : -n < 0 := by omega
    rw [if_pos hPos, if_neg h1, if_pos h2]
  else if hNeg : n < 0 then
    have h1 : -n > 0 := by omega
    rw [if_neg hPos, if_pos hNeg, if_pos h1]
    decide
  else
    have h1 : ¬ (-n > 0) := by omega
    have h2 : ¬ (-n < 0) := by omega
    rw [if_neg hPos, if_neg hNeg, if_neg h1, if_neg h2]
    decide

/-- Headline Theorem 17 (Exact `ℤ[ζ_9]` Unit Modulus, `C`/`P`/`CP` Laws & Global Order-576 `W(F_4)^+`
    Covariance of `Φ_odd` on ALL Dock Fock States):
    1. Both `phiOddPhase18 d` (`ζ_18^{sgn(χ)}`) and `phiOddPhase6 d` (`ζ_6^χ`) have exact unit modulus
       in `ℤ[ζ_9]` for EVERY `d : DockState`,
    2. Both are complex-conjugated under `C` and `P` individually, and strictly invariant under `CP`,
    3. For ALL 576 proper elements `g ∈ W(F_4)^+` (`wf4Det g = 1`) and ALL dock Fock wavefunctions
       `ψ : DockFock`, `applyPhiOdd18` AND `applyPhiOdd6` commute identically with `wf4FockAct g`! -/
theorem thm_phiOdd_phase_unit_and_covariance :
    (∀ d : DockState, Ninth.mul (Ninth.conj (phiOddPhase18 d)) (phiOddPhase18 d) = Ninth.one) ∧
    (∀ d : DockState, Ninth.mul (Ninth.conj (phiOddPhase6 d)) (phiOddPhase6 d) = Ninth.one) ∧
    (∀ d : DockState, phiOddPhase18 (conjDock d) = Ninth.conj (phiOddPhase18 d) ∧
                      phiOddPhase18 (parityDock d) = Ninth.conj (phiOddPhase18 d) ∧
                      phiOddPhase18 (cpDock d) = phiOddPhase18 d) ∧
    (∀ d : DockState, phiOddPhase6 (conjDock d) = Ninth.conj (phiOddPhase6 d) ∧
                      phiOddPhase6 (parityDock d) = Ninth.conj (phiOddPhase6 d) ∧
                      phiOddPhase6 (cpDock d) = phiOddPhase6 d) ∧
    (∀ (g : WF4Elem) (_ : wf4Det g = 1) (ψ : DockFock),
      applyPhiOdd18 (wf4FockAct g ψ) = wf4FockAct g (applyPhiOdd18 ψ) ∧
      applyPhiOdd6 (wf4FockAct g ψ) = wf4FockAct g (applyPhiOdd6 ψ)) := by
  refine ⟨fun d => zeta18IntPow_unit _, fun d => zeta18IntPow_unit _, ?_, ?_, ?_⟩
  · intro d
    unfold phiOddPhase18
    rw [thm_chiOddPoly_transformation_laws.2.2.1 d,
        thm_chiOddPoly_transformation_laws.2.2.2.1 d,
        thm_chiOddPoly_transformation_laws.2.2.2.2.1 d,
        intSign_neg, zeta18IntPow_neg]
    exact ⟨rfl, rfl, rfl⟩
  · intro d
    unfold phiOddPhase6 zeta6IntPow
    rw [thm_chiOddPoly_transformation_laws.2.2.1 d,
        thm_chiOddPoly_transformation_laws.2.2.2.1 d,
        thm_chiOddPoly_transformation_laws.2.2.2.2.1 d]
    have hNeg : 3 * -chiOddPoly d = -(3 * chiOddPoly d) := Int.mul_neg 3 (chiOddPoly d)
    rw [hNeg, zeta18IntPow_neg]
    exact ⟨rfl, rfl, rfl⟩
  · intro g hg ψ
    have hInvDet : wf4Det (wf4Inv g) = 1 := by rw [wf4Det_inv, hg]
    have hChiInv : ∀ d : DockState, chiOddPoly (actWF4Dock (wf4Inv g) d) = chiOddPoly d :=
      fun d => thm_chiOddPoly_transformation_laws.2.1 (wf4Inv g) d hInvDet
    refine ⟨?_, ?_⟩
    · funext d
      unfold applyPhiOdd18 wf4FockAct phiOddPhase18
      rw [hChiInv d]
    · funext d
      unfold applyPhiOdd6 wf4FockAct phiOddPhase6 zeta6IntPow
      rw [hChiInv d]

end Vibe
