/-- Exact doubled reflection matrix `2 R_α` of hyperplane normal `α = f4Hyperplane h`. -/
def f4HyperplaneReflMat2 (h : Fin 24) : Mat4 :=
  let α := f4Hyperplane h
  let aa := dot4 α α
  fun i j => (if i = j then 2 else 0) - 4 * coord4 α i * coord4 α j / aa

/-- Headline Theorem 7: All 24 distinct `F_4` root-reflection hyperplanes embed into `WF4Elem`
    with `wf4Det = -1`, exact involution `R_h^2 = I`, and fix every `D_4` root orthogonal to `f4Hyperplane h`. -/
theorem thm_f4_24_reflection_hyperplanes :
    (∀ h : Fin 24, wf4Det (f4ReflWF4 h) = -1) ∧
    (∀ h : Fin 24, ∀ i j : Fin 4, wf4Mat2 (f4ReflWF4 h) i j = f4HyperplaneReflMat2 h i j) ∧
    (∀ h : Fin 24, ∀ a : Fin 24, wf4Perm (f4ReflWF4 h) (wf4Perm (f4ReflWF4 h) a) = a) ∧
    (∀ h : Fin 24, ∀ a : Fin 24,
      dot4 (d4RootOf a) (f4Hyperplane h) = 0 → wf4Perm (f4ReflWF4 h) a = a) := by
  decide

/-- The 9 `F_4` reflection hyperplanes orthogonal to `r_0 = (1, 1, 0, 0)`. -/
def hyperplanesOrthTo0 : List (Fin 24) :=
  [ ⟨1, by decide⟩, ⟨10, by decide⟩, ⟨11, by decide⟩, ⟨14, by decide⟩, ⟨15, by decide⟩,
    ⟨20, by decide⟩, ⟨21, by decide⟩, ⟨22, by decide⟩, ⟨23, by decide⟩ ]

/-- Self-contained `any` combinator on `List` (immune to stdlib API drift). -/
def anyList {α : Type} (p : α → Bool) : List α → Bool
  | [] => false
  | x :: xs => p x || anyList p xs

private theorem k3_mirror_at_slot0 :
    (∀ a : Fin 24, wf4Perm (mapToSlot0 a) a = ⟨0, by decide⟩) ∧
    (∀ b c : Fin 24,
      anyList (fun h =>
        decide (dot4 (d4RootOf ⟨0, by decide⟩) (f4Hyperplane h) = 0 ∧
                dot4 (d4RootOf b) (f4Hyperplane h) = 0 ∧
                dot4 (d4RootOf c) (f4Hyperplane h) = 0)) hyperplanesOrthTo0 = true) := by
  decide

private theorem any_true_exists {α : Type} (p : α → Bool) (xs : List α)
    (h : anyList p xs = true) : ∃ x : α, p x = true := by
  induction xs with
  | nil => exact absurd h (by decide)
  | cons a rest ih =>
    simp only [anyList] at h
    cases hp : p a
    · rw [hp] at h
      exact ih h
    · exact ⟨a, hp⟩

private theorem wf4Perm_mul (g1 g2 : WF4Elem) (a : Fin 24) :
    wf4Perm (wf4Mul g1 g2) a = wf4Perm g1 (wf4Perm g2 a) := by
  have h1 := wf4Mat2_eq_mat4Vec_action (wf4Mul g1 g2) a
  have h2 := wf4Mat2_eq_mat4Vec_action g2 a
  have h3 := wf4Mat2_eq_mat4Vec_action g1 (wf4Perm g2 a)
  have hM := wf4Mul_mat2 g1 g2
  have hV : mat4Vec (mat4Mul (wf4Mat2 g1) (wf4Mat2 g2)) (d4RootOf a) =
      scaleVec4 2 (mat4Vec (wf4Mat2 (wf4Mul g1 g2)) (d4RootOf a)) := by
    rw [hM]
    have hRow : ∀ i : Fin 4,
        sum4 (fun k => (2 * wf4Mat2 (wf4Mul g1 g2) i k) * coord4 (d4RootOf a) k) =
        2 * sum4 (fun k => wf4Mat2 (wf4Mul g1 g2) i k * coord4 (d4RootOf a) k) := by
      intro i
      rw [← sum4_mul_left]
      apply congrArg sum4; funext k
      exact Int.mul_assoc 2 (wf4Mat2 (wf4Mul g1 g2) i k) (coord4 (d4RootOf a) k)
    unfold mat4Vec scaleVec4
    exact Prod.ext (hRow ⟨0, by decide⟩)
      (Prod.ext (hRow ⟨1, by decide⟩)
        (Prod.ext (hRow ⟨2, by decide⟩) (hRow ⟨3, by decide⟩)))
  rw [mat4Vec_mul, h2, mat4Vec_scale2, h3, h1] at hV
  have hVecEq : d4RootOf (wf4Perm (wf4Mul g1 g2) a) = d4RootOf (wf4Perm g1 (wf4Perm g2 a)) :=
    vec4_cancel_scale2 _ _ (vec4_cancel_scale2 _ _ hV.symm)
  exact (by decide : ∀ x y : Fin 24, d4RootOf x = d4RootOf y → x = y) _ _ hVecEq

private theorem wf4Inv_mul_self (g : WF4Elem) : wf4Mul (wf4Inv g) g = wf4Id := by
  apply thm_wf4_semidirect_order_1152.2.2.1
  have hT : wf4Mat2 (wf4Inv g) = mat4Transpose (wf4Mat2 g) := by
    have h2 : ∀ i j : Fin 4, 2 * wf4Mat2 (wf4Inv g) i j = 2 * mat4Transpose (wf4Mat2 g) i j := by
      intro i j
      rw [wf4_even_entries (wf4Inv g) i j]
      have hTr : 2 * mat4Transpose (wf4Mat2 g) i j =
          mat4Mul (mat4Transpose (s3Mat2 g.2.2)) (mat4Transpose (wd4Mat2 (g.1, g.2.1))) i j := by
        rw [← mat4Transpose_mul]
        exact wf4_even_entries g j i
      rw [hTr]
      have hS3T : mat4Transpose (s3Mat2 g.2.2) = s3Mat2 (s3Inv g.2.2) :=
        mat4_ext _ _ (fun p q => (s3_and_wd4_closure_tables.2.1 g.2.2 p q).symm)
      have hWD4T : mat4Transpose (wd4Mat2 (g.1, g.2.1)) = wd4Mat2 (wd4Inv (g.1, g.2.1)) :=
        mat4_ext _ _ ((by decide : ∀ (p : Fin 24) (e : Fin 8) (r c : Fin 4),
          mat4Transpose (wd4Mat2 (p, e)) r c = wd4Mat2 (wd4Inv (p, e)) r c) g.1 g.2.1)
      rw [hS3T, hWD4T, conjS3WD4_mat2]
      rfl
    apply mat4_ext; intro i j; have hij := h2 i j; omega
  have hInv : mat4Mul (wf4Mat2 (wf4Inv g)) (wf4Mat2 g) = fun i j => 2 * wf4Mat2 wf4Id i j := by
    rw [hT, (thm_wf4_action_orthogonal_and_bijective g).1]
    apply mat4_ext; intro i j
    exact (by decide : ∀ r c : Fin 4, (if r = c then (4 : Int) else 0) = 2 * wf4Mat2 wf4Id r c) i j
  have hEq := (wf4Mul_mat2 (wf4Inv g) g).symm.trans hInv
  apply mat4_ext; intro i j
  have hij := congrFun (congrFun hEq i) j
  omega

private theorem wf4Inv_perm (g : WF4Elem) (a : Fin 24) :
    wf4Perm (wf4Inv g) (wf4Perm g a) = a := by
  rw [← wf4Perm_mul, wf4Inv_mul_self]
  exact (by decide : ∀ x : Fin 24, wf4Perm wf4Id x = x) a

private theorem wf4Det_inv (g : WF4Elem) : wf4Det (wf4Inv g) = wf4Det g := by
  have h : wf4Det (wf4Mul (wf4Inv g) g) = 1 := by
    rw [wf4Inv_mul_self]; decide
  rw [wf4Det_mul] at h
  rcases wf4Det_pm_one (wf4Inv g) with h1 | h1 <;>
    rcases wf4Det_pm_one g with h2 | h2 <;>
    rw [h1, h2] at h ⊢ <;> omega

/-- Headline Theorem 8: Unconditional Pointwise `k = 3` Mirror Theorem:
    for EVERY triple `(a, b, c) : Fin 24 × Fin 24 × Fin 24` of `D_4` roots, there exists an EXPLICIT
    improper element `g ∈ W(F_4)` (`wf4Det g = -1`) fixing ALL THREE roots `a, b, c` **pointwise**! -/
theorem thm_k3_pointwise_improper_stabilizer (a b c : Fin 24) :
    ∃ g : WF4Elem, wf4Det g = -1 ∧ wf4Perm g a = a ∧ wf4Perm g b = b ∧ wf4Perm g c = c := by
  let u := mapToSlot0 a
  let b' := wf4Perm u b
  let c' := wf4Perm u c
  have hEx := any_true_exists _ hyperplanesOrthTo0 (k3_mirror_at_slot0.2 b' c')
  obtain ⟨h, hh⟩ := hEx
  have hProps :
      dot4 (d4RootOf ⟨0, by decide⟩) (f4Hyperplane h) = 0 ∧
      dot4 (d4RootOf b') (f4Hyperplane h) = 0 ∧
      dot4 (d4RootOf c') (f4Hyperplane h) = 0 :=
    of_decide_eq_true hh
  let g := wf4Mul (wf4Inv u) (wf4Mul (f4ReflWF4 h) u)
  refine ⟨g, ?_, ?_, ?_, ?_⟩
  · change wf4Det (wf4Mul (wf4Inv u) (wf4Mul (f4ReflWF4 h) u)) = -1
    rw [wf4Det_mul, wf4Det_mul, wf4Det_inv, thm_f4_24_reflection_hyperplanes.1 h]
    rcases wf4Det_pm_one u with hu | hu <;> rw [hu] <;> decide
  · change wf4Perm (wf4Mul (wf4Inv u) (wf4Mul (f4ReflWF4 h) u)) a = a
    rw [wf4Perm_mul, wf4Perm_mul, k3_mirror_at_slot0.1 a,
        thm_f4_24_reflection_hyperplanes.2.2.2 h ⟨0, by decide⟩ hProps.1,
        ← k3_mirror_at_slot0.1 a, wf4Inv_perm]
  · change wf4Perm (wf4Mul (wf4Inv u) (wf4Mul (f4ReflWF4 h) u)) b = b
    rw [wf4Perm_mul, wf4Perm_mul,
        thm_f4_24_reflection_hyperplanes.2.2.2 h b' hProps.2.1, wf4Inv_perm]
  · change wf4Perm (wf4Mul (wf4Inv u) (wf4Mul (f4ReflWF4 h) u)) c = c
    rw [wf4Perm_mul, wf4Perm_mul,
        thm_f4_24_reflection_hyperplanes.2.2.2 h c' hProps.2.2, wf4Inv_perm]

/-- Action of `g ∈ W(F_4)` on a 24-slot `DockState`: slot `i` receives the tone from `g^{-1}(i)`
    so that a single excitation at slot `a` moves to slot `g(a)`. -/
def actWF4Dock (g : WF4Elem) (d : DockState) : DockState :=
  fun i => d (wf4PermInv g i)

/-- Combined action of `(g, c) ∈ W(F_4) × ℤ_2^C` on a 24-slot `DockState`
    (`c = false` leaves tones unchanged, `c = true` applies charge conjugation `conjDock`). -/
def actFullDock (g : WF4Elem) : Bool → DockState → DockState
  | false, d => actWF4Dock g d
  | true,  d => conjDock (actWF4Dock g d)

/-- Pseudoscalar character `χ(g, c) = c_sgn * det(g) ∈ {-1, +1}` of `W(F_4) × ℤ_2^C`. -/
def fullChar (g : WF4Elem) : Bool → Int
  | false => wf4Det g
  | true  => -wf4Det g

/-- Spatial parity reflection `P` on a 24-slot `DockState` (`diag(1, 1, 1, -1)`). -/
def parityDock (d : DockState) : DockState := actWF4Dock wf4Parity d

/-- Combined `CP` symmetry on a 24-slot `DockState`: `C ∘ P`. -/
def cpDock (d : DockState) : DockState := conjDock (parityDock d)

/-- Exact `W(F_4) × ℤ_2^C` chirality predicate (`value-phase.ts` qualifying condition):
    a dock state `d` is chiral iff NO improper element `(g, c)` with `c * det(g) = -1` fixes `d`. -/
def isChiralUnderG (d : DockState) : Prop :=
  ∀ (g : WF4Elem) (c : Bool), actFullDock g c d = d → fullChar g c = 1

/-- Universal `W(F_4)`-pseudoscalar predicate for any integer dock functional `F : DockState → Int`. -/
def isWF4Pseudoscalar (F : DockState → Int) : Prop :=
  ∀ (g : WF4Elem) (d : DockState), F (actWF4Dock g d) = wf4Det g * F d

private theorem actWF4Dock_fixes_of_support_fixed (g : WF4Elem) (d : DockState)
    (hFix : ∀ i : Fin 24, d i ≠ .zero → wf4Perm g i = i) :
    actWF4Dock g d = d := by
  funext i
  unfold actWF4Dock
  if hEq : wf4PermInv g i = i then
    rw [hEq]
  else
    have hZeroInv : d (wf4PermInv g i) = .zero := by
      cases hD : d (wf4PermInv g i) with
      | neg =>
        have hNe : d (wf4PermInv g i) ≠ .zero := by rw [hD]; decide
        have hP := hFix (wf4PermInv g i) hNe
        rw [((thm_wf4_action_orthogonal_and_bijective g).2.2.1 i).2] at hP
        exact absurd hP.symm hEq
      | zero => rfl
      | pos =>
        have hNe : d (wf4PermInv g i) ≠ .zero := by rw [hD]; decide
        have hP := hFix (wf4PermInv g i) hNe
        rw [((thm_wf4_action_orthogonal_and_bijective g).2.2.1 i).2] at hP
        exact absurd hP.symm hEq
    have hZeroI : d i = .zero := by
      cases hD : d i with
      | neg =>
        have hNe : d i ≠ .zero := by rw [hD]; decide
        have hP := hFix i hNe
        have hInv := congrArg (wf4PermInv g) hP
        rw [((thm_wf4_action_orthogonal_and_bijective g).2.2.1 i).1] at hInv
        exact absurd hInv.symm hEq
      | zero => rfl
      | pos =>
        have hNe : d i ≠ .zero := by rw [hD]; decide
        have hP := hFix i hNe
        have hInv := congrArg (wf4PermInv g) hP
        rw [((thm_wf4_action_orthogonal_and_bijective g).2.2.1 i).1] at hInv
        exact absurd hInv.symm hEq
    rw [hZeroInv, hZeroI]

/-- Headline Theorem 9 (Unconditional `k = 1` Achirality):
    EVERY 1-slot signed dock configuration is fixed pointwise by an improper `g ∈ W(F_4)` (`det = -1`),
    is achiral under `W(F_4) × ℤ_2^C`, and forces EVERY `W(F_4)`-pseudoscalar `F` to vanish identically. -/
theorem thm_achiral_k1 (a : Fin 24) (d : DockState)
    (hSupp : ∀ i : Fin 24, i ≠ a → d i = .zero) :
    (∃ g : WF4Elem, wf4Det g = -1 ∧ actWF4Dock g d = d) ∧
    ¬ isChiralUnderG d ∧
    (∀ F : DockState → Int, isWF4Pseudoscalar F → F d = 0) := by
  obtain ⟨g, hDet, ha, _, _⟩ := thm_k3_pointwise_improper_stabilizer a a a
  have hFix : actWF4Dock g d = d := by
    apply actWF4Dock_fixes_of_support_fixed g d
    intro i hi
    if hia : i = a then rw [hia]; exact ha
    else exact absurd (hSupp i hia) hi
  refine ⟨⟨g, hDet, hFix⟩, ?_, ?_⟩
  · intro hCh
    have h1 := hCh g false hFix
    simp only [fullChar] at h1
    omega
  · intro F hF
    have h := hF g d
    rw [hFix, hDet] at h
    omega

