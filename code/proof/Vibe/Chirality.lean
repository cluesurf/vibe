/-- All 8 even-parity sign flips on `ℝ^4` given as even-length lists of negated coordinates. -/
def evenSignNegs : Fin 8 → List (Fin 4)
  | ⟨0, _⟩ => []
  | ⟨1, _⟩ => [⟨2, by decide⟩, ⟨3, by decide⟩]
  | ⟨2, _⟩ => [⟨1, by decide⟩, ⟨3, by decide⟩]
  | ⟨3, _⟩ => [⟨1, by decide⟩, ⟨2, by decide⟩]
