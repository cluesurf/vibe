def anyList {α : Type} (p : α → Bool) : List α → Bool
  | [] => false
  | x :: xs => p x || anyList p xs

private theorem k3_mirror_at_slot0 :
    (∀ a : Fin 24, wf4Perm (mapToSlot0 a) a = ⟨0, by decide⟩) ∧
    (∀ b c : Fin 24,
      anyList (fun h =>
        decide (dot4 (d4RootOf ⟨0, by decide⟩) (f4Hyperplane h) = 0 ∧
                dot4 (d4RootOf b) (f4Hyperplane h) = 0 ∧
                dot4 (d4RootOf c) (f4Hyperplane h) = 0)) hyperplanesOrthTo0 = true) := by
  decide

private theorem any_true_exists {α : Type} (p : α → Bool) :
    ∀ xs : List α, anyList p xs = true → ∃ x : α, p x = true
  | [], h => Bool.noConfusion h
  | a :: rest, h => by
    simp only [anyList] at h
    cases hp : p a with
    | true => exact ⟨a, hp⟩
    | false => rw [hp] at h; exact any_true_exists p rest h

private theorem wf4Perm_mul (g1 g2 : WF4Elem) (a : Fin 24) :
    wf4Perm (wf4Mul g1 g2) a = wf4Perm g1 (wf4Perm g2 a) := by
  have hV : mat4Vec (mat4Mul (wf4Mat2 g1) (wf4Mat2 g2)) (d4RootOf a) =
      scaleVec4 2 (mat4Vec (wf4Mat2 (wf4Mul g1 g2)) (d4RootOf a)) := by
    rw [wf4Mul_mat2, mat4Vec_scale_mat]
  rw [mat4Vec_mul, wf4Mat2_eq_mat4Vec_action g2 a, mat4Vec_scale2,
      wf4Mat2_eq_mat4Vec_action g1 _, wf4Mat2_eq_mat4Vec_action (wf4Mul g1 g2) a] at hV
  exact (by decide : ∀ x y : Fin 24, d4RootOf x = d4RootOf y → x = y) _ _
    (vec4_cancel_scale2 _ _ (vec4_cancel_scale2 _ _ hV.symm))

private theorem wf4Inv_mul_self (g : WF4Elem) : wf4Mul (wf4Inv g) g = wf4Id := by
  apply thm_wf4_semidirect_order_1152.2.2.1
  have hT : wf4Mat2 (wf4Inv g) = mat4Transpose (wf4Mat2 g) := by
    have h2 : ∀ i j : Fin 4, 2 * wf4Mat2 (wf4Inv g) i j = 2 * mat4Transpose (wf4Mat2 g) i j := fun i j => by
      rw [wf4_even_entries (wf4Inv g) i j]
      have hTr : 2 * mat4Transpose (wf4Mat2 g) i j =
          mat4Mul (mat4Transpose (s3Mat2 g.2.2)) (mat4Transpose (wd4Mat2 (g.1, g.2.1))) i j := by
        rw [← mat4Transpose_mul]; exact wf4_even_entries g j i
      rw [hTr, show mat4Transpose (s3Mat2 g.2.2) = s3Mat2 (s3Inv g.2.2) from
            mat4_ext _ _ (fun p q => (s3_and_wd4_closure_tables.2.1 g.2.2 p q).symm),
          show mat4Transpose (wd4Mat2 (g.1, g.2.1)) = wd4Mat2 (wd4Inv (g.1, g.2.1)) from
            mat4_ext _ _ ((by decide : ∀ (p : Fin 24) (e : Fin 8) (r c : Fin 4),
              mat4Transpose (wd4Mat2 (p, e)) r c = wd4Mat2 (wd4Inv (p, e)) r c) g.1 g.2.1),
          conjS3WD4_mat2]
      rfl
    apply mat4_ext; intro i j; have hij := h2 i j; omega
  have hInv : mat4Mul (wf4Mat2 (wf4Inv g)) (wf4Mat2 g) = fun i j => 2 * wf4Mat2 wf4Id i j := by
    rw [hT, (thm_wf4_action_orthogonal_and_bijective g).1]
    exact mat4_ext _ _ (by decide : ∀ r c : Fin 4, (if r = c then (4 : Int) else 0) = 2 * wf4Mat2 wf4Id r c)
  have hEq := (wf4Mul_mat2 (wf4Inv g) g).symm.trans hInv
  apply mat4_ext; intro i j; have hij := congrFun (congrFun hEq i) j; omega

private theorem wf4Inv_perm (g : WF4Elem) (a : Fin 24) :
    wf4Perm (wf4Inv g) (wf4Perm g a) = a := by
  rw [← wf4Perm_mul, wf4Inv_mul_self]
  exact (by decide : ∀ x : Fin 24, wf4Perm wf4Id x = x) a

private theorem wf4Det_inv (g : WF4Elem) : wf4Det (wf4Inv g) = wf4Det g := by
  have h : wf4Det (wf4Mul (wf4Inv g) g) = 1 := by rw [wf4Inv_mul_self]; decide
  rw [wf4Det_mul] at h
  rcases wf4Det_pm_one (wf4Inv g) with h1 | h1 <;> rcases wf4Det_pm_one g with h2 | h2 <;>
    rw [h1, h2] at h ⊢ <;> omega

/-- Headline Theorem 8: Unconditional Pointwise `k = 3` Mirror Theorem. -/
theorem thm_k3_pointwise_improper_stabilizer (a b c : Fin 24) :
    ∃ g : WF4Elem, wf4Det g = -1 ∧ wf4Perm g a = a ∧ wf4Perm g b = b ∧ wf4Perm g c = c := by
  let u := mapToSlot0 a
  let b' := wf4Perm u b
  let c' := wf4Perm u c
  obtain ⟨h, hh⟩ := any_true_exists _ hyperplanesOrthTo0 (k3_mirror_at_slot0.2 b' c')
  have hProps := of_decide_eq_true hh
  let g := wf4Mul (wf4Inv u) (wf4Mul (f4ReflWF4 h) u)
  refine ⟨g, ?_, ?_, ?_, ?_⟩
  · change wf4Det (wf4Mul (wf4Inv u) (wf4Mul (f4ReflWF4 h) u)) = -1
    rw [wf4Det_mul, wf4Det_mul, wf4Det_inv, thm_f4_24_reflection_hyperplanes.1 h]
    rcases wf4Det_pm_one u with hu | hu <;> rw [hu] <;> decide
  · change wf4Perm (wf4Mul (wf4Inv u) (wf4Mul (f4ReflWF4 h) u)) a = a
    rw [wf4Perm_mul, wf4Perm_mul, k3_mirror_at_slot0.1 a,
        thm_f4_24_reflection_hyperplanes.2.2.2 h ⟨0, by decide⟩ hProps.1,
        ← k3_mirror_at_slot0.1 a, wf4Inv_perm]
  · change wf4Perm (wf4Mul (wf4Inv u) (wf4Mul (f4ReflWF4 h) u)) b = b
    rw [wf4Perm_mul, wf4Perm_mul, thm_f4_24_reflection_hyperplanes.2.2.2 h b' hProps.2.1, wf4Inv_perm]
  · change wf4Perm (wf4Mul (wf4Inv u) (wf4Mul (f4ReflWF4 h) u)) c = c
    rw [wf4Perm_mul, wf4Perm_mul, thm_f4_24_reflection_hyperplanes.2.2.2 h c' hProps.2.2, wf4Inv_perm]

def actWF4Dock (g : WF4Elem) (d : DockState) : DockState := fun i => d (wf4PermInv g i)

def actFullDock (g : WF4Elem) : Bool → DockState → DockState
  | false, d => actWF4Dock g d
  | true,  d => conjDock (actWF4Dock g d)

def fullChar (g : WF4Elem) : Bool → Int
  | false => wf4Det g
  | true  => -wf4Det g

def parityDock (d : DockState) : DockState := actWF4Dock wf4Parity d
def cpDock (d : DockState) : DockState := conjDock (parityDock d)

def isChiralUnderG (d : DockState) : Prop :=
  ∀ (g : WF4Elem) (c : Bool), actFullDock g c d = d → fullChar g c = 1

def isWF4Pseudoscalar (F : DockState → Int) : Prop :=
  ∀ (g : WF4Elem) (d : DockState), F (actWF4Dock g d) = wf4Det g * F d

private theorem actWF4Dock_fixes_of_support_fixed (g : WF4Elem) (d : DockState)
    (hFix : ∀ i : Fin 24, d i ≠ .zero → wf4Perm g i = i) : actWF4Dock g d = d := by
  funext i; unfold actWF4Dock
  by_cases hEq : wf4PermInv g i = i
  · rw [hEq]
  · have hZeroInv : d (wf4PermInv g i) = .zero := by
      by_contra hNe
      have hP := hFix (wf4PermInv g i) hNe
      rw [((thm_wf4_action_orthogonal_and_bijective g).2.2.1 i).2] at hP
      exact hEq hP.symm
    have hZeroI : d i = .zero := by
      by_contra hNe
      have hInv := congrArg (wf4PermInv g) (hFix i hNe)
      rw [((thm_wf4_action_orthogonal_and_bijective g).2.2.1 i).1] at hInv
      exact hEq hInv.symm
    rw [hZeroInv, hZeroI]

/-- Headline Theorem 9 (Unconditional `k = 1` Achirality). -/
theorem thm_achiral_k1 (a : Fin 24) (d : DockState)
    (hSupp : ∀ i : Fin 24, i ≠ a → d i = .zero) :
    (∃ g : WF4Elem, wf4Det g = -1 ∧ actWF4Dock g d = d) ∧
    ¬ isChiralUnderG d ∧
    (∀ F : DockState → Int, isWF4Pseudoscalar F → F d = 0) := by
  obtain ⟨g, hDet, ha, _, _⟩ := thm_k3_pointwise_improper_stabilizer a a a
  have hFix : actWF4Dock g d = d := actWF4Dock_fixes_of_support_fixed g d fun i hi =>
    if hia : i = a then hia ▸ ha else absurd (hSupp i hia) hi
  refine ⟨⟨g, hDet, hFix⟩, fun hCh => by have h1 := hCh g false hFix; simp only [fullChar] at h1; omega,
          fun F hF => by have h := hF g d; rw [hFix, hDet] at h; omega⟩

/-- Headline Theorem 10 (Unconditional `k = 2` Achirality). -/
theorem thm_achiral_k2 (a b : Fin 24) (d : DockState)
    (hSupp : ∀ i : Fin 24, i ≠ a → i ≠ b → d i = .zero) :
    (∃ g : WF4Elem, wf4Det g = -1 ∧ actWF4Dock g d = d) ∧
    ¬ isChiralUnderG d ∧
    (∀ F : DockState → Int, isWF4Pseudoscalar F → F d = 0) := by
  obtain ⟨g, hDet, ha, hb, _⟩ := thm_k3_pointwise_improper_stabilizer a b b
  have hFix : actWF4Dock g d = d := actWF4Dock_fixes_of_support_fixed g d fun i hi =>
    if hia : i = a then hia ▸ ha else if hib : i = b then hib ▸ hb else absurd (hSupp i hia hib) hi
  refine ⟨⟨g, hDet, hFix⟩, fun hCh => by have h1 := hCh g false hFix; simp only [fullChar] at h1; omega,
          fun F hF => by have h := hF g d; rw [hFix, hDet] at h; omega⟩

/-- Headline Theorem 11 (Unconditional `k = 3` Achirality). -/
theorem thm_achiral_k3 (a b c : Fin 24) (d : DockState)
    (hSupp : ∀ i : Fin 24, i ≠ a → i ≠ b → i ≠ c → d i = .zero) :
    (∃ g : WF4Elem, wf4Det g = -1 ∧ actWF4Dock g d = d) ∧
    ¬ isChiralUnderG d ∧
    (∀ F : DockState → Int, isWF4Pseudoscalar F → F d = 0) := by
  obtain ⟨g, hDet, ha, hb, hc⟩ := thm_k3_pointwise_improper_stabilizer a b c
  have hFix : actWF4Dock g d = d := actWF4Dock_fixes_of_support_fixed g d fun i hi =>
    if hia : i = a then hia ▸ ha else if hib : i = b then hib ▸ hb
    else if hic : i = c then hic ▸ hc else absurd (hSupp i hia hib hic) hi
  refine ⟨⟨g, hDet, hFix⟩, fun hCh => by have h1 := hCh g false hFix; simp only [fullChar] at h1; omega,
          fun F hF => by have h := hF g d; rw [hFix, hDet] at h; omega⟩


/-! ## Section 6: Exact `χ_odd` Polynomial Pseudoscalar (Bridged to `Finset.sum`) & Sharp `k* = 4` Witnesses -/

def inList24 (a : Fin 24) : List (Fin 24) → Bool
  | [] => false
  | x :: xs => decide (x = a) || inList24 a xs

def noDup24 : List (Fin 24) → Bool
  | [] => true
  | x :: xs => !(inList24 x xs) && noDup24 xs

def erase24 (a : Fin 24) : List (Fin 24) → List (Fin 24)
  | [] => []
  | x :: xs => if x = a then xs else x :: erase24 a xs

def sumList24 (f : Fin 24 → Int) : List (Fin 24) → Int
  | [] => 0
  | x :: xs => f x + sumList24 f xs

def allSlots24 : List (Fin 24) := List.finRange 24
def sumFin24 (f : Fin 24 → Int) : Int := sumList24 f allSlots24

private theorem inList24_eq_true_iff (a : Fin 24) : ∀ l : List (Fin 24), inList24 a l = true ↔ a ∈ l
  | [] => by simp [inList24]
  | x :: xs => by
    simp only [inList24, Bool.or_eq_true, decide_eq_true_eq, List.mem_cons, inList24_eq_true_iff a xs]
    rw [eq_comm]

private theorem nodup_of_noDup24 : ∀ l : List (Fin 24), noDup24 l = true → l.Nodup
  | [], _ => List.nodup_nil
  | x :: xs, h => by
    simp only [noDup24, Bool.and_eq_true, Bool.not_eq_true'] at h
    refine List.nodup_cons.mpr ⟨fun hx => ?_, nodup_of_noDup24 xs h.2⟩
    have ht := (inList24_eq_true_iff x xs).mpr hx
    rw [h.1] at ht; exact Bool.noConfusion ht

private theorem sumList24_eq_finset_sum (f : Fin 24 → Int) (l : List (Fin 24)) (hnd : l.Nodup) :
    sumList24 f l = ∑ i ∈ l.toFinset, f i := by
  induction l with
  | nil => simp [sumList24]
  | cons x xs ih =>
    rw [List.nodup_cons] at hnd
    have hnot : x ∉ xs.toFinset := by simp [hnd.1]
    simp only [sumList24, List.toFinset_cons, Finset.sum_insert hnot, ih hnd.2]

private theorem sumFin24_eq_sum (f : Fin 24 → Int) : sumFin24 f = ∑ i : Fin 24, f i := by
  unfold sumFin24 allSlots24
  rw [sumList24_eq_finset_sum f _ (List.nodup_finRange 24),
      show (List.finRange 24).toFinset = Finset.univ by ext i; simp]

private theorem sumFin24_support (f : Fin 24 → Int) (S : List (Fin 24))
    (hndS : noDup24 S = true) (hZero : ∀ x : Fin 24, inList24 x S = false → f x = 0) :
    sumFin24 f = sumList24 f S := by
  rw [sumFin24_eq_sum, sumList24_eq_finset_sum f S (nodup_of_noDup24 S hndS)]
  symm
  refine Finset.sum_subset (Finset.subset_univ _) fun x _ hx => ?_
  apply hZero x
  cases hin : inList24 x S with
  | false => rfl
  | true => exact absurd (List.mem_toFinset.mpr ((inList24_eq_true_iff x S).mp hin)) hx

def gramWeight4 (a b c d : Fin 24) : Int :=
  let g01 := dot4 (d4RootOf a) (d4RootOf b)
  let g02 := dot4 (d4RootOf a) (d4RootOf c)
  let g12 := dot4 (d4RootOf b) (d4RootOf c)
  let g13 := dot4 (d4RootOf b) (d4RootOf d)
  let g23 := dot4 (d4RootOf c) (d4RootOf d)
  g01 * g02 * g13 + 3 * g01 * g12 * g23 * g23

def chiOddTerm (d : DockState) (a b c e : Fin 24) : Int :=
  let ta := (d a).value
  let tb := (d b).value
  let tc := (d c).value
  let te := (d e).value
  det4Vecs (d4RootOf a) (d4RootOf b) (d4RootOf c) (d4RootOf e) *
    (ta * (tb * tb) * (tc * tc) * (te * te) * gramWeight4 a b c e)

def chiOddPoly (d : DockState) : Int :=
  sumFin24 (fun a => sumFin24 (fun b => sumFin24 (fun c => sumFin24 (fun e => chiOddTerm d a b c e))))

def chiOddPolyOn (S : List (Fin 24)) (d : DockState) : Int :=
  sumList24 (fun a => sumList24 (fun b => sumList24 (fun c => sumList24 (fun e => chiOddTerm d a b c e) S) S) S) S

private theorem chiOddPoly_eq_on_support (S : List (Fin 24)) (d : DockState)
    (hnd : noDup24 S = true) (hSupp : ∀ i : Fin 24, inList24 i S = false → d i = .zero) :
    chiOddPoly d = chiOddPolyOn S d := by
  have hTermZero : ∀ a b c e : Fin 24,
      (inList24 a S = false ∨ inList24 b S = false ∨ inList24 c S = false ∨ inList24 e S = false) →
      chiOddTerm d a b c e = 0 := by
    intro a b c e hOr; unfold chiOddTerm
    rcases hOr with ha | hb | hc | he
    · rw [hSupp a ha]; simp [Tone.value]
    · rw [hSupp b hb]; simp [Tone.value]
    · rw [hSupp c hc]; simp [Tone.value]
    · rw [hSupp e he]; simp [Tone.value]
  have hZ : ∀ f : Fin 24 → Int, (∀ x, f x = 0) → sumFin24 f = 0 :=
    fun f hf => by simp [sumFin24_eq_sum, hf]
  unfold chiOddPoly chiOddPolyOn
  rw [sumFin24_support _ S hnd (fun a ha => hZ _ fun b => hZ _ fun c => hZ _ fun e => hTermZero a b c e (Or.inl ha))]
  congr 1; funext a
  rw [sumFin24_support _ S hnd (fun b hb => hZ _ fun c => hZ _ fun e => hTermZero a b c e (Or.inr (Or.inl hb)))]
  congr 1; funext b
  rw [sumFin24_support _ S hnd (fun c hc => hZ _ fun e => hTermZero a b c e (Or.inr (Or.inr (Or.inl hc))))]
  congr 1; funext c
  exact sumFin24_support _ S hnd (fun e he => hTermZero a b c e (Or.inr (Or.inr (Or.inr he))))

private theorem chir_tone_dual_value (t : Tone) : t.dual.value = -t.value := by cases t <;> decide

private theorem gramWeight4_wf4_inv (g : WF4Elem) (a b c e : Fin 24) :
    gramWeight4 (wf4Perm g a) (wf4Perm g b) (wf4Perm g c) (wf4Perm g e) = gramWeight4 a b c e := by
  have hDot := (thm_wf4_action_orthogonal_and_bijective g).2.2.2.2.1
  unfold gramWeight4; rw [hDot a b, hDot a c, hDot b c, hDot b e, hDot c e]

/-- Headline Theorem 12: Exact global `W(F_4) × ℤ_2^C` transformation laws for `chiOddPoly`. -/
theorem thm_chiOddPoly_transformation_laws :
    (∀ (g : WF4Elem) (d : DockState), chiOddPoly (actWF4Dock g d) = wf4Det g * chiOddPoly d) ∧
    (∀ (g : WF4Elem) (d : DockState), wf4Det g = 1 → chiOddPoly (actWF4Dock g d) = chiOddPoly d) ∧
    (∀ d : DockState, chiOddPoly (conjDock d) = -chiOddPoly d) ∧
    (∀ d : DockState, chiOddPoly (parityDock d) = -chiOddPoly d) ∧
    (∀ d : DockState, chiOddPoly (cpDock d) = chiOddPoly d) ∧
    (∀ (g : WF4Elem) (c : Bool) (d : DockState),
      chiOddPoly (actFullDock g c d) = fullChar g c * chiOddPoly d) := by
  have hWF4 : ∀ (g : WF4Elem) (d : DockState), chiOddPoly (actWF4Dock g d) = wf4Det g * chiOddPoly d := by
    intro g d
    have hBij := (thm_wf4_action_orthogonal_and_bijective g).2.2.1
    let ePerm : Fin 24 ≃ Fin 24 :=
      ⟨wf4Perm g, wf4PermInv g, fun i => (hBij i).1, fun i => (hBij i).2⟩
    simp only [chiOddPoly, sumFin24_eq_sum, Finset.mul_sum]
    rw [← Equiv.sum_comp ePerm]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [← Equiv.sum_comp ePerm]
    refine Finset.sum_congr rfl fun b _ => ?_
    rw [← Equiv.sum_comp ePerm]
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [← Equiv.sum_comp ePerm]
    refine Finset.sum_congr rfl fun e _ => ?_
    change chiOddTerm (actWF4Dock g d) (wf4Perm g a) (wf4Perm g b) (wf4Perm g c) (wf4Perm g e) =
      wf4Det g * chiOddTerm d a b c e
    unfold chiOddTerm actWF4Dock
    rw [(hBij a).1, (hBij b).1, (hBij c).1, (hBij e).1,
        thm_wf4_det4_transformation g a b c e, gramWeight4_wf4_inv g a b c e, Int.mul_assoc]
  have hConj : ∀ d : DockState, chiOddPoly (conjDock d) = -chiOddPoly d := by
    intro d
    simp only [chiOddPoly, sumFin24_eq_sum, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ =>
      Finset.sum_congr rfl fun c _ => Finset.sum_congr rfl fun e _ => ?_
    unfold chiOddTerm conjDock
    simp only [chir_tone_dual_value]; ring
  have hParDet : wf4Det wf4Parity = -1 := by decide
  refine ⟨hWF4, fun g d hg => by rw [hWF4 g d, hg, one_mul], hConj,
          fun d => by unfold parityDock; rw [hWF4 wf4Parity d, hParDet]; omega,
          fun d => by unfold cpDock parityDock; rw [hConj, hWF4 wf4Parity d, hParDet]; omega,
          fun g c d => by cases c <;> simp only [actFullDock, fullChar] <;> [exact hWF4 g d; rw [hConj, hWF4 g d, Int.neg_mul]]⟩

/-- Headline Theorem 13: `chiOddPoly` vanishes identically on `v1Dock` and every `k ≤ 3` dock. -/
theorem thm_chiOddPoly_vanishes_k_le_3 :
    chiOddPoly v1Dock = 0 ∧
    (∀ (a b c : Fin 24) (d : DockState),
      (∀ i : Fin 24, i ≠ a → i ≠ b → i ≠ c → d i = .zero) → chiOddPoly d = 0) :=
  ⟨(thm_achiral_k1 ⟨0, by decide⟩ v1Dock (fun _ _ => rfl)).2.2 chiOddPoly thm_chiOddPoly_transformation_laws.1,
   fun a b c d hSupp => (thm_achiral_k3 a b c d hSupp).2.2 chiOddPoly thm_chiOddPoly_transformation_laws.1⟩

def mkDock4 (s0 : Fin 24) (t0 : Tone) (s1 : Fin 24) (t1 : Tone)
    (s2 : Fin 24) (t2 : Tone) (s3 : Fin 24) (t3 : Tone) : DockState :=
  fun i => if i = s0 then t0 else if i = s1 then t1 else if i = s2 then t2 else if i = s3 then t3 else .zero

def dockMixed : DockState := mkDock4 ⟨0, by decide⟩ .pos ⟨1, by decide⟩ .neg ⟨4, by decide⟩ .pos ⟨10, by decide⟩ .pos
def dockX1 : DockState := mkDock4 ⟨0, by decide⟩ .pos ⟨1, by decide⟩ .pos ⟨4, by decide⟩ .pos ⟨16, by decide⟩ .pos
def dockE184Active : DockState := mkDock4 ⟨1, by decide⟩ .pos ⟨3, by decide⟩ .pos ⟨4, by decide⟩ .pos ⟨10, by decide⟩ .pos
def dockE184Achiral : DockState := mkDock4 ⟨0, by decide⟩ .pos ⟨1, by decide⟩ .pos ⟨4, by decide⟩ .pos ⟨10, by decide⟩ .pos

private theorem chiral_of_chiOddPoly_ne_zero (d : DockState) (h : chiOddPoly d ≠ 0) : isChiralUnderG d := by
  intro g c hFix
  have hLaw := thm_chiOddPoly_transformation_laws.2.2.2.2.2 g c d
  rw [hFix] at hLaw
  have hChar : fullChar g c = 1 ∨ fullChar g c = -1 := by
    cases c with
    | false => exact wf4Det_pm_one g
    | true => rcases wf4Det_pm_one g with hd | hd <;> [exact Or.inr (by simp [fullChar, hd]); exact Or.inl (by simp [fullChar, hd])]
  rcases hChar with h1 | hm1
  · exact h1
  · rw [hm1] at hLaw; omega

/-- Headline Theorem 14 (Sharp `k* = 4` Chiral Witnesses & Achiral `E-FND-0184` Control). -/
theorem thm_k4_chiral_witnesses_sharp :
    (chiOddPoly dockMixed = 32 ∧ isChiralUnderG dockMixed) ∧
    (chiOddPoly dockX1 = -8 ∧ isChiralUnderG dockX1) ∧
    (chiOddPoly dockE184Active = 8 ∧ isChiralUnderG dockE184Active) ∧
    (chiOddPoly dockE184Achiral = 0 ∧ ¬ isChiralUnderG dockE184Achiral) := by
  let sMixed : List (Fin 24) := [⟨0, by decide⟩, ⟨1, by decide⟩, ⟨4, by decide⟩, ⟨10, by decide⟩]
  let sX1 : List (Fin 24) := [⟨0, by decide⟩, ⟨1, by decide⟩, ⟨4, by decide⟩, ⟨16, by decide⟩]
  let s184 : List (Fin 24) := [⟨1, by decide⟩, ⟨3, by decide⟩, ⟨4, by decide⟩, ⟨10, by decide⟩]
  have hMixed : chiOddPoly dockMixed = 32 := by rw [chiOddPoly_eq_on_support sMixed dockMixed (by decide) (by decide)]; decide
  have hX1 : chiOddPoly dockX1 = -8 := by rw [chiOddPoly_eq_on_support sX1 dockX1 (by decide) (by decide)]; decide
  have h184A : chiOddPoly dockE184Active = 8 := by rw [chiOddPoly_eq_on_support s184 dockE184Active (by decide) (by decide)]; decide
  have h184Z : chiOddPoly dockE184Achiral = 0 := by rw [chiOddPoly_eq_on_support sMixed dockE184Achiral (by decide) (by decide)]; decide
  have hNotCh : ¬ isChiralUnderG dockE184Achiral := by
    intro hCh
    let g := f4ReflWF4 ⟨13, by decide⟩
    have hFix : actFullDock g false dockE184Achiral = dockE184Achiral := funext fun i =>
      (by decide : ∀ x : Fin 24, actFullDock (f4ReflWF4 ⟨13, by decide⟩) false dockE184Achiral x = dockE184Achiral x) i
    have h1 := hCh g false hFix
    have hDet : fullChar g false = -1 := by decide
    omega
  exact ⟨⟨hMixed, chiral_of_chiOddPoly_ne_zero dockMixed (by omega)⟩,
         ⟨hX1, chiral_of_chiOddPoly_ne_zero dockX1 (by omega)⟩,
         ⟨h184A, chiral_of_chiOddPoly_ne_zero dockE184Active (by omega)⟩,
         ⟨h184Z, hNotCh⟩⟩

