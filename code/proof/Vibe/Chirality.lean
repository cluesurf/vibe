private theorem det4Vecs_s3Slot (c : Fin 6) (a b c0 d : Fin 24) :
    det4Vecs (d4RootOf (s3Slot c a)) (d4RootOf (s3Slot c b))
             (d4RootOf (s3Slot c c0)) (d4RootOf (s3Slot c d)) =
      s3Det c * det4Vecs (d4RootOf a) (d4RootOf b) (d4RootOf c0) (d4RootOf d) := by
  have hDet4 : ∀ u v w z : Vec4,
      det4Vecs (mat4Vec (s3Mat2 ⟨4, by decide⟩) u) (mat4Vec (s3Mat2 ⟨4, by decide⟩) v)
               (mat4Vec (s3Mat2 ⟨4, by decide⟩) w) (mat4Vec (s3Mat2 ⟨4, by decide⟩) z) =
        -16 * det4Vecs u v w z := by
    intro u v w z
    simp only [mat4Vec_s3_4]
    rw [det4Vecs_hadamardStep1, det4Vecs_adjSwap, det4Vecs_hadamardStep1]
    omega
  have hDet1 : ∀ u v w z : Vec4,
      det4Vecs (mat4Vec (s3Mat2 ⟨1, by decide⟩) u) (mat4Vec (s3Mat2 ⟨1, by decide⟩) v)
               (mat4Vec (s3Mat2 ⟨1, by decide⟩) w) (mat4Vec (s3Mat2 ⟨1, by decide⟩) z) =
        16 * det4Vecs u v w z := by
    intro u v w z
    simp only [mat4Vec_s3_1]
    rw [det4Vecs_negCoord, hDet4]
    omega
  have hCase1 : ∀ x0 x1 x2 x3 : Fin 24,
      det4Vecs (d4RootOf (s3Slot ⟨1, by decide⟩ x0)) (d4RootOf (s3Slot ⟨1, by decide⟩ x1))
               (d4RootOf (s3Slot ⟨1, by decide⟩ x2)) (d4RootOf (s3Slot ⟨1, by decide⟩ x3)) =
        det4Vecs (d4RootOf x0) (d4RootOf x1) (d4RootOf x2) (d4RootOf x3) := by
    intro x0 x1 x2 x3
    have h := hDet1 (d4RootOf x0) (d4RootOf x1) (d4RootOf x2) (d4RootOf x3)
    rw [factor_slot_align.1 ⟨1, by decide⟩ x0, factor_slot_align.1 ⟨1, by decide⟩ x1,
        factor_slot_align.1 ⟨1, by decide⟩ x2, factor_slot_align.1 ⟨1, by decide⟩ x3,
        det4Vecs_scale2] at h
    omega
  have hCase3Vec : ∀ x : Fin 24,
      d4RootOf (s3Slot ⟨3, by decide⟩ x) = negCoordVec ⟨3, by decide⟩ (d4RootOf x) := by
    intro x
    have hm := factor_slot_align.1 ⟨3, by decide⟩ x
    rw [mat4Vec_s3_3] at hm
    exact vec4_cancel_scale2 _ _ hm.symm
  have hCase3 : ∀ x0 x1 x2 x3 : Fin 24,
      det4Vecs (d4RootOf (s3Slot ⟨3, by decide⟩ x0)) (d4RootOf (s3Slot ⟨3, by decide⟩ x1))
               (d4RootOf (s3Slot ⟨3, by decide⟩ x2)) (d4RootOf (s3Slot ⟨3, by decide⟩ x3)) =
        -det4Vecs (d4RootOf x0) (d4RootOf x1) (d4RootOf x2) (d4RootOf x3) := by
    intro x0 x1 x2 x3
    rw [hCase3Vec x0, hCase3Vec x1, hCase3Vec x2, hCase3Vec x3, det4Vecs_negCoord]
  have hS3SlotRel :
      (∀ x : Fin 24, s3Slot ⟨0, by decide⟩ x = x) ∧
      (∀ x : Fin 24, s3Slot ⟨2, by decide⟩ x = s3Slot ⟨1, by decide⟩ (s3Slot ⟨1, by decide⟩ x)) ∧
      (∀ x : Fin 24, s3Slot ⟨4, by decide⟩ x = s3Slot ⟨3, by decide⟩ (s3Slot ⟨1, by decide⟩ x)) ∧
      (∀ x : Fin 24, s3Slot ⟨5, by decide⟩ x = s3Slot ⟨3, by decide⟩ (s3Slot ⟨2, by decide⟩ x)) := by
    decide
  match c with
  | ⟨0, _⟩ =>
    rw [hS3SlotRel.1 a, hS3SlotRel.1 b, hS3SlotRel.1 c0, hS3SlotRel.1 d,
        (by decide : s3Det ⟨0, by decide⟩ = 1)]
    omega
  | ⟨1, _⟩ =>
    rw [hCase1, (by decide : s3Det ⟨1, by decide⟩ = 1)]
    omega
  | ⟨2, _⟩ =>
    rw [hS3SlotRel.2.1 a, hS3SlotRel.2.1 b, hS3SlotRel.2.1 c0, hS3SlotRel.2.1 d,
        hCase1, hCase1, (by decide : s3Det ⟨2, by decide⟩ = 1)]
    omega
  | ⟨3, _⟩ =>
    rw [hCase3, (by decide : s3Det ⟨3, by decide⟩ = -1)]
    omega
  | ⟨4, _⟩ =>
    rw [hS3SlotRel.2.2.1 a, hS3SlotRel.2.2.1 b, hS3SlotRel.2.2.1 c0, hS3SlotRel.2.2.1 d,
        hCase3, hCase1, (by decide : s3Det ⟨4, by decide⟩ = -1)]
    omega
  | ⟨5, _⟩ =>
    rw [hS3SlotRel.2.2.2 a, hS3SlotRel.2.2.2 b, hS3SlotRel.2.2.2 c0, hS3SlotRel.2.2.2 d,
        hS3SlotRel.2.1 a, hS3SlotRel.2.1 b, hS3SlotRel.2.1 c0, hS3SlotRel.2.1 d,
        hCase3, hCase1, hCase1, (by decide : s3Det ⟨5, by decide⟩ = -1)]
    omega

private theorem det4Vecs_perm4Slot (p : Fin 24) (a b c d : Fin 24) :
    det4Vecs (d4RootOf (perm4Slot p a)) (d4RootOf (perm4Slot p b))
             (d4RootOf (perm4Slot p c)) (d4RootOf (perm4Slot p d)) =
      perm4Det p * det4Vecs (d4RootOf a) (d4RootOf b) (d4RootOf c) (d4RootOf d) := by
  have hEq : ∀ x : Fin 24, d4RootOf (perm4Slot p x) = perm4Vec p (d4RootOf x) := by
    intro x
    have h := factor_slot_align.2.1 p x
    rw [mat4Vec_perm4] at h
    exact vec4_cancel_scale2 _ _ h.symm
  rw [hEq a, hEq b, hEq c, hEq d]
  exact det4Vecs_applySwaps (perm4Word p) (d4RootOf a) (d4RootOf b) (d4RootOf c) (d4RootOf d)

private theorem det4Vecs_evenSignSlot (e : Fin 8) (a b c d : Fin 24) :
    det4Vecs (d4RootOf (evenSignSlot e a)) (d4RootOf (evenSignSlot e b))
             (d4RootOf (evenSignSlot e c)) (d4RootOf (evenSignSlot e d)) =
      det4Vecs (d4RootOf a) (d4RootOf b) (d4RootOf c) (d4RootOf d) := by
  have hEq : ∀ x : Fin 24, d4RootOf (evenSignSlot e x) = evenSignVec e (d4RootOf x) := by
    intro x
    have h := factor_slot_align.2.2.1 e x
    rw [mat4Vec_evenSign] at h
    exact vec4_cancel_scale2 _ _ h.symm
  have hEven : (evenSignNegs e).length % 2 = 0 :=
    (by decide : ∀ k : Fin 8, (evenSignNegs k).length % 2 = 0) e
  rw [hEq a, hEq b, hEq c, hEq d]
  have hD := det4Vecs_applyNegs (evenSignNegs e) (d4RootOf a) (d4RootOf b) (d4RootOf c) (d4RootOf d)
  rw [if_pos hEven, Int.one_mul] at hD
  exact hD

/-- Headline Theorem 6: Exact symbolic `4 × 4` determinant transformation law across ALL 1,152
    elements `g ∈ W(F_4)` and ALL quadruples `(a, b, c, d) : (Fin 24)^4`:
    `det4(r_{g(a)}, r_{g(b)}, r_{g(c)}, r_{g(d)}) = det(g) * det4(r_a, r_b, r_c, r_d)`. -/
theorem thm_wf4_det4_transformation (g : WF4Elem) (a b c d : Fin 24) :
    det4Vecs (d4RootOf (wf4Perm g a)) (d4RootOf (wf4Perm g b))
             (d4RootOf (wf4Perm g c)) (d4RootOf (wf4Perm g d)) =
      wf4Det g * det4Vecs (d4RootOf a) (d4RootOf b) (d4RootOf c) (d4RootOf d) := by
  unfold wf4Perm wf4Det
  rw [det4Vecs_evenSignSlot, det4Vecs_perm4Slot, det4Vecs_s3Slot, ← Int.mul_assoc]


/-! ## Section 5: All 24 `F_4` Reflection Hyperplanes & Unconditional `k* = 4` Achirality (`k = 1, 2, 3`) -/

/-- The 24 distinct `F_4` root-reflection hyperplane normals (`12` long + `4` axes + `8` half-integer). -/
def f4Hyperplane : Fin 24 → Vec4
  | ⟨0, _⟩  => (1,  1,  0,  0)
  | ⟨1, _⟩  => (1, -1,  0,  0)
  | ⟨2, _⟩  => (1,  0,  1,  0)
  | ⟨3, _⟩  => (1,  0, -1,  0)
  | ⟨4, _⟩  => (1,  0,  0,  1)
  | ⟨5, _⟩  => (1,  0,  0, -1)
  | ⟨6, _⟩  => (0,  1,  1,  0)
  | ⟨7, _⟩  => (0,  1, -1,  0)
  | ⟨8, _⟩  => (0,  1,  0,  1)
  | ⟨9, _⟩  => (0,  1,  0, -1)
  | ⟨10, _⟩ => (0,  0,  1,  1)
  | ⟨11, _⟩ => (0,  0,  1, -1)
  | ⟨12, _⟩ => (1,  0,  0,  0)
  | ⟨13, _⟩ => (0,  1,  0,  0)
  | ⟨14, _⟩ => (0,  0,  1,  0)
  | ⟨15, _⟩ => (0,  0,  0,  1)
  | ⟨16, _⟩ => (1,  1,  1,  1)
  | ⟨17, _⟩ => (1,  1,  1, -1)
  | ⟨18, _⟩ => (1,  1, -1,  1)
  | ⟨19, _⟩ => (1,  1, -1, -1)
  | ⟨20, _⟩ => (1, -1,  1,  1)
  | ⟨21, _⟩ => (1, -1,  1, -1)
  | ⟨22, _⟩ => (1, -1, -1,  1)
  | ⟨23, _⟩ => (1, -1, -1, -1)

