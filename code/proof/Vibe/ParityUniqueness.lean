  cases x; simp only [ZSqrt2.add, ZSqrt2.zero, ZSqrt2.mk.injEq]; exact ⟨by omega, by omega⟩
private theorem pu_z2_neg_neg (x : ZSqrt2) : ZSqrt2.neg (ZSqrt2.neg x) = x := by
  cases x; simp only [ZSqrt2.neg, ZSqrt2.mk.injEq]; exact ⟨by omega, by omega⟩
private theorem pu_z2_neg_add (x y : ZSqrt2) : ZSqrt2.neg (ZSqrt2.add x y) = ZSqrt2.add (ZSqrt2.neg x) (ZSqrt2.neg y) := by
  cases x; cases y; simp only [ZSqrt2.neg, ZSqrt2.add, ZSqrt2.mk.injEq]; exact ⟨by omega, by omega⟩
private theorem pu_z2_neg_sub (x y : ZSqrt2) : ZSqrt2.neg (ZSqrt2.sub x y) = ZSqrt2.sub (ZSqrt2.neg x) (ZSqrt2.neg y) := by
  cases x; cases y; simp only [ZSqrt2.neg, ZSqrt2.sub, ZSqrt2.mk.injEq]; exact ⟨by omega, by omega⟩
private theorem pu_z2_mul_comm (x y : ZSqrt2) : ZSqrt2.mul x y = ZSqrt2.mul y x := by
  cases x with | mk xa xb =>
  cases y with | mk ya yb =>
  simp only [ZSqrt2.mul, ZSqrt2.mk.injEq]
  rw [Int.mul_comm xa ya, Int.mul_comm xa yb, Int.mul_comm xb ya,
      Int.mul_assoc 2 xb yb, Int.mul_comm xb yb, ← Int.mul_assoc 2 yb xb]
  exact ⟨by omega, by omega⟩
private theorem pu_z2_mul_add (x y z : ZSqrt2) : ZSqrt2.mul x (ZSqrt2.add y z) = ZSqrt2.add (ZSqrt2.mul x y) (ZSqrt2.mul x z) := by
  cases x; cases y; cases z; simp only [ZSqrt2.mul, ZSqrt2.add, ZSqrt2.mk.injEq, Int.mul_add]; exact ⟨by omega, by omega⟩
private theorem pu_z2_add_mul (x y z : ZSqrt2) : ZSqrt2.mul (ZSqrt2.add x y) z = ZSqrt2.add (ZSqrt2.mul x z) (ZSqrt2.mul y z) := by
  rw [pu_z2_mul_comm, pu_z2_mul_add, pu_z2_mul_comm z x, pu_z2_mul_comm z y]
private theorem pu_z2_sub_mul (x y z : ZSqrt2) : ZSqrt2.mul (ZSqrt2.sub x y) z = ZSqrt2.sub (ZSqrt2.mul x z) (ZSqrt2.mul y z) := by
  cases x; cases y; cases z; simp only [ZSqrt2.mul, ZSqrt2.sub, ZSqrt2.mk.injEq, Int.sub_mul, Int.mul_sub]; exact ⟨by omega, by omega⟩
private theorem pu_z2_neg_mul (x y : ZSqrt2) : ZSqrt2.mul (ZSqrt2.neg x) y = ZSqrt2.neg (ZSqrt2.mul x y) := by
  cases x; cases y; simp only [ZSqrt2.mul, ZSqrt2.neg, ZSqrt2.mk.injEq, Int.neg_mul, Int.mul_neg]; exact ⟨by omega, by omega⟩
private theorem pu_z2_mul_assoc (x y z : ZSqrt2) : ZSqrt2.mul (ZSqrt2.mul x y) z = ZSqrt2.mul x (ZSqrt2.mul y z) := by
  cases x with | mk xa xb =>
  cases y with | mk ya yb =>
  cases z with | mk za zb =>
  simp only [ZSqrt2.mul, ZSqrt2.mk.injEq, Int.add_mul, Int.mul_add, Int.mul_assoc]
  have h1 : xa * (2 * (yb * zb)) = 2 * (xa * (yb * zb)) := by rw [← Int.mul_assoc xa 2, Int.mul_comm xa 2, Int.mul_assoc 2 xa]
  have h2 : xb * (2 * (yb * zb)) = 2 * (xb * (yb * zb)) := by rw [← Int.mul_assoc xb 2, Int.mul_comm xb 2, Int.mul_assoc 2 xb]
  rw [h1, h2]; exact ⟨by omega, by omega⟩
private theorem pu_z2_mul_one (x : ZSqrt2) : ZSqrt2.mul x ZSqrt2.one = x := by
  cases x; simp only [ZSqrt2.mul, ZSqrt2.one, ZSqrt2.mk.injEq]; exact ⟨by omega, by omega⟩
private theorem pu_z2_one_mul (x : ZSqrt2) : ZSqrt2.mul ZSqrt2.one x = x := by rw [pu_z2_mul_comm, pu_z2_mul_one]
private theorem pu_z2_mul_zero (x : ZSqrt2) : ZSqrt2.mul x ZSqrt2.zero = ZSqrt2.zero := by
