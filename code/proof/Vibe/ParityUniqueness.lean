private theorem pu_sum5_add (f g : Fin 5 → ZSqrt2) :
    sum5 (fun k => ZSqrt2.add (f k) (g k)) = ZSqrt2.add (sum5 f) (sum5 g) := by
  have step : ∀ a0 a1 a2 a3 a4 b0 b1 b2 b3 b4 : ZSqrt2,
      ZSqrt2.add (ZSqrt2.add (ZSqrt2.add (ZSqrt2.add (ZSqrt2.add a0 b0) (ZSqrt2.add a1 b1)) (ZSqrt2.add a2 b2)) (ZSqrt2.add a3 b3)) (ZSqrt2.add a4 b4) =
      ZSqrt2.add (ZSqrt2.add (ZSqrt2.add (ZSqrt2.add a0 a1) a2) a3 |>.add a4) (ZSqrt2.add (ZSqrt2.add (ZSqrt2.add b0 b1) b2) b3 |>.add b4) := by
    intro a0 a1 a2 a3 a4 b0 b1 b2 b3 b4
    rw [pu_z2_add_add_add a0 b0 a1 b1, pu_z2_add_add_add (a0.add a1) (b0.add b1) a2 b2,
        pu_z2_add_add_add ((a0.add a1).add a2) ((b0.add b1).add b2) a3 b3,
        pu_z2_add_add_add (((a0.add a1).add a2).add a3) (((b0.add b1).add b2).add b3) a4 b4]
  unfold sum5; dsimp only; exact step _ _ _ _ _ _ _ _ _ _

private theorem pu_sum5_mul_left (c : ZSqrt2) (f : Fin 5 → ZSqrt2) :
    sum5 (fun k => ZSqrt2.mul c (f k)) = ZSqrt2.mul c (sum5 f) := by
  unfold sum5; dsimp only; rw [pu_z2_mul_add, pu_z2_mul_add, pu_z2_mul_add, pu_z2_mul_add]

private theorem pu_sum5_comm (f : Fin 5 → Fin 5 → ZSqrt2) :
    sum5 (fun i => sum5 (fun j => f i j)) = sum5 (fun j => sum5 (fun i => f i j)) := by
  change sum5 (fun i => sum5 (fun j => f i j)) =
    ZSqrt2.add (ZSqrt2.add (ZSqrt2.add (ZSqrt2.add
      (sum5 (fun i => f i ⟨0, by decide⟩)) (sum5 (fun i => f i ⟨1, by decide⟩)))
      (sum5 (fun i => f i ⟨2, by decide⟩))) (sum5 (fun i => f i ⟨3, by decide⟩)))
      (sum5 (fun i => f i ⟨4, by decide⟩))
  rw [← pu_sum5_add, ← pu_sum5_add, ← pu_sum5_add, ← pu_sum5_add]; rfl

private theorem pu_mat5Mul_id_left (A : Mat5) : mat5Mul mat5Id A = A := by
  funext i j; unfold mat5Mul sum5
  match i with
  | ⟨0, _⟩ => simp [mat5Id, pu_z2_one_mul, pu_z2_zero_mul, pu_z2_add_zero]
  | ⟨1, _⟩ | ⟨2, _⟩ | ⟨3, _⟩ => simp [mat5Id, pu_z2_one_mul, pu_z2_zero_mul, pu_z2_add_zero, pu_z2_zero_add]
  | ⟨4, _⟩ => simp [mat5Id, pu_z2_one_mul, pu_z2_zero_mul, pu_z2_zero_add]

private theorem pu_mat5Mul_id_right (A : Mat5) : mat5Mul A mat5Id = A := by
  funext i j; unfold mat5Mul sum5
  match j with
  | ⟨0, _⟩ => simp [mat5Id, pu_z2_mul_one, pu_z2_mul_zero, pu_z2_add_zero]
  | ⟨1, _⟩ | ⟨2, _⟩ | ⟨3, _⟩ => simp [mat5Id, pu_z2_mul_one, pu_z2_mul_zero, pu_z2_add_zero, pu_z2_zero_add]
  | ⟨4, _⟩ => simp [mat5Id, pu_z2_mul_one, pu_z2_mul_zero, pu_z2_zero_add]

private theorem pu_mat5Mul_assoc (A B C : Mat5) : mat5Mul (mat5Mul A B) C = mat5Mul A (mat5Mul B C) := by
  funext i j; unfold mat5Mul
  have hL : sum5 (fun k => ZSqrt2.mul (sum5 (fun m => ZSqrt2.mul (A i m) (B m k))) (C k j)) =
      sum5 (fun k => sum5 (fun m => ZSqrt2.mul (A i m) (ZSqrt2.mul (B m k) (C k j)))) := by
    apply congrArg sum5; funext k
    have hr : ∀ f c, sum5 (fun m => ZSqrt2.mul (f m) c) = ZSqrt2.mul (sum5 f) c := fun f c => by
      unfold sum5; rw [pu_z2_add_mul, pu_z2_add_mul, pu_z2_add_mul, pu_z2_add_mul]
    rw [← hr]; apply congrArg sum5; funext m; exact pu_z2_mul_assoc _ _ _
  have hR : sum5 (fun m => ZSqrt2.mul (A i m) (sum5 (fun k => ZSqrt2.mul (B m k) (C k j)))) =
      sum5 (fun m => sum5 (fun k => ZSqrt2.mul (A i m) (ZSqrt2.mul (B m k) (C k j)))) := by
    apply congrArg sum5; funext m
    unfold sum5; rw [pu_z2_mul_add, pu_z2_mul_add, pu_z2_mul_add, pu_z2_mul_add]
  rw [hL, pu_sum5_comm, hR]

/-! ### Exact `5 × 5` Column-Multilinear Matrix Determinant Lemma & `F_0 = simpleRefl 4` -/

private def pu_faceRefl0Fast : Mat5
  | ⟨4, _⟩, ⟨3, _⟩ => ZSqrt2.sqrt2
  | ⟨4, _⟩, ⟨4, _⟩ => ZSqrt2.negOne
  | ⟨4, _⟩, _      => ZSqrt2.zero
  | i, j           => mat5Id i j

private theorem pu_faceRefl0_eq_fast : faceReflection ⟨0, by decide⟩ = pu_faceRefl0Fast :=
  funext (fun i => funext (fun j => (by decide : ∀ x y : Fin 5, faceReflection ⟨0, by decide⟩ x y = pu_faceRefl0Fast x y) i j))

private theorem pu_faceRefl0_mul_row4 (g : Mat5) (j : Fin 5) :
    mat5Mul (faceReflection ⟨0, by decide⟩) g ⟨4, by decide⟩ j =
      ZSqrt2.sub (ZSqrt2.mul ZSqrt2.sqrt2 (g ⟨3, by decide⟩ j)) (g ⟨4, by decide⟩ j) := by
  rw [pu_faceRefl0_eq_fast]; unfold mat5Mul sum5
  simp only [pu_faceRefl0Fast, pu_z2_zero_mul, pu_z2_zero_add]
  cases g ⟨3, by decide⟩ j; cases g ⟨4, by decide⟩ j
  simp only [ZSqrt2.sqrt2, ZSqrt2.negOne, ZSqrt2.mul, ZSqrt2.add, ZSqrt2.sub, ZSqrt2.mk.injEq]
  exact ⟨by omega, by omega⟩

private theorem pu_faceRefl0_mul_row_lt4 (g : Mat5) (i j : Fin 5) (hi : i ≠ ⟨4, by decide⟩) :
    mat5Mul (faceReflection ⟨0, by decide⟩) g i j = g i j := by
  rw [pu_faceRefl0_eq_fast]; unfold mat5Mul sum5
  match i with
  | ⟨0, _⟩ => simp [pu_faceRefl0Fast, mat5Id, pu_z2_one_mul, pu_z2_zero_mul, pu_z2_add_zero]
  | ⟨1, _⟩ | ⟨2, _⟩ | ⟨3, _⟩ => simp [pu_faceRefl0Fast, mat5Id, pu_z2_one_mul, pu_z2_zero_mul, pu_z2_add_zero, pu_z2_zero_add]
  | ⟨4, _⟩ => exact absurd rfl hi

private theorem pu_det2Z2_row1_op (s a0 a1 b0 b1 : ZSqrt2) :
    det2Z2 a0 a1 (ZSqrt2.sub (ZSqrt2.mul s a0) b0) (ZSqrt2.sub (ZSqrt2.mul s a1) b1) =
      ZSqrt2.neg (det2Z2 a0 a1 b0 b1) := by
  unfold det2Z2
  rw [pu_z2_mul_sub, pu_z2_mul_sub, ← pu_z2_mul_assoc a0 s a1, pu_z2_mul_comm a0 s, pu_z2_mul_assoc s a0 a1,
      ← pu_z2_mul_assoc a1 s a0, pu_z2_mul_comm a1 s, pu_z2_mul_assoc s a1 a0, pu_z2_mul_comm a1 a0]
  cases ZSqrt2.mul s (ZSqrt2.mul a0 a1); cases ZSqrt2.mul a0 b1; cases ZSqrt2.mul a1 b0
  simp only [ZSqrt2.sub, ZSqrt2.neg, ZSqrt2.mk.injEq]; exact ⟨by omega, by omega⟩

private theorem pu_mat5Det_faceRefl0_mul (g : Mat5) :
    mat5Det (mat5Mul (faceReflection ⟨0, by decide⟩) g) = ZSqrt2.neg (mat5Det g) := by
  unfold mat5Det; dsimp only
  have h0 : ∀ j, mat5Mul (faceReflection ⟨0, by decide⟩) g ⟨0, by decide⟩ j = g ⟨0, by decide⟩ j := fun j => pu_faceRefl0_mul_row_lt4 g _ j (by decide)
  have h1 : ∀ j, mat5Mul (faceReflection ⟨0, by decide⟩) g ⟨1, by decide⟩ j = g ⟨1, by decide⟩ j := fun j => pu_faceRefl0_mul_row_lt4 g _ j (by decide)
  have h2 : ∀ j, mat5Mul (faceReflection ⟨0, by decide⟩) g ⟨2, by decide⟩ j = g ⟨2, by decide⟩ j := fun j => pu_faceRefl0_mul_row_lt4 g _ j (by decide)
  have h3 : ∀ j, mat5Mul (faceReflection ⟨0, by decide⟩) g ⟨3, by decide⟩ j = g ⟨3, by decide⟩ j := fun j => pu_faceRefl0_mul_row_lt4 g _ j (by decide)
  have hMinor : ∀ x y z : ZSqrt2,
      ZSqrt2.add (ZSqrt2.sub (ZSqrt2.neg x) (ZSqrt2.neg y)) (ZSqrt2.neg z) =
        ZSqrt2.neg (ZSqrt2.add (ZSqrt2.sub x y) z) := fun x y z => by
    rw [← pu_z2_neg_sub, ← pu_z2_neg_add]
  simp only [pu_faceRefl0_mul_row4, h0, h1, h2, h3, pu_det2Z2_row1_op, pu_z2_mul_neg]
  simp only [hMinor, pu_z2_mul_neg]
  simp only [pu_z2_neg_add, pu_z2_neg_sub]

