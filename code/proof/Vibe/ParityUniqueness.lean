    have hDiffR : ∀ (l : Fin 12) (x : HoneycombConfig),
        isSameSignDiffRoleLine ((jConfig x).lookup g) l = isSameSignDiffRoleLine (x.lookup (classSwapMat g)) l := fun l x => by
      rw [pu_lookup_jConfig]; simp only [isSameSignDiffRoleLine, conjFullDock, revFullDock]
      rw [(line_geom_facts.1 l).1, (line_geom_facts.1 l).2.1]
      cases x.lookup (classSwapMat g) (lineA l) with
      | empty =>
        cases x.lookup (classSwapMat g) (lineB l) with
        | empty => rfl
        | occ sB _ => cases sB <;> rfl
      | occ sA rA =>
        cases x.lookup (classSwapMat g) (lineB l) with
        | empty => cases sA <;> rfl
        | occ sB rB => cases sA <;> cases sB <;> cases rA <;> cases rB <;> decide
    refine pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_
      (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_
      (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_
        pu_fockJ_id))))))))))) φ
    all_goals
      refine pu_fockJ_comp ?_ ?_
      · refine pu_fockJ_phase ?_; exact hPh _
      · refine pu_fockJ_block2 ?_ ?_
        · exact pu_swapLineRolesConfig_jConfig g _
        · exact hDiffR _
  have hJD : ∀ ψ, fockJ (fockHalfCoin ψ) = fockHalfCoin (fockJ ψ) := fun ψ => by
    funext c; refine pu_globalOp_J_of_site (fun _ => True) (fun _ => Iff.rfl) ?_ ψ c (fun _ _ => trivial)
    intro g φ c' _
    refine congrFun ?_ c'
    have hFull : ∀ (l : Fin 12) (x : HoneycombConfig),
        isFullLine ((jConfig x).lookup g) l = isFullLine (x.lookup (classSwapMat g)) l := fun l x => by
      rw [pu_lookup_jConfig]; simp only [isFullLine, conjFullDock, revFullDock]
      rw [(line_geom_facts.1 l).1, (line_geom_facts.1 l).2.1]
      cases x.lookup (classSwapMat g) (lineA l) with
      | empty =>
        cases x.lookup (classSwapMat g) (lineB l) with
        | empty => rfl
        | occ sB _ => cases sB <;> rfl
      | occ sA _ =>
        cases x.lookup (classSwapMat g) (lineB l) with
        | empty => cases sA <;> rfl
        | occ sB _ => cases sA <;> cases sB <;> rfl
    have hPh : ∀ (l : Fin 12) (x : HoneycombConfig),
        (if isFullLine ((jConfig x).lookup g) l = true then NinthLoc6.zeta6 else NinthLoc6.one) =
          (if isFullLine (x.lookup (classSwapMat g)) l = true then NinthLoc6.zeta6 else NinthLoc6.one) :=
      fun l x => by rw [hFull l x]
    have hLone : ∀ (l : Fin 12) (x : HoneycombConfig),
        isLoneLine ((jConfig x).lookup g) l = isLoneLine (x.lookup (classSwapMat g)) l := fun l x => by
      rw [pu_lookup_jConfig]; simp only [isLoneLine, conjFullDock, revFullDock]
      rw [(line_geom_facts.1 l).1, (line_geom_facts.1 l).2.1]
      cases x.lookup (classSwapMat g) (lineA l) with
      | empty => cases x.lookup (classSwapMat g) (lineB l) with | empty => rfl | occ sB _ => cases sB <;> rfl
      | occ sA _ => cases x.lookup (classSwapMat g) (lineB l) with | empty => cases sA <;> rfl | occ sB _ => cases sA <;> cases sB <;> rfl
    refine pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_
      (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_
      (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_
        pu_fockJ_id))))))))))) φ
    all_goals
      refine pu_fockJ_comp ?_ ?_
      · refine pu_fockJ_phase ?_; exact hPh _
      · refine pu_fockJ_block2 ?_ ?_
        · exact pu_swapLineSlotsConfig_jConfig g _
        · exact hLone _
  have hJPhi : ∀ ψ, UnimodularState ψ → fockJ (fockPhiOdd χ ψ) = fockPhiOdd χ (fockJ ψ) := fun ψ hψ => by
    funext c
    cases hc : isUnimodularConfig c with
    | true =>
      refine pu_globalOp_J_of_site (fun g => isUnimodularMat5 g = true) (fun g => by rw [pu_isUnimodularMat5_classSwap]) ?_ ψ c
        (fun g hg => List.all_eq_true.mp hc g hg)
      intro g φ c' hUni
      change NinthLoc6.mul (NinthLoc6.zeta6Pow (dockParity g * χ.chi ((jConfig c').lookup g))) (φ (jConfig c')) =
        NinthLoc6.mul (NinthLoc6.zeta6Pow (dockParity (classSwapMat g) * χ.chi (c'.lookup (classSwapMat g)))) (φ (jConfig c'))
      rw [pu_lookup_jConfig, hCodd, χ.chi_rev, pu_dockParity_classSwap g hUni, Int.mul_neg, Int.neg_mul]
    | false =>
      have hU1 : UnimodularState (fockPhiOdd χ ψ) := pu_globalOp_preserves_unimodular ψ hψ
      have hUJ : UnimodularState (fockJ ψ) := fun c' hc' => hψ (jConfig c') (by rw [pu_isUnimodularConfig_jConfig]; exact hc')
      have hU2 : UnimodularState (fockPhiOdd χ (fockJ ψ)) := pu_globalOp_preserves_unimodular (fockJ ψ) hUJ
      rw [show fockJ (fockPhiOdd χ ψ) c = NinthLoc6.zero from hU1 (jConfig c) (by rw [pu_isUnimodularConfig_jConfig]; exact hc),
          hU2 c hc]
  have hL1 : ∀ φ, UnimodularState φ → UnimodularState (fockPhiOdd χ φ) := fun φ h => pu_globalOp_preserves_unimodular φ h
  have hL2 : ∀ φ, UnimodularState φ → UnimodularState (fockHalfCoin φ) := fun φ h => pu_globalOp_preserves_unimodular φ h
  have hK_U : ∀ φ, UnimodularState φ → UnimodularState (fockBounceK φ) := fun φ h => pu_globalOp_preserves_unimodular φ h
  have hMP_U : ∀ φ, UnimodularState φ → UnimodularState (fockMPair φ) := fun φ h => pu_globalOp_preserves_unimodular φ h
  have hMt_U : ∀ φ, UnimodularState φ → UnimodularState (fockMeet φ) := fun φ h => pu_globalOp_preserves_unimodular φ h
  have hL3 : ∀ φ, UnimodularState φ → UnimodularState (fockScale2Core φ) := fun φ h => hMt_U _ (hMP_U _ (hK_U φ h))
  have hJS2 : ∀ φ, fockJ (fockScale2Core φ) = fockScale2Core (fockJ φ) :=
