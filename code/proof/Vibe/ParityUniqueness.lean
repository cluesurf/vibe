private theorem pu_det2Z2_scale_l (s a b c d : ZSqrt2) :
    det2Z2 (ZSqrt2.mul s a) b (ZSqrt2.mul s c) d = ZSqrt2.mul s (det2Z2 a b c d) := by
  unfold det2Z2; rw [pu_z2_mul_assoc, ← pu_z2_mul_assoc b s c, pu_z2_mul_comm b s, pu_z2_mul_assoc s b c, pu_z2_mul_sub]

private theorem pu_det3_swap01 (r0 r1 r2 b12 b02 b01 : ZSqrt2) :
    pu_det3 r1 r0 r2 b02 b12 (ZSqrt2.neg b01) = ZSqrt2.neg (pu_det3 r0 r1 r2 b12 b02 b01) := by
  unfold pu_det3; rw [pu_z2_mul_neg]
  cases ZSqrt2.mul r0 b12; cases ZSqrt2.mul r1 b02; cases ZSqrt2.mul r2 b01
  simp only [ZSqrt2.add, ZSqrt2.sub, ZSqrt2.neg, ZSqrt2.mk.injEq]; exact ⟨by omega, by omega⟩

private theorem pu_det3_swap12 (r0 r1 r2 b12 b02 b01 : ZSqrt2) :
    pu_det3 r0 r2 r1 (ZSqrt2.neg b12) b01 b02 = ZSqrt2.neg (pu_det3 r0 r1 r2 b12 b02 b01) := by
  unfold pu_det3; rw [pu_z2_mul_neg]
  cases ZSqrt2.mul r0 b12; cases ZSqrt2.mul r1 b02; cases ZSqrt2.mul r2 b01
  simp only [ZSqrt2.add, ZSqrt2.sub, ZSqrt2.neg, ZSqrt2.mk.injEq]; exact ⟨by omega, by omega⟩

private theorem pu_det3_eq01 (r r2 b : ZSqrt2) : pu_det3 r r r2 b b ZSqrt2.zero = ZSqrt2.zero := by
  unfold pu_det3; rw [pu_z2_mul_zero, pu_z2_add_zero]
  cases ZSqrt2.mul r b; simp only [ZSqrt2.sub, ZSqrt2.zero, ZSqrt2.mk.injEq]; exact ⟨by omega, by omega⟩

private theorem pu_det3_add0 (u v r1 r2 b12 b02u b02v b01u b01v : ZSqrt2) :
    pu_det3 (ZSqrt2.add u v) r1 r2 b12 (ZSqrt2.add b02u b02v) (ZSqrt2.add b01u b01v) =
      ZSqrt2.add (pu_det3 u r1 r2 b12 b02u b01u) (pu_det3 v r1 r2 b12 b02v b01v) := by
  unfold pu_det3; rw [pu_z2_add_mul, pu_z2_mul_add, pu_z2_mul_add, pu_z2_add_sub_add, pu_z2_add_add_add]

private theorem pu_det3_scale0 (s u r1 r2 b12 b02 b01 : ZSqrt2) :
    pu_det3 (ZSqrt2.mul s u) r1 r2 b12 (ZSqrt2.mul s b02) (ZSqrt2.mul s b01) =
      ZSqrt2.mul s (pu_det3 u r1 r2 b12 b02 b01) := by
  unfold pu_det3
  rw [pu_z2_mul_assoc, ← pu_z2_mul_assoc r1 s b02, pu_z2_mul_comm r1 s, pu_z2_mul_assoc s r1 b02,
      ← pu_z2_mul_assoc r2 s b01, pu_z2_mul_comm r2 s, pu_z2_mul_assoc s r2 b01, pu_z2_mul_add, pu_z2_mul_sub]

private theorem pu_det5C_add0 (u v c1 c2 c3 c4 : Vec5) :
    pu_det5C (pu_vecAdd u v) c1 c2 c3 c4 = ZSqrt2.add (pu_det5C u c1 c2 c3 c4) (pu_det5C v c1 c2 c3 c4) := by
  rw [pu_det5C_eq, pu_det5C_eq, pu_det5C_eq]; dsimp only [pu_vecAdd]
  simp only [pu_det2Z2_add_l, pu_det3_add0, pu_z2_add_mul, pu_z2_mul_add]
  exact pu_lin10_add _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _

private theorem pu_det5C_scale0 (s : ZSqrt2) (u c1 c2 c3 c4 : Vec5) :
    pu_det5C (pu_vecScale s u) c1 c2 c3 c4 = ZSqrt2.mul s (pu_det5C u c1 c2 c3 c4) := by
  have hMR : ∀ a x : ZSqrt2, ZSqrt2.mul a (ZSqrt2.mul s x) = ZSqrt2.mul s (ZSqrt2.mul a x) := fun a x => by
    rw [← pu_z2_mul_assoc, pu_z2_mul_comm a s, pu_z2_mul_assoc]
  rw [pu_det5C_eq, pu_det5C_eq]; dsimp only [pu_vecScale]
  simp only [pu_det2Z2_scale_l, pu_det3_scale0, pu_z2_mul_assoc]
  rw [hMR, hMR, hMR, hMR, hMR, hMR]
  exact pu_lin10_scale s _ _ _ _ _ _ _ _ _ _

private theorem pu_det5C_eq01 (c c2 c3 c4 : Vec5) : pu_det5C c c c2 c3 c4 = ZSqrt2.zero := by
  rw [pu_det5C_eq]; dsimp only
  rw [pu_det2Z2_eq (c ⟨0, by decide⟩) (c ⟨1, by decide⟩), pu_det2Z2_eq (c ⟨3, by decide⟩) (c ⟨4, by decide⟩),
      pu_z2_zero_mul, pu_det3_eq01, pu_det3_eq01, pu_det3_eq01, pu_z2_mul_zero, pu_z2_mul_zero, pu_z2_mul_zero]
  exact pu_lin10_eq01 _ _ _

private theorem pu_det5C_swap01 (c0 c1 c2 c3 c4 : Vec5) :
    pu_det5C c1 c0 c2 c3 c4 = ZSqrt2.neg (pu_det5C c0 c1 c2 c3 c4) := by
  rw [pu_det5C_eq, pu_det5C_eq]; dsimp only
  have ha := pu_det2Z2_swap (c0 ⟨0, by decide⟩) (c1 ⟨0, by decide⟩) (c0 ⟨1, by decide⟩) (c1 ⟨1, by decide⟩)
  have hb := pu_det2Z2_swap (c0 ⟨3, by decide⟩) (c1 ⟨3, by decide⟩) (c0 ⟨4, by decide⟩) (c1 ⟨4, by decide⟩)
  rw [ha, hb,
      pu_det3_swap01 (c0 ⟨2, by decide⟩) (c1 ⟨2, by decide⟩) (c4 ⟨2, by decide⟩),
      pu_det3_swap01 (c0 ⟨2, by decide⟩) (c1 ⟨2, by decide⟩) (c3 ⟨2, by decide⟩),
      pu_det3_swap01 (c0 ⟨2, by decide⟩) (c1 ⟨2, by decide⟩) (c2 ⟨2, by decide⟩),
      pu_z2_neg_mul, pu_z2_mul_neg, pu_z2_mul_neg, pu_z2_mul_neg]
  exact pu_lin10_swap01 _ _ _ _ _ _ _ _ _ _

private theorem pu_det5C_swap12 (c0 c1 c2 c3 c4 : Vec5) :
    pu_det5C c0 c2 c1 c3 c4 = ZSqrt2.neg (pu_det5C c0 c1 c2 c3 c4) := by
  rw [pu_det5C_eq, pu_det5C_eq]; dsimp only
  have ha := pu_det2Z2_swap (c1 ⟨0, by decide⟩) (c2 ⟨0, by decide⟩) (c1 ⟨1, by decide⟩) (c2 ⟨1, by decide⟩)
  have hb := pu_det2Z2_swap (c1 ⟨3, by decide⟩) (c2 ⟨3, by decide⟩) (c1 ⟨4, by decide⟩) (c2 ⟨4, by decide⟩)
  rw [ha, hb,
      pu_det3_swap01 (c1 ⟨2, by decide⟩) (c2 ⟨2, by decide⟩) (c4 ⟨2, by decide⟩),
      pu_det3_swap01 (c1 ⟨2, by decide⟩) (c2 ⟨2, by decide⟩) (c3 ⟨2, by decide⟩),
      pu_det3_swap12 (c0 ⟨2, by decide⟩) (c1 ⟨2, by decide⟩) (c2 ⟨2, by decide⟩),
      pu_z2_neg_mul, pu_z2_mul_neg, pu_z2_mul_neg, pu_z2_mul_neg]
  exact pu_lin10_swap12 _ _ _ _ _ _ _ _ _ _

private theorem pu_det5C_swap23 (c0 c1 c2 c3 c4 : Vec5) :
    pu_det5C c0 c1 c3 c2 c4 = ZSqrt2.neg (pu_det5C c0 c1 c2 c3 c4) := by
  rw [pu_det5C_eq, pu_det5C_eq]; dsimp only
  have ha := pu_det2Z2_swap (c2 ⟨0, by decide⟩) (c3 ⟨0, by decide⟩) (c2 ⟨1, by decide⟩) (c3 ⟨1, by decide⟩)
  have hb := pu_det2Z2_swap (c2 ⟨3, by decide⟩) (c3 ⟨3, by decide⟩) (c2 ⟨4, by decide⟩) (c3 ⟨4, by decide⟩)
  rw [ha, hb,
      pu_det3_swap01 (c2 ⟨2, by decide⟩) (c3 ⟨2, by decide⟩) (c4 ⟨2, by decide⟩),
      pu_det3_swap12 (c1 ⟨2, by decide⟩) (c2 ⟨2, by decide⟩) (c3 ⟨2, by decide⟩),
      pu_det3_swap12 (c0 ⟨2, by decide⟩) (c2 ⟨2, by decide⟩) (c3 ⟨2, by decide⟩),
      pu_z2_neg_mul, pu_z2_mul_neg, pu_z2_mul_neg, pu_z2_mul_neg]
  exact pu_lin10_swap23 _ _ _ _ _ _ _ _ _ _

private theorem pu_det5C_swap34 (c0 c1 c2 c3 c4 : Vec5) :
    pu_det5C c0 c1 c2 c4 c3 = ZSqrt2.neg (pu_det5C c0 c1 c2 c3 c4) := by
  rw [pu_det5C_eq, pu_det5C_eq]; dsimp only
  have ha := pu_det2Z2_swap (c3 ⟨0, by decide⟩) (c4 ⟨0, by decide⟩) (c3 ⟨1, by decide⟩) (c4 ⟨1, by decide⟩)
  have hb := pu_det2Z2_swap (c3 ⟨3, by decide⟩) (c4 ⟨3, by decide⟩) (c3 ⟨4, by decide⟩) (c4 ⟨4, by decide⟩)
  rw [ha, hb,
      pu_det3_swap12 (c2 ⟨2, by decide⟩) (c3 ⟨2, by decide⟩) (c4 ⟨2, by decide⟩),
      pu_det3_swap12 (c1 ⟨2, by decide⟩) (c3 ⟨2, by decide⟩) (c4 ⟨2, by decide⟩),
      pu_det3_swap12 (c0 ⟨2, by decide⟩) (c3 ⟨2, by decide⟩) (c4 ⟨2, by decide⟩),
      pu_z2_neg_mul, pu_z2_mul_neg, pu_z2_mul_neg, pu_z2_mul_neg]
  exact pu_lin10_swap34 _ _ _ _ _ _ _ _ _ _

private theorem pu_det5C_add1 (c0 u v c2 c3 c4 : Vec5) :
    pu_det5C c0 (pu_vecAdd u v) c2 c3 c4 = ZSqrt2.add (pu_det5C c0 u c2 c3 c4) (pu_det5C c0 v c2 c3 c4) := by
  rw [← pu_z2_neg_neg (pu_det5C c0 (pu_vecAdd u v) c2 c3 c4), ← pu_det5C_swap01, pu_det5C_add0,
      pu_z2_neg_add, pu_det5C_swap01 u c0, pu_det5C_swap01 v c0]

private theorem pu_det5C_add2 (c0 c1 u v c3 c4 : Vec5) :
    pu_det5C c0 c1 (pu_vecAdd u v) c3 c4 = ZSqrt2.add (pu_det5C c0 c1 u c3 c4) (pu_det5C c0 c1 v c3 c4) := by
  rw [← pu_z2_neg_neg (pu_det5C c0 c1 (pu_vecAdd u v) c3 c4), ← pu_det5C_swap12, pu_det5C_add1,
      pu_z2_neg_add, pu_det5C_swap12 c0 u c1, pu_det5C_swap12 c0 v c1]

private theorem pu_det5C_add3 (c0 c1 c2 u v c4 : Vec5) :
    pu_det5C c0 c1 c2 (pu_vecAdd u v) c4 = ZSqrt2.add (pu_det5C c0 c1 c2 u c4) (pu_det5C c0 c1 c2 v c4) := by
  rw [← pu_z2_neg_neg (pu_det5C c0 c1 c2 (pu_vecAdd u v) c4), ← pu_det5C_swap23, pu_det5C_add2,
      pu_z2_neg_add, pu_det5C_swap23 c0 c1 u c2, pu_det5C_swap23 c0 c1 v c2]

private theorem pu_det5C_add4 (c0 c1 c2 c3 u v : Vec5) :
    pu_det5C c0 c1 c2 c3 (pu_vecAdd u v) = ZSqrt2.add (pu_det5C c0 c1 c2 c3 u) (pu_det5C c0 c1 c2 c3 v) := by
  rw [← pu_z2_neg_neg (pu_det5C c0 c1 c2 c3 (pu_vecAdd u v)), ← pu_det5C_swap34, pu_det5C_add3,
      pu_z2_neg_add, pu_det5C_swap34 c0 c1 c2 u c3, pu_det5C_swap34 c0 c1 c2 v c3]

private theorem pu_det5C_scale1 (s : ZSqrt2) (c0 u c2 c3 c4 : Vec5) :
    pu_det5C c0 (pu_vecScale s u) c2 c3 c4 = ZSqrt2.mul s (pu_det5C c0 u c2 c3 c4) := by
  rw [← pu_z2_neg_neg (pu_det5C c0 (pu_vecScale s u) c2 c3 c4), ← pu_det5C_swap01, pu_det5C_scale0,
      pu_det5C_swap01, pu_z2_mul_neg, pu_z2_neg_neg]

private theorem pu_det5C_scale2 (s : ZSqrt2) (c0 c1 u c3 c4 : Vec5) :
    pu_det5C c0 c1 (pu_vecScale s u) c3 c4 = ZSqrt2.mul s (pu_det5C c0 c1 u c3 c4) := by
  rw [← pu_z2_neg_neg (pu_det5C c0 c1 (pu_vecScale s u) c3 c4), ← pu_det5C_swap12, pu_det5C_scale1,
      pu_det5C_swap12, pu_z2_mul_neg, pu_z2_neg_neg]

private theorem pu_det5C_scale3 (s : ZSqrt2) (c0 c1 c2 u c4 : Vec5) :
    pu_det5C c0 c1 c2 (pu_vecScale s u) c4 = ZSqrt2.mul s (pu_det5C c0 c1 c2 u c4) := by
  rw [← pu_z2_neg_neg (pu_det5C c0 c1 c2 (pu_vecScale s u) c4), ← pu_det5C_swap23, pu_det5C_scale2,
      pu_det5C_swap23, pu_z2_mul_neg, pu_z2_neg_neg]

private theorem pu_det5C_scale4 (s : ZSqrt2) (c0 c1 c2 c3 u : Vec5) :
    pu_det5C c0 c1 c2 c3 (pu_vecScale s u) = ZSqrt2.mul s (pu_det5C c0 c1 c2 c3 u) := by
  rw [← pu_z2_neg_neg (pu_det5C c0 c1 c2 c3 (pu_vecScale s u)), ← pu_det5C_swap34, pu_det5C_scale3,
      pu_det5C_swap34, pu_z2_mul_neg, pu_z2_neg_neg]

private theorem pu_det5C_eq02 (c c1 c3 c4 : Vec5) : pu_det5C c c1 c c3 c4 = ZSqrt2.zero := by
  rw [← pu_z2_neg_neg (pu_det5C c c1 c c3 c4), ← pu_det5C_swap12, pu_det5C_eq01]; rfl
private theorem pu_det5C_eq03 (c c1 c2 c4 : Vec5) : pu_det5C c c1 c2 c c4 = ZSqrt2.zero := by
  rw [← pu_z2_neg_neg (pu_det5C c c1 c2 c c4), ← pu_det5C_swap23, pu_det5C_eq02]; rfl
private theorem pu_det5C_eq04 (c c1 c2 c3 : Vec5) : pu_det5C c c1 c2 c3 c = ZSqrt2.zero := by
  rw [← pu_z2_neg_neg (pu_det5C c c1 c2 c3 c), ← pu_det5C_swap34, pu_det5C_eq03]; rfl
private theorem pu_det5C_eq12 (c0 c c3 c4 : Vec5) : pu_det5C c0 c c c3 c4 = ZSqrt2.zero := by
  rw [← pu_z2_neg_neg (pu_det5C c0 c c c3 c4), ← pu_det5C_swap01, pu_det5C_eq02]; rfl
private theorem pu_det5C_eq13 (c0 c c2 c4 : Vec5) : pu_det5C c0 c c2 c c4 = ZSqrt2.zero := by
  rw [← pu_z2_neg_neg (pu_det5C c0 c c2 c c4), ← pu_det5C_swap23, pu_det5C_eq12]; rfl
private theorem pu_det5C_eq14 (c0 c c2 c3 : Vec5) : pu_det5C c0 c c2 c3 c = ZSqrt2.zero := by
  rw [← pu_z2_neg_neg (pu_det5C c0 c c2 c3 c), ← pu_det5C_swap34, pu_det5C_eq13]; rfl
private theorem pu_det5C_eq23 (c0 c1 c c4 : Vec5) : pu_det5C c0 c1 c c c4 = ZSqrt2.zero := by
  rw [← pu_z2_neg_neg (pu_det5C c0 c1 c c c4), ← pu_det5C_swap12, pu_det5C_eq13]; rfl
private theorem pu_det5C_eq24 (c0 c1 c c3 : Vec5) : pu_det5C c0 c1 c c3 c = ZSqrt2.zero := by
  rw [← pu_z2_neg_neg (pu_det5C c0 c1 c c3 c), ← pu_det5C_swap34, pu_det5C_eq23]; rfl
private theorem pu_det5C_eq34 (c0 c1 c2 c : Vec5) : pu_det5C c0 c1 c2 c c = ZSqrt2.zero := by
  rw [← pu_z2_neg_neg (pu_det5C c0 c1 c2 c c), ← pu_det5C_swap23, pu_det5C_eq24]; rfl

private theorem pu_det5C_rank1 (c0 c1 c2 c3 c4 w : Vec5) (s0 s1 s2 s3 s4 : ZSqrt2) :
    pu_det5C (pu_vecAdd c0 (pu_vecScale s0 w)) (pu_vecAdd c1 (pu_vecScale s1 w))
      (pu_vecAdd c2 (pu_vecScale s2 w)) (pu_vecAdd c3 (pu_vecScale s3 w)) (pu_vecAdd c4 (pu_vecScale s4 w)) =
    ZSqrt2.add (pu_det5C c0 c1 c2 c3 c4)
      (ZSqrt2.add (ZSqrt2.add (ZSqrt2.add (ZSqrt2.add
        (ZSqrt2.mul s0 (pu_det5C w c1 c2 c3 c4))
        (ZSqrt2.mul s1 (pu_det5C c0 w c2 c3 c4)))
        (ZSqrt2.mul s2 (pu_det5C c0 c1 w c3 c4)))
        (ZSqrt2.mul s3 (pu_det5C c0 c1 c2 w c4)))
        (ZSqrt2.mul s4 (pu_det5C c0 c1 c2 c3 w))) := by
  have hW0 : pu_det5C w (pu_vecAdd c1 (pu_vecScale s1 w)) (pu_vecAdd c2 (pu_vecScale s2 w))
      (pu_vecAdd c3 (pu_vecScale s3 w)) (pu_vecAdd c4 (pu_vecScale s4 w)) = pu_det5C w c1 c2 c3 c4 := by
    rw [pu_det5C_add1, pu_det5C_scale1, pu_det5C_eq01, pu_z2_mul_zero, pu_z2_add_zero,
        pu_det5C_add2, pu_det5C_scale2, pu_det5C_eq02, pu_z2_mul_zero, pu_z2_add_zero,
        pu_det5C_add3, pu_det5C_scale3, pu_det5C_eq03, pu_z2_mul_zero, pu_z2_add_zero,
        pu_det5C_add4, pu_det5C_scale4, pu_det5C_eq04, pu_z2_mul_zero, pu_z2_add_zero]
  have hW1 : pu_det5C c0 w (pu_vecAdd c2 (pu_vecScale s2 w)) (pu_vecAdd c3 (pu_vecScale s3 w))
      (pu_vecAdd c4 (pu_vecScale s4 w)) = pu_det5C c0 w c2 c3 c4 := by
    rw [pu_det5C_add2, pu_det5C_scale2, pu_det5C_eq12, pu_z2_mul_zero, pu_z2_add_zero,
        pu_det5C_add3, pu_det5C_scale3, pu_det5C_eq13, pu_z2_mul_zero, pu_z2_add_zero,
        pu_det5C_add4, pu_det5C_scale4, pu_det5C_eq14, pu_z2_mul_zero, pu_z2_add_zero]
  have hW2 : pu_det5C c0 c1 w (pu_vecAdd c3 (pu_vecScale s3 w)) (pu_vecAdd c4 (pu_vecScale s4 w)) =
      pu_det5C c0 c1 w c3 c4 := by
    rw [pu_det5C_add3, pu_det5C_scale3, pu_det5C_eq23, pu_z2_mul_zero, pu_z2_add_zero,
        pu_det5C_add4, pu_det5C_scale4, pu_det5C_eq24, pu_z2_mul_zero, pu_z2_add_zero]
  have hW3 : pu_det5C c0 c1 c2 w (pu_vecAdd c4 (pu_vecScale s4 w)) = pu_det5C c0 c1 c2 w c4 := by
    rw [pu_det5C_add4, pu_det5C_scale4, pu_det5C_eq34, pu_z2_mul_zero, pu_z2_add_zero]
  rw [pu_det5C_add0, pu_det5C_scale0, hW0,
      pu_det5C_add1, pu_det5C_scale1, hW1,
      pu_det5C_add2, pu_det5C_scale2, hW2,
      pu_det5C_add3, pu_det5C_scale3, hW3,
      pu_det5C_add4, pu_det5C_scale4]
  cases pu_det5C c0 c1 c2 c3 c4
  cases ZSqrt2.mul s0 (pu_det5C w c1 c2 c3 c4)
  cases ZSqrt2.mul s1 (pu_det5C c0 w c2 c3 c4)
  cases ZSqrt2.mul s2 (pu_det5C c0 c1 w c3 c4)
  cases ZSqrt2.mul s3 (pu_det5C c0 c1 c2 w c4)
  cases ZSqrt2.mul s4 (pu_det5C c0 c1 c2 c3 w)
  simp only [ZSqrt2.add, ZSqrt2.mk.injEq]; exact ⟨by omega, by omega⟩

private theorem pu_mat5Det_mul_rank1 (M : Mat5) (u v : Vec5) :
    mat5Det (mat5Mul M (fun i j => ZSqrt2.sub (mat5Id i j) (ZSqrt2.mul (u i) (v j)))) =
      ZSqrt2.mul (ZSqrt2.sub ZSqrt2.one (dot5 u v)) (mat5Det M) := by
  let c : Fin 5 → Vec5 := fun j i => M i j
  let w : Vec5 := mat5Vec M u
  have hM : M = pu_mkCols (c ⟨0, by decide⟩) (c ⟨1, by decide⟩) (c ⟨2, by decide⟩) (c ⟨3, by decide⟩) (c ⟨4, by decide⟩) := by
    funext i j; match j with | ⟨0, _⟩ | ⟨1, _⟩ | ⟨2, _⟩ | ⟨3, _⟩ | ⟨4, _⟩ => rfl
  have hCol : ∀ (j : Fin 5) (i : Fin 5),
      mat5Mul M (fun a b => ZSqrt2.sub (mat5Id a b) (ZSqrt2.mul (u a) (v b))) i j =
        pu_vecAdd (c j) (pu_vecScale (ZSqrt2.neg (v j)) w) i := fun j i => by
    unfold mat5Mul pu_vecAdd pu_vecScale
    dsimp only [c, w]
    have hTerm : (fun k => ZSqrt2.mul (M i k) (ZSqrt2.sub (mat5Id k j) (ZSqrt2.mul (u k) (v j)))) =
        (fun k => ZSqrt2.add (ZSqrt2.mul (M i k) (mat5Id k j)) (ZSqrt2.mul (ZSqrt2.neg (v j)) (ZSqrt2.mul (M i k) (u k)))) := by
      funext k
      rw [pu_z2_mul_sub, pu_z2_neg_mul, ← pu_z2_mul_assoc (v j) (M i k) (u k),
          pu_z2_mul_comm (v j) (M i k), pu_z2_mul_assoc (M i k) (v j) (u k), pu_z2_mul_comm (v j) (u k)]
      cases ZSqrt2.mul (M i k) (mat5Id k j); cases ZSqrt2.mul (M i k) (ZSqrt2.mul (u k) (v j))
      simp only [ZSqrt2.add, ZSqrt2.sub, ZSqrt2.neg, ZSqrt2.mk.injEq]; exact ⟨by omega, by omega⟩
    rw [hTerm, pu_sum5_add, pu_sum5_mul_left]
    have hId : sum5 (fun k => ZSqrt2.mul (M i k) (mat5Id k j)) = M i j := congrFun (congrFun (pu_mat5Mul_id_right M) i) j
    rw [hId]; rfl
  have hMat : mat5Mul M (fun a b => ZSqrt2.sub (mat5Id a b) (ZSqrt2.mul (u a) (v b))) =
      pu_mkCols
        (pu_vecAdd (c ⟨0, by decide⟩) (pu_vecScale (ZSqrt2.neg (v ⟨0, by decide⟩)) w))
        (pu_vecAdd (c ⟨1, by decide⟩) (pu_vecScale (ZSqrt2.neg (v ⟨1, by decide⟩)) w))
        (pu_vecAdd (c ⟨2, by decide⟩) (pu_vecScale (ZSqrt2.neg (v ⟨2, by decide⟩)) w))
        (pu_vecAdd (c ⟨3, by decide⟩) (pu_vecScale (ZSqrt2.neg (v ⟨3, by decide⟩)) w))
        (pu_vecAdd (c ⟨4, by decide⟩) (pu_vecScale (ZSqrt2.neg (v ⟨4, by decide⟩)) w)) := by
    funext i j; rw [hCol j i]; match j with | ⟨0, _⟩ | ⟨1, _⟩ | ⟨2, _⟩ | ⟨3, _⟩ | ⟨4, _⟩ => rfl
  have hW : w = pu_vecAdd (pu_vecAdd (pu_vecAdd (pu_vecAdd
      (pu_vecScale (u ⟨0, by decide⟩) (c ⟨0, by decide⟩))
      (pu_vecScale (u ⟨1, by decide⟩) (c ⟨1, by decide⟩)))
      (pu_vecScale (u ⟨2, by decide⟩) (c ⟨2, by decide⟩)))
      (pu_vecScale (u ⟨3, by decide⟩) (c ⟨3, by decide⟩)))
      (pu_vecScale (u ⟨4, by decide⟩) (c ⟨4, by decide⟩)) := by
    funext i; unfold pu_vecAdd pu_vecScale; dsimp only [w, c, mat5Vec, sum5]
    rw [pu_z2_mul_comm (u ⟨0, by decide⟩), pu_z2_mul_comm (u ⟨1, by decide⟩),
        pu_z2_mul_comm (u ⟨2, by decide⟩), pu_z2_mul_comm (u ⟨3, by decide⟩),
        pu_z2_mul_comm (u ⟨4, by decide⟩)]
  have hD0 : pu_det5C w (c ⟨1, by decide⟩) (c ⟨2, by decide⟩) (c ⟨3, by decide⟩) (c ⟨4, by decide⟩) =
      ZSqrt2.mul (u ⟨0, by decide⟩) (mat5Det M) := by
    rw [hW, pu_det5C_add0, pu_det5C_add0, pu_det5C_add0, pu_det5C_add0,
        pu_det5C_scale0, pu_det5C_scale0, pu_det5C_scale0, pu_det5C_scale0, pu_det5C_scale0,
        pu_det5C_eq01, pu_det5C_eq02, pu_det5C_eq03, pu_det5C_eq04,
        pu_z2_mul_zero, pu_z2_mul_zero, pu_z2_mul_zero, pu_z2_mul_zero,
        pu_z2_add_zero, pu_z2_add_zero, pu_z2_add_zero, pu_z2_add_zero]
    unfold pu_det5C; rw [← hM]
  have hD1 : pu_det5C (c ⟨0, by decide⟩) w (c ⟨2, by decide⟩) (c ⟨3, by decide⟩) (c ⟨4, by decide⟩) =
      ZSqrt2.mul (u ⟨1, by decide⟩) (mat5Det M) := by
    rw [hW, pu_det5C_add1, pu_det5C_add1, pu_det5C_add1, pu_det5C_add1,
        pu_det5C_scale1, pu_det5C_scale1, pu_det5C_scale1, pu_det5C_scale1, pu_det5C_scale1,
        pu_det5C_eq01, pu_det5C_eq12, pu_det5C_eq13, pu_det5C_eq14,
        pu_z2_mul_zero, pu_z2_mul_zero, pu_z2_mul_zero, pu_z2_mul_zero,
        pu_z2_zero_add, pu_z2_add_zero, pu_z2_add_zero, pu_z2_add_zero]
    unfold pu_det5C; rw [← hM]
  have hD2 : pu_det5C (c ⟨0, by decide⟩) (c ⟨1, by decide⟩) w (c ⟨3, by decide⟩) (c ⟨4, by decide⟩) =
      ZSqrt2.mul (u ⟨2, by decide⟩) (mat5Det M) := by
    rw [hW, pu_det5C_add2, pu_det5C_add2, pu_det5C_add2, pu_det5C_add2,
        pu_det5C_scale2, pu_det5C_scale2, pu_det5C_scale2, pu_det5C_scale2, pu_det5C_scale2,
        pu_det5C_eq02, pu_det5C_eq12, pu_det5C_eq23, pu_det5C_eq24,
        pu_z2_mul_zero, pu_z2_mul_zero, pu_z2_mul_zero, pu_z2_mul_zero,
        pu_z2_zero_add, pu_z2_zero_add, pu_z2_add_zero, pu_z2_add_zero]
    unfold pu_det5C; rw [← hM]
  have hD3 : pu_det5C (c ⟨0, by decide⟩) (c ⟨1, by decide⟩) (c ⟨2, by decide⟩) w (c ⟨4, by decide⟩) =
      ZSqrt2.mul (u ⟨3, by decide⟩) (mat5Det M) := by
    rw [hW, pu_det5C_add3, pu_det5C_add3, pu_det5C_add3, pu_det5C_add3,
        pu_det5C_scale3, pu_det5C_scale3, pu_det5C_scale3, pu_det5C_scale3, pu_det5C_scale3,
        pu_det5C_eq03, pu_det5C_eq13, pu_det5C_eq23, pu_det5C_eq34,
        pu_z2_mul_zero, pu_z2_mul_zero, pu_z2_mul_zero, pu_z2_mul_zero,
        pu_z2_zero_add, pu_z2_zero_add, pu_z2_zero_add, pu_z2_add_zero]
    unfold pu_det5C; rw [← hM]
  have hD4 : pu_det5C (c ⟨0, by decide⟩) (c ⟨1, by decide⟩) (c ⟨2, by decide⟩) (c ⟨3, by decide⟩) w =
      ZSqrt2.mul (u ⟨4, by decide⟩) (mat5Det M) := by
    rw [hW, pu_det5C_add4, pu_det5C_add4, pu_det5C_add4, pu_det5C_add4,
        pu_det5C_scale4, pu_det5C_scale4, pu_det5C_scale4, pu_det5C_scale4, pu_det5C_scale4,
