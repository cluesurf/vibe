        ZSqrt2.neg (ZSqrt2.mul (ZSqrt2.mul (u k) (v k)) (mat5Det M)) := fun k => by
    rw [pu_z2_neg_mul, ← pu_z2_mul_assoc, pu_z2_mul_comm (v k) (u k)]
  rw [hMat]
  change pu_det5C _ _ _ _ _ = _
  rw [pu_det5C_rank1, hD0, hD1, hD2, hD3, hD4]
  have hBase : pu_det5C (c ⟨0, by decide⟩) (c ⟨1, by decide⟩) (c ⟨2, by decide⟩) (c ⟨3, by decide⟩) (c ⟨4, by decide⟩) = mat5Det M := by
    unfold pu_det5C; rw [← hM]
  rw [hBase]
  unfold dot5 sum5; dsimp only
  rw [pu_z2_sub_mul, pu_z2_one_mul, pu_z2_add_mul, pu_z2_add_mul, pu_z2_add_mul, pu_z2_add_mul,
      hUV ⟨0, by decide⟩, hUV ⟨1, by decide⟩, hUV ⟨2, by decide⟩, hUV ⟨3, by decide⟩, hUV ⟨4, by decide⟩]
  have hSum6 : ∀ d x0 x1 x2 x3 x4 : ZSqrt2,
      ZSqrt2.add d (ZSqrt2.add (ZSqrt2.add (ZSqrt2.add (ZSqrt2.add (ZSqrt2.neg x0) (ZSqrt2.neg x1)) (ZSqrt2.neg x2)) (ZSqrt2.neg x3)) (ZSqrt2.neg x4)) =
        ZSqrt2.sub d (ZSqrt2.add (ZSqrt2.add (ZSqrt2.add (ZSqrt2.add x0 x1) x2) x3) x4) := by
    intro d x0 x1 x2 x3 x4; cases d; cases x0; cases x1; cases x2; cases x3; cases x4
    simp only [ZSqrt2.add, ZSqrt2.sub, ZSqrt2.neg, ZSqrt2.mk.injEq]; exact ⟨by omega, by omega⟩
  exact hSum6 _ _ _ _ _ _

private theorem pu_mat5Det_negMat (M : Mat5) : mat5Det (fun i j => ZSqrt2.neg (M i j)) = ZSqrt2.neg (mat5Det M) := by
  let c : Fin 5 → Vec5 := fun j i => M i j
  have hM : M = pu_mkCols (c ⟨0, by decide⟩) (c ⟨1, by decide⟩) (c ⟨2, by decide⟩) (c ⟨3, by decide⟩) (c ⟨4, by decide⟩) := by
    funext i j; match j with | ⟨0, _⟩ | ⟨1, _⟩ | ⟨2, _⟩ | ⟨3, _⟩ | ⟨4, _⟩ => rfl
  have hN : (fun i j => ZSqrt2.neg (M i j)) =
      pu_mkCols (pu_vecScale ZSqrt2.negOne (c ⟨0, by decide⟩)) (pu_vecScale ZSqrt2.negOne (c ⟨1, by decide⟩))
        (pu_vecScale ZSqrt2.negOne (c ⟨2, by decide⟩)) (pu_vecScale ZSqrt2.negOne (c ⟨3, by decide⟩))
        (pu_vecScale ZSqrt2.negOne (c ⟨4, by decide⟩)) := by
    funext i j; match j with | ⟨0, _⟩ | ⟨1, _⟩ | ⟨2, _⟩ | ⟨3, _⟩ | ⟨4, _⟩ => exact (pu_z2_negOne_mul _).symm
  rw [hN]
  change pu_det5C _ _ _ _ _ = _
  rw [pu_det5C_scale0, pu_det5C_scale1, pu_det5C_scale2, pu_det5C_scale3, pu_det5C_scale4]
  simp only [pu_z2_negOne_mul, pu_z2_neg_neg]
  unfold pu_det5C; rw [← hM]

private theorem pu_mat5Det_mul_faceReflection (g : Mat5) (a : Fin 24) :
    mat5Det (mat5Mul g (faceReflection a)) = ZSqrt2.neg (mat5Det g) := by
  have h := pu_mat5Det_mul_rank1 g (facetNormal a) (mat5Vec twiceGram (facetNormal a))
  have hDot : dot5 (facetNormal a) (mat5Vec twiceGram (facetNormal a)) = ZSqrt2.two := thm_24_facets_geometry.2.2.1 a
  have hNeg1 : ZSqrt2.sub ZSqrt2.one ZSqrt2.two = ZSqrt2.negOne := by decide
  rw [hDot, hNeg1, pu_z2_negOne_mul] at h
  exact h

private theorem pu_mat5Det_mul_centralInversion (g : Mat5) :
    mat5Det (mat5Mul g centralInversion) = mat5Det g := by
  let uZ : Vec5 := fun i => ZSqrt2.scale 2 (baseCenter i)
  let vZ : Vec5 := unitVec5 ⟨4, by decide⟩
  let rZ : Mat5 := fun i j => ZSqrt2.sub (mat5Id i j) (ZSqrt2.mul (uZ i) (vZ j))
  have hZ : centralInversion = fun i j => ZSqrt2.neg (rZ i j) :=
    funext (fun i => funext (fun j => (by decide : ∀ x y : Fin 5, centralInversion x y = ZSqrt2.neg (rZ x y)) i j))
  have hMulNeg : mat5Mul g centralInversion = fun i j => ZSqrt2.neg (mat5Mul g rZ i j) := by
    rw [hZ]; funext i j; unfold mat5Mul sum5; simp only [pu_z2_mul_neg, pu_z2_neg_add]
  rw [hMulNeg, pu_mat5Det_negMat]
  have hR := pu_mat5Det_mul_rank1 g uZ vZ
  have hDot : dot5 uZ vZ = ZSqrt2.two := by decide
  have hNeg1 : ZSqrt2.sub ZSqrt2.one ZSqrt2.two = ZSqrt2.negOne := by decide
  rw [hDot, hNeg1, pu_z2_negOne_mul] at hR
  change ZSqrt2.neg (mat5Det (mat5Mul g (fun i j => ZSqrt2.sub (mat5Id i j) (ZSqrt2.mul (uZ i) (vZ j))))) = _
  rw [hR, pu_z2_neg_neg]

private theorem pu_mat5Det_mul_transport (g : Mat5) (a : Fin 24) :
    mat5Det (mat5Mul g (transport a)) = ZSqrt2.neg (mat5Det g) := by
  unfold transport; rw [← pu_mat5Mul_assoc, pu_mat5Det_mul_centralInversion, pu_mat5Det_mul_faceReflection]

/-- Connected-honeycomb bipartite parity-class swap `L(g) = F_0 * g * Z = k_0 * (Z g Z)` on `{3,4,3,4}` cell frames
    (`L(I_5) = k_0`, mapping the base 24-cell to its neighbor across facet `0` inside connected `Γ = ⟨transport a⟩`). -/
def classSwapMat (g : Mat5) : Mat5 :=
  mat5Mul (mat5Mul (faceReflection ⟨0, by decide⟩) g) centralInversion

/-- Decidable unimodularity test `det(g) ∈ {+1, -1}` (satisfied by every `{3,4,3,4}` Coxeter frame). -/
def isUnimodularMat5 (g : Mat5) : Bool :=
  decide (mat5Det g = ZSqrt2.one ∨ mat5Det g = ZSqrt2.negOne)

private theorem pu_Z_transport_Z (a : Fin 24) :
    mat5Mul (mat5Mul centralInversion (transport a)) centralInversion = transport (oppSlot a) := by
  unfold transport
  rw [← thm_coxeter_transport_antipodal_inverse.1 a,
      pu_mat5Mul_assoc centralInversion (mat5Mul (faceReflection a) centralInversion) centralInversion,
      pu_mat5Mul_assoc (faceReflection a) centralInversion centralInversion,
      thm_central_inversion_properties.1, pu_mat5Mul_id_right,
      pu_mat5Mul_assoc (mat5Mul centralInversion (faceReflection a)) centralInversion centralInversion,
      thm_central_inversion_properties.1, pu_mat5Mul_id_right]

private theorem pu_classSwapMat_id : classSwapMat mat5Id = transport ⟨0, by decide⟩ := by
  unfold classSwapMat transport; rw [pu_mat5Mul_id_right]

private theorem pu_classSwapMat_inv (g : Mat5) : classSwapMat (classSwapMat g) = g := by
  unfold classSwapMat
  have hF02 : mat5Mul (faceReflection ⟨0, by decide⟩) (faceReflection ⟨0, by decide⟩) = mat5Id :=
    thm_reflection_involution (facetNormal ⟨0, by decide⟩) (thm_24_facets_geometry.2.2.1 ⟨0, by decide⟩)
  rw [← pu_mat5Mul_assoc (faceReflection ⟨0, by decide⟩) (mat5Mul (faceReflection ⟨0, by decide⟩) g) centralInversion,
      ← pu_mat5Mul_assoc (faceReflection ⟨0, by decide⟩) (faceReflection ⟨0, by decide⟩) g,
      hF02, pu_mat5Mul_id_left, pu_mat5Mul_assoc g centralInversion centralInversion,
      thm_central_inversion_properties.1, pu_mat5Mul_id_right]

private theorem pu_classSwapMat_mul_transport (g : Mat5) (a : Fin 24) :
    classSwapMat (mat5Mul g (transport a)) = mat5Mul (classSwapMat g) (transport (oppSlot a)) := by
  unfold classSwapMat
  rw [← pu_Z_transport_Z a,
      pu_mat5Mul_assoc (mat5Mul (faceReflection ⟨0, by decide⟩) g) centralInversion _,
      ← pu_mat5Mul_assoc centralInversion (mat5Mul centralInversion (transport a)) centralInversion,
      ← pu_mat5Mul_assoc centralInversion centralInversion (transport a),
      thm_central_inversion_properties.1, pu_mat5Mul_id_left,
      ← pu_mat5Mul_assoc (mat5Mul (faceReflection ⟨0, by decide⟩) g) (transport a) centralInversion,
      pu_mat5Mul_assoc (faceReflection ⟨0, by decide⟩) g (transport a)]

private theorem pu_classSwapMat_evalTransportWord (w : List (Fin 24)) :
    classSwapMat (evalTransportWord w) = evalTransportWord (⟨0, by decide⟩ :: w.map oppSlot) := by
  have hZWord : ∀ u : List (Fin 24),
      mat5Mul (mat5Mul centralInversion (evalTransportWord u)) centralInversion = evalTransportWord (u.map oppSlot) := by
    intro u; induction u with
    | nil => simp only [List.map, evalTransportWord]; rw [pu_mat5Mul_id_right, thm_central_inversion_properties.1]
    | cons a rest ih =>
      simp only [List.map, evalTransportWord]
      rw [← ih, ← pu_Z_transport_Z a,
          pu_mat5Mul_assoc (mat5Mul centralInversion (transport a)) centralInversion _,
          ← pu_mat5Mul_assoc centralInversion (mat5Mul centralInversion (evalTransportWord rest)) centralInversion,
          ← pu_mat5Mul_assoc centralInversion centralInversion (evalTransportWord rest),
          thm_central_inversion_properties.1, pu_mat5Mul_id_left,
          ← pu_mat5Mul_assoc (mat5Mul centralInversion (transport a)) (evalTransportWord rest) centralInversion,
          pu_mat5Mul_assoc centralInversion (transport a) (evalTransportWord rest)]
  unfold classSwapMat
  change mat5Mul (mat5Mul (faceReflection ⟨0, by decide⟩) (evalTransportWord w)) centralInversion =
    mat5Mul (mat5Mul (faceReflection ⟨0, by decide⟩) centralInversion) (evalTransportWord (w.map oppSlot))
  rw [← hZWord w,
      pu_mat5Mul_assoc (faceReflection ⟨0, by decide⟩) centralInversion _,
      ← pu_mat5Mul_assoc centralInversion (mat5Mul centralInversion (evalTransportWord w)) centralInversion,
      ← pu_mat5Mul_assoc centralInversion centralInversion (evalTransportWord w),
      thm_central_inversion_properties.1, pu_mat5Mul_id_left,
      ← pu_mat5Mul_assoc (faceReflection ⟨0, by decide⟩) (evalTransportWord w) centralInversion]

private theorem pu_mat5Det_classSwap (g : Mat5) :
    mat5Det (classSwapMat g) = ZSqrt2.neg (mat5Det g) := by
  unfold classSwapMat; rw [pu_mat5Det_mul_centralInversion, pu_mat5Det_faceRefl0_mul]

private theorem pu_dockParity_classSwap (g : Mat5) (hUni : isUnimodularMat5 g = true) :
    dockParity (classSwapMat g) = -dockParity g := by
  rcases of_decide_eq_true hUni with h1 | hm1
  · unfold dockParity; rw [pu_mat5Det_classSwap, h1]; decide
  · unfold dockParity; rw [pu_mat5Det_classSwap, hm1]; decide

private theorem pu_isUnimodularMat5_neg (g₁ g₂ : Mat5) (h : mat5Det g₁ = ZSqrt2.neg (mat5Det g₂)) :
    isUnimodularMat5 g₁ = isUnimodularMat5 g₂ := by
  unfold isUnimodularMat5; rw [h]
  have hIff : (ZSqrt2.neg (mat5Det g₂) = ZSqrt2.one ∨ ZSqrt2.neg (mat5Det g₂) = ZSqrt2.negOne) ↔
      (mat5Det g₂ = ZSqrt2.one ∨ mat5Det g₂ = ZSqrt2.negOne) := by
    constructor
    · intro hx; rcases hx with h1 | h2
      · exact Or.inr (by rw [← pu_z2_neg_neg (mat5Det g₂), h1]; rfl)
      · exact Or.inl (by rw [← pu_z2_neg_neg (mat5Det g₂), h2]; rfl)
    · intro hx; rcases hx with h1 | h2
      · exact Or.inr (by rw [h1]; rfl)
      · exact Or.inl (by rw [h2]; rfl)
  if hp : mat5Det g₂ = ZSqrt2.one ∨ mat5Det g₂ = ZSqrt2.negOne then
    rw [decide_eq_true (hIff.mpr hp), decide_eq_true hp]
  else
    rw [decide_eq_false (fun hx => hp (hIff.mp hx)), decide_eq_false hp]

private theorem pu_isUnimodularMat5_classSwap (g : Mat5) :
    isUnimodularMat5 (classSwapMat g) = isUnimodularMat5 g :=
  pu_isUnimodularMat5_neg (classSwapMat g) g (pu_mat5Det_classSwap g)

private theorem pu_isUnimodularMat5_mul_transport (g : Mat5) (a : Fin 24) :
    isUnimodularMat5 (mat5Mul g (transport a)) = isUnimodularMat5 g :=
  pu_isUnimodularMat5_neg (mat5Mul g (transport a)) g (pu_mat5Det_mul_transport g a)

private theorem pu_isUnimodularMat5_evalTransportWord (w : List (Fin 24)) :
    isUnimodularMat5 (evalTransportWord w) = true := by
  have hMul : ∀ (u : List (Fin 24)) (g : Mat5), isUnimodularMat5 g = true →
      isUnimodularMat5 (mat5Mul g (evalTransportWord u)) = true := by
    intro u; induction u with
    | nil => intro g hg; simp only [evalTransportWord]; rw [pu_mat5Mul_id_right]; exact hg
    | cons a rest ih =>
      intro g hg; simp only [evalTransportWord]; rw [← pu_mat5Mul_assoc]
      exact ih (mat5Mul g (transport a)) (by rw [pu_isUnimodularMat5_mul_transport]; exact hg)
  have hId : isUnimodularMat5 mat5Id = true := by decide
  have hW := hMul w mat5Id hId
  rw [pu_mat5Mul_id_left] at hW; exact hW

/-- Headline Theorem 6 (Connected-Honeycomb Class-Swap `L(g) = F_0 * g * Z` Involution, `Γ`-Closure & Unimodularity):
    `L` lies strictly inside the connected `{3,4,3,4}` honeycomb (`L(I_5) = k_0 ∈ O^+(4,1; ℤ[√2])`,
    `L(evalTransportWord w) = evalTransportWord (0 :: w.map oppSlot)`), satisfies `L^2 = I`,
    `L(g * k_a) = L(g) * k_{opp a}`, `det(L g) = -det(g)`, flips `dockParity` on every unimodular frame,
    and certifies `isUnimodularMat5 (evalTransportWord w) = true` for EVERY finite path `w` on infinite `{3,4,3,4}`. -/
theorem thm_pu_class_swap_left_involution_and_parity :
    classSwapMat mat5Id = transport ⟨0, by decide⟩ ∧
    mat5Mul (mat5Transpose (transport ⟨0, by decide⟩)) (mat5Mul twiceGram (transport ⟨0, by decide⟩)) = twiceGram ∧
    twiceForm (mat5Vec (transport ⟨0, by decide⟩) baseCenter) baseCenter = ZSqrt2.ofInt (-6) ∧
    (∀ g : Mat5, classSwapMat (classSwapMat g) = g) ∧
    (∀ (g : Mat5) (a : Fin 24), classSwapMat (mat5Mul g (transport a)) = mat5Mul (classSwapMat g) (transport (oppSlot a))) ∧
    (∀ w : List (Fin 24), classSwapMat (evalTransportWord w) = evalTransportWord (⟨0, by decide⟩ :: w.map oppSlot)) ∧
    (∀ g : Mat5, mat5Det (classSwapMat g) = ZSqrt2.neg (mat5Det g)) ∧
    (∀ g : Mat5, isUnimodularMat5 g = true → dockParity (classSwapMat g) = -dockParity g) ∧
    (∀ (g : Mat5) (a : Fin 24), isUnimodularMat5 g = true → isUnimodularMat5 (mat5Mul g (transport a)) = true) ∧
    (∀ w : List (Fin 24), isUnimodularMat5 (evalTransportWord w) = true) := by
  have hOrth : mat5Mul (mat5Transpose (transport ⟨0, by decide⟩)) (mat5Mul twiceGram (transport ⟨0, by decide⟩)) = twiceGram :=
    thm_orth_group_mul (faceReflection ⟨0, by decide⟩) centralInversion
      (thm_reflection_preserves_twiceGram (facetNormal ⟨0, by decide⟩) (thm_24_facets_geometry.2.2.1 ⟨0, by decide⟩))
      thm_central_inversion_properties.2.1
  exact ⟨pu_classSwapMat_id, hOrth, by decide, pu_classSwapMat_inv, pu_classSwapMat_mul_transport,
    pu_classSwapMat_evalTransportWord, pu_mat5Det_classSwap, pu_dockParity_classSwap,
    fun g a h => by rw [pu_isUnimodularMat5_mul_transport]; exact h,
    pu_isUnimodularMat5_evalTransportWord⟩

/-! ### Compact `HoneycombConfig` & `LocalSiteFamily` Infrastructure for `J = L ∘ C` -/

private def pu_listIntLt : List Int → List Int → Bool
  | [], _ => false
  | _, [] => false
  | x :: xs, y :: ys => if x < y then true else if y < x then false else pu_listIntLt xs ys

private theorem pu_listIntLt_irrefl : ∀ xs : List Int, pu_listIntLt xs xs = false
  | [] => rfl
  | x :: rest => by
    simp only [pu_listIntLt]
    have hxx : ¬ (x < x) := by omega
    simp only [ite_eq_right hxx]
    exact pu_listIntLt_irrefl rest

private theorem pu_listIntLt_trans : ∀ (xs ys zs : List Int),
    pu_listIntLt xs ys = true → pu_listIntLt ys zs = true → pu_listIntLt xs zs = true
  | [], _, _, h1, _ => Bool.noConfusion h1
  | _ :: _, [], _, h1, _ => Bool.noConfusion h1
  | _ :: _, _ :: _, [], _, h2 => Bool.noConfusion h2
  | x :: xr, y :: yr, z :: zr, h1, h2 => by
    simp only [pu_listIntLt] at h1 h2 ⊢
    if hxy : x < y then
      if hyz : y < z then rw [ite_eq_left (by omega)]
      else if hzy : z < y then rw [ite_eq_right hyz, ite_eq_left hzy] at h2; exact Bool.noConfusion h2
      else rw [ite_eq_left (by omega)]
    else if hyx : y < x then rw [ite_eq_right hxy, ite_eq_left hyx] at h1; exact Bool.noConfusion h1
    else
      rw [ite_eq_right hxy, ite_eq_right hyx] at h1
      if hyz : y < z then rw [ite_eq_left (by omega)]
      else if hzy : z < y then rw [ite_eq_right hyz, ite_eq_left hzy] at h2; exact Bool.noConfusion h2
      else
        rw [ite_eq_right hyz, ite_eq_right hzy] at h2
        have hxz : ¬ (x < z) := by omega
        have hzx : ¬ (z < x) := by omega
        simp only [ite_eq_right hxz, ite_eq_right hzx]
        exact pu_listIntLt_trans xr yr zr h1 h2

private theorem pu_listIntLt_trichotomy : ∀ (xs ys : List Int), xs.length = ys.length →
    pu_listIntLt xs ys = true ∨ xs = ys ∨ pu_listIntLt ys xs = true
  | [], [], _ => Or.inr (Or.inl rfl)
  | [], _ :: _, h => by simp only [List.length_nil, List.length_cons] at h; omega
  | _ :: _, [], h => by simp only [List.length_nil, List.length_cons] at h; omega
  | x :: xr, y :: yr, h => by
    simp only [List.length_cons] at h
    if hxy : x < y then exact Or.inl (by simp only [pu_listIntLt, ite_eq_left hxy])
    else if hyx : y < x then exact Or.inr (Or.inr (by simp only [pu_listIntLt, ite_eq_left hyx]))
    else
      have heq : x = y := by omega
      rcases pu_listIntLt_trichotomy xr yr (by omega) with h1 | h2 | h3
      · exact Or.inl (by simp only [pu_listIntLt, ite_eq_right hxy, ite_eq_right hyx]; exact h1)
      · exact Or.inr (Or.inl (by rw [heq, h2]))
      · exact Or.inr (Or.inr (by simp only [pu_listIntLt, ite_eq_right hyx, ite_eq_right hxy]; exact h3))

private def pu_vec5Key (v : Vec5) : List Int :=
  [ (v ⟨0, by decide⟩).a, (v ⟨0, by decide⟩).b, (v ⟨1, by decide⟩).a, (v ⟨1, by decide⟩).b,
    (v ⟨2, by decide⟩).a, (v ⟨2, by decide⟩).b, (v ⟨3, by decide⟩).a, (v ⟨3, by decide⟩).b,
    (v ⟨4, by decide⟩).a, (v ⟨4, by decide⟩).b ]

private def pu_mat5Key (g : Mat5) : List Int :=
  pu_vec5Key (g ⟨0, by decide⟩) ++ pu_vec5Key (g ⟨1, by decide⟩) ++
  pu_vec5Key (g ⟨2, by decide⟩) ++ pu_vec5Key (g ⟨3, by decide⟩) ++ pu_vec5Key (g ⟨4, by decide⟩)

private theorem pu_mat5Lt_eq (g₁ g₂ : Mat5) : mat5Lt g₁ g₂ = pu_listIntLt (pu_mat5Key g₁) (pu_mat5Key g₂) := rfl
private theorem pu_mat5Lt_irrefl (g : Mat5) : mat5Lt g g = false := by
  rw [pu_mat5Lt_eq]; exact pu_listIntLt_irrefl (pu_mat5Key g)
private theorem pu_mat5Lt_trans (g₁ g₂ g₃ : Mat5) (h1 : mat5Lt g₁ g₂ = true) (h2 : mat5Lt g₂ g₃ = true) :
    mat5Lt g₁ g₃ = true := by
  rw [pu_mat5Lt_eq] at h1 h2 ⊢; exact pu_listIntLt_trans _ _ _ h1 h2

private theorem pu_mat5Key_inj (g₁ g₂ : Mat5) (h : pu_mat5Key g₁ = pu_mat5Key g₂) : g₁ = g₂ := by
  have hApp : ∀ (a₁ a₂ b₁ b₂ : List Int), a₁.length = a₂.length → a₁ ++ b₁ = a₂ ++ b₂ → a₁ = a₂ ∧ b₁ = b₂ := by
    intro a₁; induction a₁ with
    | nil => intro a₂ b₁ b₂ hl he; cases a₂ with | nil => exact ⟨rfl, he⟩ | cons _ _ => simp only [List.length_nil, List.length_cons] at hl; omega
    | cons x xs ih =>
      intro a₂ b₁ b₂ hl he; cases a₂ with
      | nil => simp only [List.length_nil, List.length_cons] at hl; omega
      | cons y ys =>
        simp only [List.length_cons, List.cons_append, List.cons.injEq] at hl he
        have ⟨hxs, hbs⟩ := ih ys b₁ b₂ (by omega) he.2; exact ⟨by rw [he.1, hxs], hbs⟩
  have hVec : ∀ u v : Vec5, pu_vec5Key u = pu_vec5Key v → u = v := fun u v hv => by
    unfold pu_vec5Key at hv; simp only [List.cons.injEq] at hv
    rcases hv with ⟨a0, b0, a1, b1, a2, b2, a3, b3, a4, b4, _⟩
    have mkEq : ∀ x y : ZSqrt2, x.a = y.a → x.b = y.b → x = y := fun x y ha hb => by cases x; cases y; simp only [ZSqrt2.mk.injEq]; exact ⟨ha, hb⟩
    funext i; match i with
    | ⟨0, _⟩ => exact mkEq _ _ a0 b0 | ⟨1, _⟩ => exact mkEq _ _ a1 b1 | ⟨2, _⟩ => exact mkEq _ _ a2 b2
    | ⟨3, _⟩ => exact mkEq _ _ a3 b3 | ⟨4, _⟩ => exact mkEq _ _ a4 b4
  unfold pu_mat5Key at h
  have ⟨h0123, h4⟩ := hApp
    (pu_vec5Key (g₁ ⟨0, by decide⟩) ++ pu_vec5Key (g₁ ⟨1, by decide⟩) ++ pu_vec5Key (g₁ ⟨2, by decide⟩) ++ pu_vec5Key (g₁ ⟨3, by decide⟩))
    (pu_vec5Key (g₂ ⟨0, by decide⟩) ++ pu_vec5Key (g₂ ⟨1, by decide⟩) ++ pu_vec5Key (g₂ ⟨2, by decide⟩) ++ pu_vec5Key (g₂ ⟨3, by decide⟩))
    (pu_vec5Key (g₁ ⟨4, by decide⟩)) (pu_vec5Key (g₂ ⟨4, by decide⟩)) rfl h
  have ⟨h012, h3⟩ := hApp
    (pu_vec5Key (g₁ ⟨0, by decide⟩) ++ pu_vec5Key (g₁ ⟨1, by decide⟩) ++ pu_vec5Key (g₁ ⟨2, by decide⟩))
    (pu_vec5Key (g₂ ⟨0, by decide⟩) ++ pu_vec5Key (g₂ ⟨1, by decide⟩) ++ pu_vec5Key (g₂ ⟨2, by decide⟩))
    (pu_vec5Key (g₁ ⟨3, by decide⟩)) (pu_vec5Key (g₂ ⟨3, by decide⟩)) rfl h0123
  have ⟨h01, h2⟩ := hApp
    (pu_vec5Key (g₁ ⟨0, by decide⟩) ++ pu_vec5Key (g₁ ⟨1, by decide⟩))
    (pu_vec5Key (g₂ ⟨0, by decide⟩) ++ pu_vec5Key (g₂ ⟨1, by decide⟩))
    (pu_vec5Key (g₁ ⟨2, by decide⟩)) (pu_vec5Key (g₂ ⟨2, by decide⟩)) rfl h012
  have ⟨h0, h1⟩ := hApp
    (pu_vec5Key (g₁ ⟨0, by decide⟩)) (pu_vec5Key (g₂ ⟨0, by decide⟩))
    (pu_vec5Key (g₁ ⟨1, by decide⟩)) (pu_vec5Key (g₂ ⟨1, by decide⟩)) rfl h01
  funext i; match i with
  | ⟨0, _⟩ => exact hVec _ _ h0 | ⟨1, _⟩ => exact hVec _ _ h1 | ⟨2, _⟩ => exact hVec _ _ h2
  | ⟨3, _⟩ => exact hVec _ _ h3 | ⟨4, _⟩ => exact hVec _ _ h4

private theorem pu_mat5Lt_trichotomy (g₁ g₂ : Mat5) : mat5Lt g₁ g₂ = true ∨ g₁ = g₂ ∨ mat5Lt g₂ g₁ = true := by
  rw [pu_mat5Lt_eq, pu_mat5Lt_eq]
  rcases pu_listIntLt_trichotomy (pu_mat5Key g₁) (pu_mat5Key g₂) rfl with h1 | h2 | h3
  · exact Or.inl h1
  · exact Or.inr (Or.inl (pu_mat5Key_inj g₁ g₂ h2))
  · exact Or.inr (Or.inr h3)

private theorem pu_memBool_iff {α : Type} [DecidableEq α] (a : α) : ∀ xs : List α, memBool a xs = true ↔ a ∈ xs
  | [] => ⟨(fun h => Bool.noConfusion h), (fun h => nomatch h)⟩
  | x :: rest => by
    simp only [memBool]
    if hx : x = a then rw [ite_eq_left hx, hx]; exact ⟨fun _ => List.Mem.head rest, fun _ => rfl⟩
    else
      rw [ite_eq_right hx]
      exact ⟨(fun h => List.Mem.tail x ((pu_memBool_iff a rest).mp h)),
        (fun h => match h with | List.Mem.head _ => absurd rfl hx | List.Mem.tail _ h' => (pu_memBool_iff a rest).mpr h')⟩

private theorem pu_mem_map_iff {α β : Type} (f : α → β) (xs : List α) (b : β) :
    b ∈ xs.map f ↔ ∃ a : α, a ∈ xs ∧ f a = b := by
  induction xs with
  | nil => exact ⟨(fun h => nomatch h), (fun ⟨_, ha, _⟩ => nomatch ha)⟩
  | cons x rest ih =>
    simp only [List.map]
    constructor
    · intro h
      cases h with
      | head => exact ⟨x, List.Mem.head rest, rfl⟩
      | tail _ h' => let ⟨a, ha, hf⟩ := ih.mp h'; exact ⟨a, List.Mem.tail x ha, hf⟩
    · intro ⟨a, ha, hf⟩
      cases ha with
      | head => rw [hf]; exact List.Mem.head _
      | tail _ h' => exact List.Mem.tail (f x) (ih.mpr ⟨a, h', hf⟩)

private theorem pu_mem_flatMapList_iff {α β : Type} (f : α → List β) (xs : List α) (b : β) :
    b ∈ flatMapList f xs ↔ ∃ a : α, a ∈ xs ∧ b ∈ f a := by
  have hApp : ∀ (l₁ l₂ : List β), b ∈ l₁ ++ l₂ ↔ b ∈ l₁ ∨ b ∈ l₂ := fun l₁ l₂ => by
    induction l₁ with
    | nil => exact ⟨Or.inr, (fun h => match h with | Or.inl h1 => nomatch h1 | Or.inr h2 => h2)⟩
    | cons x r ih =>
      simp only [List.cons_append]
      constructor
      · intro h
        cases h with
        | head => exact Or.inl (List.Mem.head r)
        | tail _ h' =>
          cases ih.mp h' with
          | inl h1 => exact Or.inl (List.Mem.tail x h1)
          | inr h2 => exact Or.inr h2
      · intro h
        cases h with
        | inl h1 =>
          cases h1 with
          | head => exact List.Mem.head _
          | tail _ h' => exact List.Mem.tail x (ih.mpr (Or.inl h'))
        | inr h2 => exact List.Mem.tail x (ih.mpr (Or.inr h2))
  induction xs with
  | nil => exact ⟨(fun h => nomatch h), (fun ⟨_, ha, _⟩ => nomatch ha)⟩
  | cons x rest ih =>
    simp only [flatMapList]
    constructor
    · intro h
      cases (hApp (f x) (flatMapList f rest)).mp h with
      | inl h1 => exact ⟨x, List.Mem.head rest, h1⟩
      | inr h2 => let ⟨a, ha, hb⟩ := ih.mp h2; exact ⟨a, List.Mem.tail x ha, hb⟩
    · intro ⟨a, ha, hb⟩
      cases ha with
      | head => exact (hApp (f x) (flatMapList f rest)).mpr (Or.inl hb)
      | tail _ h' => exact (hApp (f x) (flatMapList f rest)).mpr (Or.inr (ih.mpr ⟨a, h', hb⟩))

private theorem pu_list_all_iff {α : Type} (p : α → Bool) (xs : List α) :
    xs.all p = true ↔ ∀ x, x ∈ xs → p x = true := by
  induction xs with
  | nil => exact ⟨(fun _ _ h => nomatch h), (fun _ => rfl)⟩
  | cons x rest ih =>
    simp only [List.all, Bool.and_eq_true]
    exact ⟨(fun ⟨hx, hr⟩ y hy => match hy with | List.Mem.head _ => hx | List.Mem.tail _ h' => ih.mp hr y h'),
      (fun hall => ⟨hall x (List.Mem.head rest), ih.mpr (fun y hy => hall y (List.Mem.tail x hy))⟩)⟩

private theorem pu_isNodup_map_inj {α β : Type} (f : α → β) (hinj : ∀ x y, f x = f y → x = y)
    {xs : List α} (h : IsNodup xs) : IsNodup (xs.map f) := by
  induction h with
  | nil => exact IsNodup.nil
  | cons hnot _ ih =>
    simp only [List.map]
    refine IsNodup.cons (fun hm => ?_) ih
    obtain ⟨a, ha, hfa⟩ := (pu_mem_map_iff f _ _).mp hm
    rw [hinj _ _ hfa] at ha; exact hnot ha

private theorem pu_mem_eraseOne_iff {α : Type} [DecidableEq α] (a y : α) {xs : List α} (hnd : IsNodup xs) :
    y ∈ eraseOne a xs ↔ y ∈ xs ∧ y ≠ a := by
  induction hnd with
  | nil => exact ⟨(fun h => nomatch h), (fun h => nomatch h.1)⟩
  | @cons x rest hnot _ ih =>
    simp only [eraseOne]
    if hxa : x = a then
      rw [ite_eq_left hxa]
      exact ⟨(fun hy => ⟨List.Mem.tail x hy, fun hya => by rw [hya, ← hxa] at hy; exact hnot hy⟩),
        (fun ⟨hm, hne⟩ => match hm with | List.Mem.head _ => absurd hxa hne | List.Mem.tail _ h' => h')⟩
    else
      rw [ite_eq_right hxa]
      constructor
      · intro h
        cases h with
        | head => exact ⟨List.Mem.head rest, hxa⟩
        | tail _ h' => let ⟨hm, hne⟩ := ih.mp h'; exact ⟨List.Mem.tail x hm, hne⟩
      · intro ⟨hm, hne⟩
        cases hm with
        | head => exact List.Mem.head _
        | tail _ h' => exact List.Mem.tail x (ih.mpr ⟨h', hne⟩)

private theorem pu_isNodup_eraseOne {α : Type} [DecidableEq α] (a : α) {xs : List α} (hnd : IsNodup xs) :
    IsNodup (eraseOne a xs) := by
  induction hnd with
  | nil => exact IsNodup.nil
  | @cons x rest hnot hndRest ih =>
    simp only [eraseOne]
    if hxa : x = a then rw [ite_eq_left hxa]; exact hndRest
    else rw [ite_eq_right hxa]; exact IsNodup.cons (fun hm => hnot ((pu_mem_eraseOne_iff a x hndRest).mp hm).1) ih

private theorem pu_lookupEntries_not_lt (g : Mat5) : ∀ (es : List (Mat5 × FullDock)),
    (∀ p, p ∈ es → mat5Lt g p.1 = true) → lookupEntries g es = v1FullDock
  | [], _ => rfl
  | (k, d) :: rest, hgt => by
    simp only [lookupEntries]
    have hlt := hgt (k, d) (List.Mem.head rest)
    have hne : k ≠ g := fun heq => by rw [heq, pu_mat5Lt_irrefl] at hlt; exact Bool.noConfusion hlt
    rw [ite_eq_right hne]
    exact pu_lookupEntries_not_lt g rest (fun q hq => hgt q (List.Mem.tail _ hq))

private theorem pu_honeycombConfig_ext (c₁ c₂ : HoneycombConfig) (h : ∀ g : Mat5, c₁.lookup g = c₂.lookup g) : c₁ = c₂ := by
  have hAux : ∀ es₁ es₂ : List (Mat5 × FullDock), SortedEntries es₁ → SortedEntries es₂ →
      (∀ p, p ∈ es₁ → p.2 ≠ v1FullDock) → (∀ p, p ∈ es₂ → p.2 ≠ v1FullDock) →
      (∀ g, lookupEntries g es₁ = lookupEntries g es₂) → es₁ = es₂ := by
    intro es₁; induction es₁ with
    | nil =>
      intro es₂ _ _ _ hne₂ hlk
      cases es₂ with | nil => rfl | cons p rest =>
        cases p with | mk k d =>
        have h0 := hlk k; simp only [lookupEntries, ite_true] at h0
        exact absurd h0.symm (hne₂ (k, d) (List.Mem.head rest))
    | cons p₁ r₁ ih =>
      cases p₁ with | mk k₁ d₁ =>
      intro es₂ hs₁ hs₂ hne₁ hne₂ hlk
      cases es₂ with
      | nil =>
        have h0 := hlk k₁; simp only [lookupEntries, ite_true] at h0
        exact absurd h0 (hne₁ (k₁, d₁) (List.Mem.head r₁))
      | cons p₂ r₂ =>
        cases p₂ with | mk k₂ d₂ =>
        rcases pu_mat5Lt_trichotomy k₁ k₂ with hlt | heq | hgt
        · have h0 := hlk k₁; simp only [lookupEntries, ite_true] at h0
          have hne12 : k₂ ≠ k₁ := fun e => by rw [e, pu_mat5Lt_irrefl] at hlt; exact Bool.noConfusion hlt
          rw [ite_eq_right hne12, pu_lookupEntries_not_lt k₁ r₂ (fun q hq => pu_mat5Lt_trans k₁ k₂ q.1 hlt (hs₂.1 q hq))] at h0
          exact absurd h0 (hne₁ (k₁, d₁) (List.Mem.head r₁))
        · have hd : d₁ = d₂ := by have h0 := hlk k₁; simp only [lookupEntries, heq, ite_true] at h0; exact h0
          have hr : r₁ = r₂ := ih r₂ hs₁.2 hs₂.2 (fun q hq => hne₁ q (List.Mem.tail _ hq)) (fun q hq => hne₂ q (List.Mem.tail _ hq)) (fun g => by
            if hgk : k₁ = g then rw [← hgk, pu_lookupEntries_not_lt k₁ r₁ hs₁.1, pu_lookupEntries_not_lt k₁ r₂ (by rw [heq]; exact hs₂.1)]
            else
              have h0 := hlk g
              rw [← heq] at h0
              simp only [lookupEntries, ite_eq_right hgk] at h0
              exact h0)
          rw [heq, hd, hr]
        · have h0 := hlk k₂; simp only [lookupEntries, ite_true] at h0
          have hne21 : k₁ ≠ k₂ := fun e => by rw [e, pu_mat5Lt_irrefl] at hgt; exact Bool.noConfusion hgt
          rw [ite_eq_right hne21, pu_lookupEntries_not_lt k₂ r₁ (fun q hq => pu_mat5Lt_trans k₂ k₁ q.1 hgt (hs₁.1 q hq))] at h0
          exact absurd h0.symm (hne₂ (k₂, d₂) (List.Mem.head r₂))
  cases c₁ with | mk e₁ s₁ n₁ =>
  cases c₂ with | mk e₂ s₂ n₂ =>
  simp only [HoneycombConfig.mk.injEq]
  exact hAux e₁ e₂ s₁ s₂ n₁ n₂ h

private theorem pu_activeDocks_nodup (c : HoneycombConfig) : IsNodup c.activeDocks := by
  have hAux : ∀ es : List (Mat5 × FullDock), SortedEntries es → IsNodup (es.map Prod.fst) := by
    intro es; induction es with
    | nil => intro _; exact IsNodup.nil
    | cons p rest ih =>
      intro hs
      cases p with | mk k _d =>
      simp only [List.map]
      refine IsNodup.cons (fun hm => ?_) (ih hs.2)
      obtain ⟨q, hq, hqk⟩ := (pu_mem_map_iff Prod.fst rest k).mp hm
      have hlt := hs.1 q hq; rw [hqk, pu_mat5Lt_irrefl] at hlt; exact Bool.noConfusion hlt
  exact hAux c.entries c.sorted

private theorem pu_mem_activeDocks_iff (c : HoneycombConfig) (g : Mat5) :
    g ∈ c.activeDocks ↔ c.lookup g ≠ v1FullDock := by
  have hAux : ∀ es : List (Mat5 × FullDock), SortedEntries es → (∀ p, p ∈ es → p.2 ≠ v1FullDock) →
      (g ∈ es.map Prod.fst ↔ lookupEntries g es ≠ v1FullDock) := by
    intro es; induction es with
    | nil => intro _ _; exact ⟨(fun h => nomatch h), (fun h => absurd rfl h)⟩
    | cons p rest ih =>
      intro hs hne
      cases p with | mk k d =>
      simp only [List.map, lookupEntries]
      if hkg : k = g then
        rw [ite_eq_left hkg, hkg]
        exact ⟨fun _ => hne (g, d) (by rw [← hkg]; exact List.Mem.head rest), fun _ => List.Mem.head _⟩
      else
        rw [ite_eq_right hkg]
        have hih := ih hs.2 (fun q hq => hne q (List.Mem.tail _ hq))
        exact ⟨(fun hm => match hm with | List.Mem.head _ => absurd rfl hkg | List.Mem.tail _ h' => hih.mp h'),
          (fun hneL => List.Mem.tail k (hih.mpr hneL))⟩
  exact hAux c.entries c.sorted c.nonEmpty

private theorem pu_lookup_setDock_aux (g h : Mat5) (d : FullDock) :
    ∀ (es : List (Mat5 × FullDock)) (hs : SortedEntries es) (hne : ∀ p, p ∈ es → p.2 ≠ v1FullDock),
      ((⟨es, hs, hne⟩ : HoneycombConfig).setDock g d).lookup h = if h = g then d else lookupEntries h es
  | [], _, _ => by
    change lookupEntries h (if d = v1FullDock then [] else [(g, d)]) = if h = g then d else v1FullDock
    if hd : d = v1FullDock then
      rw [ite_eq_left hd]; simp only [lookupEntries]
      if hhg : h = g then rw [ite_eq_left hhg, hd] else rw [ite_eq_right hhg]
    else
      rw [ite_eq_right hd]; simp only [lookupEntries]
      if hhg : h = g then rw [ite_eq_left hhg, ite_eq_left hhg.symm]
      else rw [ite_eq_right hhg, ite_eq_right (fun e => hhg e.symm)]
  | (k, dk) :: rest, hs, hne => by
    let cRest : HoneycombConfig := ⟨rest, hs.2, fun p hp => hne p (List.Mem.tail _ hp)⟩
    have hStep : ((⟨(k, dk) :: rest, hs, hne⟩ : HoneycombConfig).setDock g d).lookup h =
        lookupEntries h
          (if mat5Lt g k then (if d = v1FullDock then (k, dk) :: rest else (g, d) :: (k, dk) :: rest)
          else if k = g then (if d = v1FullDock then rest else (g, d) :: rest)
          else (k, dk) :: (cRest.setDock g d).entries) := rfl
    rw [hStep]
    if hlt : mat5Lt g k = true then
      rw [ite_eq_left hlt]
      if hd : d = v1FullDock then
        rw [ite_eq_left hd]
        if hhg : h = g then
          rw [ite_eq_left hhg, hd, hhg]
          have hkg : k ≠ g := fun e => by rw [e, pu_mat5Lt_irrefl] at hlt; exact Bool.noConfusion hlt
          simp only [lookupEntries, ite_eq_right hkg]
          exact pu_lookupEntries_not_lt g rest (fun p hp => pu_mat5Lt_trans g k p.1 hlt (hs.1 p hp))
        else rw [ite_eq_right hhg]
      else
        rw [ite_eq_right hd]; simp only [lookupEntries]
        if hhg : h = g then rw [ite_eq_left hhg, ite_eq_left hhg.symm]
        else rw [ite_eq_right hhg, ite_eq_right (fun e => hhg e.symm)]
    else
      rw [ite_eq_right hlt]
      if hkg : k = g then
        rw [ite_eq_left hkg]
        if hd : d = v1FullDock then
          rw [ite_eq_left hd]
          if hhg : h = g then
            rw [ite_eq_left hhg, hd, hhg]
            exact pu_lookupEntries_not_lt g rest (by rw [← hkg]; exact hs.1)
          else
            have hkh : k ≠ h := by rw [hkg]; exact fun e => hhg e.symm
            rw [ite_eq_right hhg]; simp only [lookupEntries, ite_eq_right hkh]
        else
          rw [ite_eq_right hd]; simp only [lookupEntries]
          if hhg : h = g then rw [ite_eq_left hhg, ite_eq_left hhg.symm]
          else
            have hgh : g ≠ h := fun e => hhg e.symm
            have hkh : k ≠ h := by rw [hkg]; exact hgh
            rw [ite_eq_right hhg, ite_eq_right hgh, ite_eq_right hkh]
      else
        rw [ite_eq_right hkg]; simp only [lookupEntries]
        if hkh : k = h then
          have hhg : h ≠ g := by rw [← hkh]; exact hkg
          rw [ite_eq_left hkh, ite_eq_right hhg, ite_eq_left hkh]
        else
          rw [ite_eq_right hkh, ite_eq_right hkh]
          exact pu_lookup_setDock_aux g h d rest hs.2 (fun p hp => hne p (List.Mem.tail _ hp))

private theorem pu_lookup_setDock (c : HoneycombConfig) (g h : Mat5) (d : FullDock) :
    (c.setDock g d).lookup h = if h = g then d else c.lookup h :=
  pu_lookup_setDock_aux g h d c.entries c.sorted c.nonEmpty

private theorem pu_lookup_ofSites (cand : List Mat5) (f : Mat5 → FullDock)
    (hvan : ∀ g : Mat5, g ∉ cand → f g = v1FullDock) (g : Mat5) :
    (ofSites cand f).lookup g = f g := by
  have hFold : ∀ (xs : List Mat5) (init : HoneycombConfig),
      (xs.foldl (fun acc k => acc.setDock k (f k)) init).lookup g = if memBool g xs then f g else init.lookup g := by
    intro xs; induction xs with
    | nil => intro _; rfl
    | cons k rest ih =>
      intro init; simp only [List.foldl]; rw [ih (init.setDock k (f k))]
      if hkg : k = g then
        have hM : memBool g (k :: rest) = true := by simp only [memBool, ite_eq_left hkg]
        rw [ite_eq_left hM]
        cases hm : memBool g rest with
        | true => rw [pu_ite_bool_true]
        | false => rw [pu_ite_bool_false, pu_lookup_setDock, ite_eq_left hkg.symm, hkg]
      else
        have hM : memBool g (k :: rest) = memBool g rest := by simp only [memBool, ite_eq_right hkg]
        cases hm : memBool g rest with
        | true =>
          have hMT : memBool g (k :: rest) = true := by rw [hM, hm]
          rw [pu_ite_bool_true, ite_eq_left hMT]
        | false =>
          have hMF : memBool g (k :: rest) ≠ true := by rw [hM, hm]; decide
          rw [pu_ite_bool_false, ite_eq_right hMF, pu_lookup_setDock, ite_eq_right (fun e => hkg e.symm)]
  unfold ofSites; rw [hFold]
  cases hm : memBool g cand with
  | true => rfl
  | false =>
    change v1FullDock = f g
    refine (hvan g (fun hmem => ?_)).symm
    have ht := (pu_memBool_iff g cand).mpr hmem; rw [hm] at ht; exact Bool.noConfusion ht

private theorem pu_lookup_mapConfig (c : HoneycombConfig) (fDock : FullDock → FullDock)
    (hfV1 : fDock v1FullDock = v1FullDock) (g : Mat5) :
    (ofSites (c.activeDocks.map classSwapMat) (fun x => fDock (c.lookup (classSwapMat x)))).lookup g =
      fDock (c.lookup (classSwapMat g)) := by
  refine pu_lookup_ofSites _ _ ?_ g
  intro x hx
  have h0 : c.lookup (classSwapMat x) = v1FullDock := by
    if h : c.lookup (classSwapMat x) = v1FullDock then exact h
    else
      have hIn := (pu_mem_activeDocks_iff c (classSwapMat x)).mpr h
      exact absurd ((pu_mem_map_iff classSwapMat c.activeDocks x).mpr ⟨classSwapMat x, hIn, pu_classSwapMat_inv x⟩) hx
  rw [h0, hfV1]

/-- Connected-honeycomb bipartite class-swap configuration map `L(c)(g) = revFullDock (c(F_0 * g * Z))` on infinite `{3,4,3,4}`. -/
def lConfig (c : HoneycombConfig) : HoneycombConfig :=
  ofSites (c.activeDocks.map classSwapMat) (fun g => revFullDock (c.lookup (classSwapMat g)))

/-- Combined infinite-honeycomb involutive neutrality map `J = L ∘ C`:
    `(J c)(g) = conjFullDock (revFullDock (c(F_0 * g * Z)))`. -/
def jConfig (c : HoneycombConfig) : HoneycombConfig :=
  ofSites (c.activeDocks.map classSwapMat) (fun g => conjFullDock (revFullDock (c.lookup (classSwapMat g))))

/-- Quantum Fock lift of pure connected class-swap `L` and combined neutrality involution `J = L ∘ C`. -/
def fockL (ψ : FockVec NinthLoc6 HoneycombConfig) : FockVec NinthLoc6 HoneycombConfig := fun c => ψ (lConfig c)
def fockJ (ψ : FockVec NinthLoc6 HoneycombConfig) : FockVec NinthLoc6 HoneycombConfig := fun c => ψ (jConfig c)

/-- Decidable unimodular configuration predicate: every active cell frame satisfies `det(g) = ±1`. -/
def isUnimodularConfig (c : HoneycombConfig) : Bool :=
  c.activeDocks.all isUnimodularMat5

/-- Quantum Fock state supported strictly on unimodular (`det = ±1`) honeycomb configurations. -/
def UnimodularState (ψ : FockVec NinthLoc6 HoneycombConfig) : Prop :=
  ∀ c : HoneycombConfig, isUnimodularConfig c = false → ψ c = NinthLoc6.zero

private theorem pu_line_geom :
    ∀ l : Fin 12, oppSlot (lineA l) = lineB l ∧ oppSlot (lineB l) = lineA l ∧ lineA l ≠ lineB l := by decide

private theorem pu_lookup_lConfig (c : HoneycombConfig) (g : Mat5) :
    (lConfig c).lookup g = revFullDock (c.lookup (classSwapMat g)) := pu_lookup_mapConfig c revFullDock rfl g

private theorem pu_lookup_jConfig (c : HoneycombConfig) (g : Mat5) :
    (jConfig c).lookup g = conjFullDock (revFullDock (c.lookup (classSwapMat g))) :=
  pu_lookup_mapConfig c (fun d => conjFullDock (revFullDock d)) rfl g

private theorem pu_revFullDock_inv (d : FullDock) : revFullDock (revFullDock d) = d := by
  funext a; simp only [revFullDock]; rw [(thm_24_facets_geometry.2.1 a).1]

private theorem pu_jDock_inv (d : FullDock) : conjFullDock (revFullDock (conjFullDock (revFullDock d))) = d := by
  funext a; simp only [conjFullDock, revFullDock]; rw [(thm_24_facets_geometry.2.1 a).1]
  cases d a with | empty => rfl | occ s _ => cases s <;> rfl

private theorem pu_jDock_eq_v1_iff (d : FullDock) : conjFullDock (revFullDock d) = v1FullDock ↔ d = v1FullDock :=
  ⟨fun h => by rw [← pu_jDock_inv d, h]; rfl, fun h => by rw [h]; rfl⟩

private theorem pu_jConfig_inv (c : HoneycombConfig) : jConfig (jConfig c) = c := by
  apply pu_honeycombConfig_ext; intro g
  rw [pu_lookup_jConfig, pu_lookup_jConfig, pu_classSwapMat_inv, pu_jDock_inv]

private theorem pu_lConfig_inv (c : HoneycombConfig) : lConfig (lConfig c) = c := by
  apply pu_honeycombConfig_ext; intro g
  rw [pu_lookup_lConfig, pu_lookup_lConfig, pu_classSwapMat_inv, pu_revFullDock_inv]

private theorem pu_jConfig_v1 : jConfig v1Config = v1Config := by
  apply pu_honeycombConfig_ext; intro g; rw [pu_lookup_jConfig]; rfl

private theorem pu_jConfig_setDock (c : HoneycombConfig) (g : Mat5) (d : FullDock) :
    jConfig (c.setDock g d) = (jConfig c).setDock (classSwapMat g) (conjFullDock (revFullDock d)) := by
  apply pu_honeycombConfig_ext; intro h
  rw [pu_lookup_jConfig, pu_lookup_setDock, pu_lookup_setDock]
  if hh : h = classSwapMat g then simp only [hh, pu_classSwapMat_inv, ite_true]
  else
    have hne : classSwapMat h ≠ g := fun e => hh (by rw [← e, pu_classSwapMat_inv])
    simp only [ite_eq_right hh, ite_eq_right hne, pu_lookup_jConfig]

private theorem pu_lookup_streamConfig (c : HoneycombConfig) (g : Mat5) (a : Fin 24) :
    (streamConfig c).lookup g a = c.lookup (mat5Mul g (transport (oppSlot a))) a := by
  unfold streamConfig
  have hFin : ∀ x : Fin 24, x ∈ List.finRange 24 := fun x =>
    (pu_memBool_iff x (List.finRange 24)).mp ((by decide : ∀ y : Fin 24, memBool y (List.finRange 24) = true) x)
  have hvan : ∀ x : Mat5,
      x ∉ flatMapList (fun k => (List.finRange 24).map (fun b => mat5Mul k (transport b))) c.activeDocks →
      (fun b => c.lookup (mat5Mul x (transport (oppSlot b))) b) = v1FullDock := by
    intro x hx; funext b
    if hb : c.lookup (mat5Mul x (transport (oppSlot b))) b = .empty then exact hb
    else
      have hAct := (pu_mem_activeDocks_iff c _).mpr (fun h0 => hb (congrFun h0 b))
      have hInvL : mat5Mul (transport (oppSlot b)) (transport b) = mat5Id := by
        have h := thm_coxeter_transport_antipodal_inverse.2 (oppSlot b)
        rw [(thm_24_facets_geometry.2.1 b).1] at h; exact h
      have hBack : mat5Mul (mat5Mul x (transport (oppSlot b))) (transport b) = x := by
        rw [pu_mat5Mul_assoc, hInvL, pu_mat5Mul_id_right]
      exact absurd ((pu_mem_flatMapList_iff _ _ x).mpr ⟨_, hAct, (pu_mem_map_iff _ _ x).mpr ⟨b, hFin b, hBack⟩⟩) hx
  exact congrFun (pu_lookup_ofSites _ _ hvan g) a

private theorem pu_lConfig_streamConfig (c : HoneycombConfig) :
    lConfig (streamConfig c) = streamConfig (lConfig c) := by
  apply pu_honeycombConfig_ext; intro g; funext a
  rw [pu_lookup_lConfig]; simp only [revFullDock]
  rw [pu_lookup_streamConfig, pu_lookup_streamConfig, pu_lookup_lConfig]
  simp only [revFullDock]
  rw [pu_classSwapMat_mul_transport]

private theorem pu_jConfig_streamConfig (c : HoneycombConfig) :
    jConfig (streamConfig c) = streamConfig (jConfig c) := by
  apply pu_honeycombConfig_ext; intro g; funext a
  rw [pu_lookup_jConfig]; simp only [conjFullDock, revFullDock]
  rw [pu_lookup_streamConfig, pu_lookup_streamConfig, pu_lookup_jConfig]
  simp only [conjFullDock, revFullDock]
  rw [pu_classSwapMat_mul_transport]

private theorem pu_mem_activeDocks_jConfig (c : HoneycombConfig) (g : Mat5) :
    g ∈ (jConfig c).activeDocks ↔ classSwapMat g ∈ c.activeDocks := by
  rw [pu_mem_activeDocks_iff, pu_mem_activeDocks_iff, pu_lookup_jConfig]
  exact ⟨fun hne h0 => hne ((pu_jDock_eq_v1_iff _).mpr h0), fun hne h0 => hne ((pu_jDock_eq_v1_iff _).mp h0)⟩

private theorem pu_isUnimodularConfig_jConfig (c : HoneycombConfig) :
    isUnimodularConfig (jConfig c) = isUnimodularConfig c := by
  unfold isUnimodularConfig
  cases hL : (jConfig c).activeDocks.all isUnimodularMat5 <;> cases hR : c.activeDocks.all isUnimodularMat5
  · rfl
  · exfalso
    have hT : (jConfig c).activeDocks.all isUnimodularMat5 = true := (pu_list_all_iff _ _).mpr fun g hg => by
      rw [← pu_isUnimodularMat5_classSwap g]
      exact (pu_list_all_iff _ _).mp hR (classSwapMat g) ((pu_mem_activeDocks_jConfig c g).mp hg)
    rw [hL] at hT; exact Bool.noConfusion hT
  · exfalso
    have hT : c.activeDocks.all isUnimodularMat5 = true := (pu_list_all_iff _ _).mpr fun g hg => by
      have hg' : classSwapMat g ∈ (jConfig c).activeDocks := (pu_mem_activeDocks_jConfig c _).mpr (by rw [pu_classSwapMat_inv]; exact hg)
      have hU := (pu_list_all_iff _ _).mp hL (classSwapMat g) hg'
      rw [pu_isUnimodularMat5_classSwap] at hU; exact hU
    rw [hR] at hT; exact Bool.noConfusion hT
  · rfl

private theorem pu_isUnimodularConfig_streamConfig (c : HoneycombConfig) :
    isUnimodularConfig (streamConfig c) = isUnimodularConfig c := by
  have hFin : ∀ x : Fin 24, x ∈ List.finRange 24 := fun x =>
    (pu_memBool_iff x (List.finRange 24)).mp ((by decide : ∀ y : Fin 24, memBool y (List.finRange 24) = true) x)
  have hExSlot : ∀ d : FullDock, d ≠ v1FullDock → ∃ a : Fin 24, d a ≠ .empty := fun d hne => by
    have hAll : ¬ (List.finRange 24).all (fun a => decide (d a = .empty)) = true := fun hall =>
      hne (funext fun a => of_decide_eq_true ((pu_list_all_iff _ _).mp hall a (hFin a)))
    have hWalk : ∀ xs : List (Fin 24), xs.all (fun a => decide (d a = .empty)) = false → ∃ a, a ∈ xs ∧ d a ≠ .empty := by
      intro xs; induction xs with
      | nil => intro h; exact Bool.noConfusion h
      | cons x rest ih =>
        intro h; simp only [List.all] at h
        cases hx : decide (d x = .empty) with
        | false => exact ⟨x, List.Mem.head rest, fun he => by rw [decide_eq_true he] at hx; exact Bool.noConfusion hx⟩
        | true =>
          rw [hx, Bool.true_and] at h
          obtain ⟨a, ha, hneA⟩ := ih h
          exact ⟨a, List.Mem.tail x ha, hneA⟩
    cases hB : (List.finRange 24).all (fun a => decide (d a = .empty)) with
    | true => exact absurd hB hAll
    | false => obtain ⟨a, _, hneA⟩ := hWalk (List.finRange 24) hB; exact ⟨a, hneA⟩
  unfold isUnimodularConfig
  cases hL : (streamConfig c).activeDocks.all isUnimodularMat5 <;> cases hR : c.activeDocks.all isUnimodularMat5
  · rfl
  · exfalso
    have hT : (streamConfig c).activeDocks.all isUnimodularMat5 = true := (pu_list_all_iff _ _).mpr fun g hg => by
      obtain ⟨a, ha⟩ := hExSlot ((streamConfig c).lookup g) ((pu_mem_activeDocks_iff _ _).mp hg)
      rw [pu_lookup_streamConfig] at ha
      have hIn : mat5Mul g (transport (oppSlot a)) ∈ c.activeDocks :=
        (pu_mem_activeDocks_iff c _).mpr (fun h0 => ha (congrFun h0 a))
      have hU := (pu_list_all_iff _ _).mp hR _ hIn
      rw [pu_isUnimodularMat5_mul_transport] at hU; exact hU
    rw [hL] at hT; exact Bool.noConfusion hT
  · exfalso
    have hT : c.activeDocks.all isUnimodularMat5 = true := (pu_list_all_iff _ _).mpr fun g hg => by
      obtain ⟨a, ha⟩ := hExSlot (c.lookup g) ((pu_mem_activeDocks_iff _ _).mp hg)
      have hLk : (streamConfig c).lookup (mat5Mul g (transport a)) a = c.lookup g a := by
        rw [pu_lookup_streamConfig, pu_mat5Mul_assoc, thm_coxeter_transport_antipodal_inverse.2 a, pu_mat5Mul_id_right]
      have hIn : mat5Mul g (transport a) ∈ (streamConfig c).activeDocks :=
        (pu_mem_activeDocks_iff _ _).mpr (fun h0 => ha (by rw [← hLk]; exact congrFun h0 a))
      have hU := (pu_list_all_iff _ _).mp hL _ hIn
      rw [pu_isUnimodularMat5_mul_transport] at hU; exact hU
    rw [hR] at hT; exact Bool.noConfusion hT
  · rfl

private theorem pu_isUnimodularConfig_streamConfigInv (c : HoneycombConfig) :
    isUnimodularConfig (streamConfigInv c) = isUnimodularConfig c := by
  rw [← pu_isUnimodularConfig_streamConfig (streamConfigInv c), (thm_fock_honeycomb_config_symmetries c).2.1]

private theorem pu_fockStream_preserves_unimodular (ψ : FockVec NinthLoc6 HoneycombConfig) (hψ : UnimodularState ψ) :
    UnimodularState (fockStream ψ) :=
  fun c hc => hψ (streamConfigInv c) (by rw [pu_isUnimodularConfig_streamConfigInv]; exact hc)

private theorem pu_totalCharge_jConfig (c : HoneycombConfig) : totalCharge (jConfig c) = -totalCharge c := by
  have hRevQ : ∀ d : FullDock, fullDockCharge (revFullDock d) = fullDockCharge d := fun d => by
    unfold fullDockCharge revFullDock
    change ((((((((((((((((((((((((0 + (d ⟨3, by decide⟩).charge) + (d ⟨2, by decide⟩).charge) + (d ⟨1, by decide⟩).charge) + (d ⟨0, by decide⟩).charge) +
      (d ⟨7, by decide⟩).charge) + (d ⟨6, by decide⟩).charge) + (d ⟨5, by decide⟩).charge) + (d ⟨4, by decide⟩).charge) +
      (d ⟨11, by decide⟩).charge) + (d ⟨10, by decide⟩).charge) + (d ⟨9, by decide⟩).charge) + (d ⟨8, by decide⟩).charge) +
      (d ⟨15, by decide⟩).charge) + (d ⟨14, by decide⟩).charge) + (d ⟨13, by decide⟩).charge) + (d ⟨12, by decide⟩).charge) +
      (d ⟨19, by decide⟩).charge) + (d ⟨18, by decide⟩).charge) + (d ⟨17, by decide⟩).charge) + (d ⟨16, by decide⟩).charge) +
      (d ⟨23, by decide⟩).charge) + (d ⟨22, by decide⟩).charge) + (d ⟨21, by decide⟩).charge) + (d ⟨20, by decide⟩).charge) =
      ((((((((((((((((((((((((0 + (d ⟨0, by decide⟩).charge) + (d ⟨1, by decide⟩).charge) + (d ⟨2, by decide⟩).charge) + (d ⟨3, by decide⟩).charge) +
      (d ⟨4, by decide⟩).charge) + (d ⟨5, by decide⟩).charge) + (d ⟨6, by decide⟩).charge) + (d ⟨7, by decide⟩).charge) +
      (d ⟨8, by decide⟩).charge) + (d ⟨9, by decide⟩).charge) + (d ⟨10, by decide⟩).charge) + (d ⟨11, by decide⟩).charge) +
      (d ⟨12, by decide⟩).charge) + (d ⟨13, by decide⟩).charge) + (d ⟨14, by decide⟩).charge) + (d ⟨15, by decide⟩).charge) +
      (d ⟨16, by decide⟩).charge) + (d ⟨17, by decide⟩).charge) + (d ⟨18, by decide⟩).charge) + (d ⟨19, by decide⟩).charge) +
      (d ⟨20, by decide⟩).charge) + (d ⟨21, by decide⟩).charge) + (d ⟨22, by decide⟩).charge) + (d ⟨23, by decide⟩).charge)
    omega
  have hDockQ : ∀ d : FullDock, fullDockCharge (conjFullDock (revFullDock d)) = -fullDockCharge d := fun d => by
    have hEq : ∀ x : FullDock, fullDockCharge x = dockCharge (fullDockToDockState x) := fun x => by
      unfold fullDockCharge dockCharge fullDockToDockState
      have hF : (fun acc (i : Fin 24) => acc + (x i).charge) = (fun acc (i : Fin 24) => acc + (x i).tone.value) := by
        funext acc i; cases x i with | empty => rfl | occ s _ => cases s <;> rfl
      rw [hF]
    have hT : fullDockToDockState (conjFullDock (revFullDock d)) = conjDock (fullDockToDockState (revFullDock d)) := by
      funext i; unfold fullDockToDockState conjFullDock conjDock; dsimp only
      cases revFullDock d i with | empty => rfl | occ s _ => cases s <;> rfl
    rw [hEq, hT, dockCharge_conj, ← hEq, hRevQ]
  have hErase : ∀ (a : Mat5) (xs : List Mat5) (f : Mat5 → Int), a ∈ xs →
      fockSumInt xs f = f a + fockSumInt (eraseOne a xs) f := by
    intro a xs f; induction xs with
    | nil => intro h; cases h
    | cons x rest ih =>
      intro hm; simp only [eraseOne, fockSumInt]
      if hxa : x = a then rw [ite_eq_left hxa, hxa]
      else
        rw [ite_eq_right hxa]; simp only [fockSumInt]
        cases hm with | head => exact absurd rfl hxa | tail _ h' => rw [ih h']; omega
  have hPerm : ∀ (s₁ s₂ : List Mat5) (f : Mat5 → Int), IsNodup s₁ → IsNodup s₂ →
      (∀ x, x ∈ s₁ ↔ x ∈ s₂) → fockSumInt s₁ f = fockSumInt s₂ f := by
    intro s₁ s₂ f h1; induction h1 generalizing s₂ with
    | nil => intro _ hm; cases s₂ with | nil => rfl | cons x _ => cases (hm x).mpr (List.Mem.head _)
    | @cons a rest hnot _ ih =>
      intro h2 hm; rw [hErase a s₂ f ((hm a).mp (List.Mem.head rest))]; simp only [fockSumInt]
      rw [ih (eraseOne a s₂) (pu_isNodup_eraseOne a h2) (fun x => by
        rw [pu_mem_eraseOne_iff a x h2]
        exact ⟨fun hx => ⟨(hm x).mp (List.Mem.tail a hx), fun e => by rw [e] at hx; exact hnot hx⟩,
          fun ⟨hx2, hne⟩ => match (hm x).mpr hx2 with | List.Mem.head _ => absurd rfl hne | List.Mem.tail _ h' => h'⟩)]
  have hMap : ∀ (xs : List Mat5) (f : Mat5 → Int), fockSumInt (xs.map classSwapMat) f = fockSumInt xs (fun g => f (classSwapMat g)) := by
    intro xs f; induction xs with | nil => rfl | cons x rest ih => simp only [List.map, fockSumInt]; rw [ih]
  have hNeg : ∀ (xs : List Mat5) (f : Mat5 → Int), fockSumInt xs (fun g => -f g) = -fockSumInt xs f := by
    intro xs f; induction xs with | nil => rfl | cons x rest ih => simp only [fockSumInt]; rw [ih]; omega
  have hCongr : ∀ (xs : List Mat5) (f g : Mat5 → Int), (∀ x, f x = g x) → fockSumInt xs f = fockSumInt xs g := by
    intro xs f g h; have hf : f = g := funext h; rw [hf]
  have hMapNd : IsNodup (c.activeDocks.map classSwapMat) :=
    pu_isNodup_map_inj classSwapMat (fun x y h => by have := congrArg classSwapMat h; rw [pu_classSwapMat_inv, pu_classSwapMat_inv] at this; exact this) (pu_activeDocks_nodup c)
  unfold totalCharge
  rw [hPerm (jConfig c).activeDocks (c.activeDocks.map classSwapMat) _ (pu_activeDocks_nodup (jConfig c)) hMapNd (fun g => by
    rw [pu_mem_activeDocks_jConfig, pu_mem_map_iff]
    exact ⟨fun h => ⟨classSwapMat g, h, pu_classSwapMat_inv g⟩, fun ⟨x, hx, hxg⟩ => by rw [← hxg, pu_classSwapMat_inv]; exact hx⟩)]
  rw [hMap, hCongr c.activeDocks _ (fun g => -fullDockCharge (c.lookup g)) (fun g => by
    rw [pu_lookup_jConfig, pu_classSwapMat_inv, hDockQ]), hNeg]

/-- Headline Theorem 7 (Exact Infinite-Honeycomb Configuration Neutrality Involution `J = L ∘ C`):
    On ALL canonical finite-excitation configurations over infinite `{3,4,3,4}`, `L^2 = I`, `L ∘ S = S ∘ L`,
    `J^2 = I`, `totalCharge (J c) = -totalCharge c`, `J v1Config = v1Config`, `J ∘ S = S ∘ J`,
    and both `J` and `S` preserve unimodularity identically. -/
theorem thm_pu_infinite_mesh_J_config_neutrality (c : HoneycombConfig) :
    lConfig (lConfig c) = c ∧
    lConfig (streamConfig c) = streamConfig (lConfig c) ∧
    jConfig (jConfig c) = c ∧
    totalCharge (jConfig c) = -totalCharge c ∧
    jConfig v1Config = v1Config ∧
    jConfig (streamConfig c) = streamConfig (jConfig c) ∧
    isUnimodularConfig (jConfig c) = isUnimodularConfig c ∧
    isUnimodularConfig (streamConfig c) = isUnimodularConfig c :=
  ⟨pu_lConfig_inv c, pu_lConfig_streamConfig c, pu_jConfig_inv c, pu_totalCharge_jConfig c, pu_jConfig_v1,
   pu_jConfig_streamConfig c, pu_isUnimodularConfig_jConfig c, pu_isUnimodularConfig_streamConfig c⟩

/-! ### Exact Commutation of `fockJ` with ALL 8 Layers of `fockBeat χ` on Infinite `{3,4,3,4}` -/

private theorem pu_applySites_zero (F : LocalSiteFamily) (gs : List Mat5) :
    applySites F gs zeroVec = zeroVec := by
  induction gs with | nil => rfl | cons g rest ih => simp only [applySites]; rw [ih, F.op_zero]

private theorem pu_applySites_local_eq (F : LocalSiteFamily) (gs : List Mat5)
    (ψ₁ ψ₂ : FockVec NinthLoc6 HoneycombConfig) (c : HoneycombConfig)
    (h : ∀ c' : HoneycombConfig, c'.activeDocks = c.activeDocks → ψ₁ c' = ψ₂ c') :
    applySites F gs ψ₁ c = applySites F gs ψ₂ c := by
  induction gs generalizing c with
  | nil => exact h c rfl
  | cons g rest ih =>
    simp only [applySites]
    exact F.local_eq g _ _ c (fun c' hc' _ => ih c' (fun c'' hc'' => h c'' (hc''.trans hc')))

private theorem pu_applySites_perm (F : LocalSiteFamily) (xs : List Mat5) (h1 : IsNodup xs)
    (ψ : FockVec NinthLoc6 HoneycombConfig) :
    ∀ (ys : List Mat5), IsNodup ys → (∀ g, g ∈ xs ↔ g ∈ ys) →
      applySites F xs ψ = applySites F ys ψ := by
  have hErase : ∀ (g : Mat5) (gs : List Mat5) (φ : FockVec NinthLoc6 HoneycombConfig),
      g ∈ gs → applySites F gs φ = (F.unit g).op (applySites F (eraseOne g gs) φ) := by
    intro g gs; induction gs with
    | nil => intro _ h; cases h
    | cons x rest ih =>
      intro φ hmem; simp only [eraseOne, applySites]
      if hxg : x = g then rw [ite_eq_left hxg, hxg]
      else
        rw [ite_eq_right hxg]; simp only [applySites]
        cases hmem with | head => exact absurd rfl hxg | tail _ h' => rw [ih φ h', F.comm_sites x g _ hxg]
  induction h1 with
  | nil => intro ys _ hm; cases ys with | nil => rfl | cons y _ => cases (hm y).mpr (List.Mem.head _)
  | @cons g rest hnot _ ih =>
    intro ys h2 hm
    rw [hErase g ys ψ ((hm g).mp (List.Mem.head rest))]; simp only [applySites]
    apply congrArg (F.unit g).op
    exact ih (eraseOne g ys) (pu_isNodup_eraseOne g h2) (fun x => by
      rw [pu_mem_eraseOne_iff g x h2]
      exact ⟨fun hx => ⟨(hm x).mp (List.Mem.tail g hx), fun e => by rw [e] at hx; exact hnot hx⟩,
        fun ⟨hy, hne⟩ => match (hm x).mpr hy with | List.Mem.head _ => absurd rfl hne | List.Mem.tail _ h' => h'⟩)

private theorem pu_globalOp_J_of_site {F : LocalSiteFamily} (P : Mat5 → Prop)
    (hP : ∀ g, P (classSwapMat g) ↔ P g)
    (hSite : ∀ g φ c, P g → fockJ ((F.unit g).op φ) c = (F.unit (classSwapMat g)).op (fockJ φ) c)
    (ψ : FockVec NinthLoc6 HoneycombConfig) (c : HoneycombConfig)
    (hc : ∀ g, g ∈ c.activeDocks → P g) :
    fockJ (globalOp F ψ) c = globalOp F (fockJ ψ) c := by
  have hMap : ∀ (gs : List Mat5), (∀ g, g ∈ gs → P g) →
      ∀ φ, fockJ (applySites F gs φ) = applySites F (gs.map classSwapMat) (fockJ φ) := by
    intro gs; induction gs with
    | nil => intro _ _; rfl
    | cons g rest ih =>
      intro hgs φ; simp only [List.map, applySites]; funext c'
      rw [hSite g (applySites F rest φ) c' (hgs g (List.Mem.head rest)), ih (fun x hx => hgs x (List.Mem.tail g hx)) φ]
  have hActP : ∀ g, g ∈ (jConfig c).activeDocks → P g := fun g hg =>
    (hP g).mp (hc (classSwapMat g) ((pu_mem_activeDocks_jConfig c g).mp hg))
  have hMapNd : IsNodup ((jConfig c).activeDocks.map classSwapMat) :=
    pu_isNodup_map_inj classSwapMat (fun x y h => by have := congrArg classSwapMat h; rw [pu_classSwapMat_inv, pu_classSwapMat_inv] at this; exact this)
      (pu_activeDocks_nodup (jConfig c))
  have hSame : ∀ g, g ∈ (jConfig c).activeDocks.map classSwapMat ↔ g ∈ c.activeDocks := fun g => by
    rw [pu_mem_map_iff]
    exact ⟨fun ⟨x, hx, hxg⟩ => by rw [← hxg]; exact (pu_mem_activeDocks_jConfig c x).mp hx,
      fun hg => ⟨classSwapMat g, (pu_mem_activeDocks_jConfig c _).mpr (by rw [pu_classSwapMat_inv]; exact hg), pu_classSwapMat_inv g⟩⟩
  change fockJ (applySites F (jConfig c).activeDocks ψ) c = applySites F c.activeDocks (fockJ ψ) c
  rw [congrFun (hMap (jConfig c).activeDocks hActP ψ) c,
      pu_applySites_perm F _ hMapNd (fockJ ψ) c.activeDocks (pu_activeDocks_nodup c) hSame]

private theorem pu_globalOp_preserves_unimodular {F : LocalSiteFamily}
    (ψ : FockVec NinthLoc6 HoneycombConfig) (hψ : UnimodularState ψ) :
    UnimodularState (globalOp F ψ) := by
  intro c hc; unfold globalOp
  rw [pu_applySites_local_eq F c.activeDocks ψ zeroVec c (fun c' hc' => hψ c' (by unfold isUnimodularConfig; rw [hc']; exact hc)),
      pu_applySites_zero]; rfl

private theorem pu_fockJ_id :
    ∀ φ : FockVec NinthLoc6 HoneycombConfig,
      fockJ ((FockUnitary.id (R := NinthLoc6) (α := HoneycombConfig)).op φ) =
        (FockUnitary.id (R := NinthLoc6) (α := HoneycombConfig)).op (fockJ φ) :=
  fun _ => rfl

private theorem pu_fockJ_comp {u₁ u₂ v₁ v₂ : FockUnitary NinthLoc6 HoneycombConfig}
    (h1 : ∀ φ, fockJ (u₁.op φ) = v₁.op (fockJ φ))
    (h2 : ∀ φ, fockJ (u₂.op φ) = v₂.op (fockJ φ)) :
    ∀ φ, fockJ ((FockUnitary.comp u₁ u₂).op φ) = (FockUnitary.comp v₁ v₂).op (fockJ φ) := fun φ => by
  change fockJ (u₁.op (u₂.op φ)) = v₁.op (v₂.op (fockJ φ))
  rw [h1, h2]

private theorem pu_fockJ_comp_uni {u v : FockUnitary NinthLoc6 HoneycombConfig}
    (hu : ∀ φ, UnimodularState φ → fockJ (u.op φ) = u.op (fockJ φ))
    (hv : ∀ φ, UnimodularState φ → fockJ (v.op φ) = v.op (fockJ φ))
    (hvU : ∀ φ, UnimodularState φ → UnimodularState (v.op φ)) :
    ∀ φ, UnimodularState φ → fockJ ((FockUnitary.comp u v).op φ) = (FockUnitary.comp u v).op (fockJ φ) :=
  fun φ hφ => by
    change fockJ (u.op (v.op φ)) = u.op (v.op (fockJ φ))
    rw [hu (v.op φ) (hvU φ hφ), hv φ hφ]

private theorem pu_fockJ_phase {p₁ p₂ : HoneycombConfig → NinthLoc6}
    {hu₁ : ∀ c : HoneycombConfig, StarCommRing.mul (StarCommRing.conj (p₁ c)) (p₁ c) = StarCommRing.one}
    {hu₂ : ∀ c : HoneycombConfig, StarCommRing.mul (StarCommRing.conj (p₂ c)) (p₂ c) = StarCommRing.one}
    (hp : ∀ c : HoneycombConfig, p₁ (jConfig c) = p₂ c) :
    ∀ φ : FockVec NinthLoc6 HoneycombConfig,
      fockJ ((phaseUnitary (R := NinthLoc6) p₁ hu₁).op φ) =
        (phaseUnitary (R := NinthLoc6) p₂ hu₂).op (fockJ φ) := fun φ => by
  funext c
  change NinthLoc6.mul (p₁ (jConfig c)) (φ (jConfig c)) = NinthLoc6.mul (p₂ c) (φ (jConfig c))
  rw [hp]

private theorem pu_fockJ_perm {π₁ π₁' π₂ π₂' : HoneycombConfig → HoneycombConfig}
    {h1a : ∀ c, π₁' (π₁ c) = c} {h1b : ∀ c, π₁ (π₁' c) = c}
    {h2a : ∀ c, π₂' (π₂ c) = c} {h2b : ∀ c, π₂ (π₂' c) = c}
    (hπ : ∀ c : HoneycombConfig, π₁' (jConfig c) = jConfig (π₂' c)) :
    ∀ φ : FockVec NinthLoc6 HoneycombConfig,
      fockJ ((permUnitary (R := NinthLoc6) π₁ π₁' h1a h1b).op φ) =
        (permUnitary (R := NinthLoc6) π₂ π₂' h2a h2b).op (fockJ φ) := fun φ => by
  funext c
  change φ (π₁' (jConfig c)) = φ (jConfig (π₂' c))
  rw [hπ]

private theorem pu_fockJ_block2 {f₁ f₂ : HoneycombConfig → HoneycombConfig}
    {a₁ a₂ : HoneycombConfig → Bool} {x y : NinthLoc6}
    {hf1 : ∀ c, f₁ (f₁ c) = c} {ha1 : ∀ c, a₁ (f₁ c) = a₁ c}
    {hd1 : StarCommRing.add (StarCommRing.mul (StarCommRing.conj x) x) (StarCommRing.mul (StarCommRing.conj y) y) = StarCommRing.one}
    {ho1 : StarCommRing.add (StarCommRing.mul (StarCommRing.conj x) y) (StarCommRing.mul (StarCommRing.conj y) x) = StarCommRing.zero}
    {hf2 : ∀ c, f₂ (f₂ c) = c} {ha2 : ∀ c, a₂ (f₂ c) = a₂ c}
    {hd2 : StarCommRing.add (StarCommRing.mul (StarCommRing.conj x) x) (StarCommRing.mul (StarCommRing.conj y) y) = StarCommRing.one}
    {ho2 : StarCommRing.add (StarCommRing.mul (StarCommRing.conj x) y) (StarCommRing.mul (StarCommRing.conj y) x) = StarCommRing.zero}
    (hf : ∀ c : HoneycombConfig, f₁ (jConfig c) = jConfig (f₂ c))
    (ha : ∀ c : HoneycombConfig, a₁ (jConfig c) = a₂ c) :
    ∀ φ : FockVec NinthLoc6 HoneycombConfig,
      fockJ ((block2Unitary (R := NinthLoc6) f₁ a₁ x y hf1 ha1 hd1 ho1).op φ) =
        (block2Unitary (R := NinthLoc6) f₂ a₂ x y hf2 ha2 hd2 ho2).op (fockJ φ) := fun φ => by
  funext c
  change (if a₁ (jConfig c) = true then NinthLoc6.add (NinthLoc6.mul x (φ (jConfig c))) (NinthLoc6.mul y (φ (f₁ (jConfig c)))) else φ (jConfig c)) =
    (if a₂ c = true then NinthLoc6.add (NinthLoc6.mul x (φ (jConfig c))) (NinthLoc6.mul y (φ (jConfig (f₂ c)))) else φ (jConfig c))
  rw [ha, hf]

private theorem pu_swapLineSlotsConfig_jConfig (g : Mat5) (l : Fin 12) (c : HoneycombConfig) :
    swapLineSlotsConfig g l (jConfig c) = jConfig (swapLineSlotsConfig (classSwapMat g) l c) := by
  have ⟨hAB, hBA, hne⟩ := pu_line_geom l
  unfold swapLineSlotsConfig; rw [pu_jConfig_setDock, pu_classSwapMat_inv, pu_lookup_jConfig]
  apply congrArg ((jConfig c).setDock g); funext s; simp only [swapLineSlotsDock, conjFullDock, revFullDock]
  if hA : s = lineA l then
    simp only [hA, hAB, hBA, ite_true, ite_eq_right hne.symm]
  else if hB : s = lineB l then
    simp only [hB, hAB, hBA, ite_eq_right hne.symm, ite_true]
  else
    have hOA : oppSlot s ≠ lineA l := fun e => hB (by rw [← (thm_24_facets_geometry.2.1 s).1, e, hAB])
    have hOB : oppSlot s ≠ lineB l := fun e => hA (by rw [← (thm_24_facets_geometry.2.1 s).1, e, hBA])
    simp only [ite_eq_right hA, ite_eq_right hB, ite_eq_right hOA, ite_eq_right hOB]

private theorem pu_swapLineRolesConfig_jConfig (g : Mat5) (l : Fin 12) (c : HoneycombConfig) :
    swapLineRolesConfig g l (jConfig c) = jConfig (swapLineRolesConfig (classSwapMat g) l c) := by
  have ⟨hAB, hBA, hne⟩ := pu_line_geom l
  unfold swapLineRolesConfig; rw [pu_jConfig_setDock, pu_classSwapMat_inv, pu_lookup_jConfig]
  apply congrArg ((jConfig c).setDock g); funext s; simp only [swapLineRolesDock, conjFullDock, revFullDock]
  rw [hAB, hBA]
  cases c.lookup (classSwapMat g) (lineA l) with
  | empty =>
    cases c.lookup (classSwapMat g) (lineB l) with
    | empty => rfl
    | occ sB _ => cases sB <;> rfl
  | occ sA rA =>
    cases c.lookup (classSwapMat g) (lineB l) with
    | empty => cases sA <;> rfl
    | occ sB rB =>
      cases sA <;> cases sB <;> dsimp only [SlotState.dual, Sign.neg]
      all_goals
        if hA : s = lineA l then
          simp only [hA, hAB, ite_true, ite_eq_right hne.symm]
        else if hB : s = lineB l then
          simp only [hB, hBA, ite_eq_right hne.symm, ite_true]
        else
          have hOA : oppSlot s ≠ lineA l := fun e => hB (by rw [← (thm_24_facets_geometry.2.1 s).1, e, hAB])
          have hOB : oppSlot s ≠ lineB l := fun e => hA (by rw [← (thm_24_facets_geometry.2.1 s).1, e, hBA])
          simp only [ite_eq_right hA, ite_eq_right hB, ite_eq_right hOA, ite_eq_right hOB]

private theorem pu_jDock_preserves_solePair (d : FullDock) :
    findSolePairLine (conjFullDock (revFullDock d)) = findSolePairLine d ∧
    isSoleIdentPairDock (conjFullDock (revFullDock d)) = isSoleIdentPairDock d ∧
    (∀ m : Fin 12, conjFullDock (revFullDock (moveSolePairDock m d)) = moveSolePairDock m (conjFullDock (revFullDock d))) := by
  have hFin24 : ∀ x : Fin 24, x ∈ List.finRange 24 := fun x =>
    (pu_memBool_iff x (List.finRange 24)).mp ((by decide : ∀ y : Fin 24, memBool y (List.finRange 24) = true) x)
  have hEm : ∀ x : SlotState, (x.dual = .empty) ↔ (x = .empty) := fun x => by
    cases x with | empty => exact Iff.rfl | occ sx _ => cases sx <;> exact ⟨fun h => SlotState.noConfusion h, fun h => SlotState.noConfusion h⟩
  have hAt : ∀ l : Fin 12, isSoleIdentPairAt (conjFullDock (revFullDock d)) l = isSoleIdentPairAt d l := fun l => by
    have ⟨hAB, hBA, _⟩ := pu_line_geom l
    simp only [isSoleIdentPairAt, isSameSignEqRoleLine, conjFullDock, revFullDock]
    rw [hAB, hBA]
    have h1 : (match (d (lineB l)).dual, (d (lineA l)).dual with | .occ sA rA, .occ sB rB => decide (sA = sB ∧ rA = rB) | _, _ => false) =
        (match d (lineA l), d (lineB l) with | .occ sA rA, .occ sB rB => decide (sA = sB ∧ rA = rB) | _, _ => false) := by
      cases d (lineA l) with
      | empty =>
        cases d (lineB l) with
        | empty => rfl
        | occ sB _ => cases sB <;> rfl
      | occ sA rA =>
        cases d (lineB l) with
        | empty => cases sA <;> rfl
        | occ sB rB => cases sA <;> cases sB <;> cases rA <;> cases rB <;> decide
    have h2 : (List.finRange 24).all (fun s => decide (s = lineA l ∨ s = lineB l ∨ (d (oppSlot s)).dual = .empty)) =
        (List.finRange 24).all (fun s => decide (s = lineA l ∨ s = lineB l ∨ d s = .empty)) := by
      cases hL : (List.finRange 24).all (fun s => decide (s = lineA l ∨ s = lineB l ∨ (d (oppSlot s)).dual = .empty)) <;>
      cases hR : (List.finRange 24).all (fun s => decide (s = lineA l ∨ s = lineB l ∨ d s = .empty))
      · rfl
      · exfalso
        have hall := (pu_list_all_iff _ _).mp hR
        have hT : (List.finRange 24).all (fun s => decide (s = lineA l ∨ s = lineB l ∨ (d (oppSlot s)).dual = .empty)) = true :=
          (pu_list_all_iff _ _).mpr fun s _ => by
            rcases of_decide_eq_true (hall (oppSlot s) (hFin24 _)) with hA | hB | hE
            · exact decide_eq_true (Or.inr (Or.inl (by rw [← (thm_24_facets_geometry.2.1 s).1, hA, hAB])))
            · exact decide_eq_true (Or.inl (by rw [← (thm_24_facets_geometry.2.1 s).1, hB, hBA]))
            · exact decide_eq_true (Or.inr (Or.inr ((hEm _).mpr hE)))
        rw [hL] at hT; exact Bool.noConfusion hT
      · exfalso
        have hall := (pu_list_all_iff _ _).mp hL
        have hT : (List.finRange 24).all (fun s => decide (s = lineA l ∨ s = lineB l ∨ d s = .empty)) = true :=
          (pu_list_all_iff _ _).mpr fun s _ => by
            have h0 := hall (oppSlot s) (hFin24 _)
            rw [(thm_24_facets_geometry.2.1 s).1] at h0
            rcases of_decide_eq_true h0 with hA | hB | hE
            · exact decide_eq_true (Or.inr (Or.inl (by rw [← (thm_24_facets_geometry.2.1 s).1, hA, hAB])))
            · exact decide_eq_true (Or.inl (by rw [← (thm_24_facets_geometry.2.1 s).1, hB, hBA]))
            · exact decide_eq_true (Or.inr (Or.inr ((hEm _).mp hE)))
        rw [hR] at hT; exact Bool.noConfusion hT
      · rfl
    have hAnd : ∀ a b c d : Bool, a = b → c = d → (a && c) = (b && d) := by intro a b c d ha hb; rw [ha, hb]
    exact hAnd _ _ _ _ h1 h2
  have hFind : findSolePairLine (conjFullDock (revFullDock d)) = findSolePairLine d := by
    unfold findSolePairLine; have hF : (fun l => isSoleIdentPairAt (conjFullDock (revFullDock d)) l) = (fun l => isSoleIdentPairAt d l) := funext hAt; rw [hF]
  have hFindSpec : ∀ (p : Fin 12 → Bool) (xs : List (Fin 12)) (l : Fin 12), xs.find? p = some l → p l = true := by
    intro p xs; induction xs with
    | nil => intro _ h; cases h
    | cons x rest ih =>
      intro l h; simp only [List.find?] at h
      cases hx : p x with
      | true => rw [hx] at h; cases h; exact hx
      | false => rw [hx] at h; exact ih l h
  refine ⟨hFind, by unfold isSoleIdentPairDock; rw [hFind], fun m => ?_⟩
  funext s; unfold moveSolePairDock; rw [hFind]
  cases hf : findSolePairLine d with
  | none => rfl
  | some l =>
    have hl : isSoleIdentPairAt d l = true := hFindSpec (isSoleIdentPairAt d) (List.finRange 12) l hf
    have hSame : isSameSignEqRoleLine d l = true := ((Bool.and_eq_true _ _).mp hl).1
    have hEqAB : d (lineB l) = d (lineA l) := by
      unfold isSameSignEqRoleLine at hSame
      cases hA : d (lineA l) <;> cases hB : d (lineB l) <;> rw [hA, hB] at hSame
      all_goals try exact Bool.noConfusion hSame
      have ⟨hs, hr⟩ := of_decide_eq_true hSame; rw [hs, hr]
    simp only [conjFullDock, revFullDock]
    rw [(pu_line_geom l).1, hEqAB]
    have ⟨hmAB, hmBA, _⟩ := pu_line_geom m
    if hs : s = lineA m ∨ s = lineB m then
      have hO : oppSlot s = lineA m ∨ oppSlot s = lineB m := by
        rcases hs with h1 | h2
        · exact Or.inr (by rw [h1, hmAB])
        · exact Or.inl (by rw [h2, hmBA])
      simp only [ite_eq_left hO, ite_eq_left hs]
    else
      have hO : ¬ (oppSlot s = lineA m ∨ oppSlot s = lineB m) := fun h => hs (by
        rcases h with h1 | h2
        · exact Or.inr (by rw [← (thm_24_facets_geometry.2.1 s).1, h1, hmAB])
        · exact Or.inl (by rw [← (thm_24_facets_geometry.2.1 s).1, h2, hmBA]))
      simp only [ite_eq_right hO, ite_eq_right hs]; rfl

/-- Headline Theorem 8 (Exact Infinite-Honeycomb Involutive Neutrality `J = L ∘ C` Commuting with `fockBeat` `∀ t`):
    `fockJ` (built from connected-honeycomb `L(g) = F_0 * g * Z` paired with `R` and `C`) is an involution fixing
    `|V_1⟩` and negating charge sectors (`Q ↦ -Q`), commutes unconditionally with `S, K, M_pair, M_meet, D`,
    preserves `UnimodularState` through `fockBeat χ`, and commutes identically with `Φ_odd`, `fockBeat χ`,
    and ALL iterated powers `iter (fockBeat χ) t` (`∀ t : Nat`) on every `UnimodularState` for EVERY `C`-odd `ChiralInvariant χ`. -/
theorem thm_pu_infinite_mesh_involutive_neutrality (χ : ChiralInvariant)
    (hCodd : ∀ d : FullDock, χ.chi (conjFullDock d) = -χ.chi d) :
    (∀ ψ, fockJ (fockJ ψ) = ψ) ∧
    fockJ (ket (R := NinthLoc6) v1Config) = ket (R := NinthLoc6) v1Config ∧
    (∀ (q : Int) (ψ : FockVec NinthLoc6 HoneycombConfig), InChargeSector q ψ → InChargeSector (-q) (fockJ ψ)) ∧
    (∀ ψ, fockJ (fockStream ψ) = fockStream (fockJ ψ)) ∧
    (∀ ψ, fockJ (fockBounceK ψ) = fockBounceK (fockJ ψ)) ∧
    (∀ ψ, fockJ (fockMPair ψ) = fockMPair (fockJ ψ)) ∧
    (∀ ψ, fockJ (fockMeet ψ) = fockMeet (fockJ ψ)) ∧
    (∀ ψ, fockJ (fockHalfCoin ψ) = fockHalfCoin (fockJ ψ)) ∧
    (∀ ψ, UnimodularState ψ → fockJ (fockPhiOdd χ ψ) = fockPhiOdd χ (fockJ ψ)) ∧
    (∀ ψ, UnimodularState ψ → UnimodularState (fockBeat χ ψ)) ∧
    (∀ ψ, UnimodularState ψ → fockJ (fockBeat χ ψ) = fockBeat χ (fockJ ψ)) ∧
    (∀ (t : Nat) (ψ : FockVec NinthLoc6 HoneycombConfig), UnimodularState ψ →
      fockJ (iter (fockBeat χ) t ψ) = iter (fockBeat χ) t (fockJ ψ)) := by
  have hJ2 : ∀ ψ, fockJ (fockJ ψ) = ψ := fun ψ => by funext c; unfold fockJ; rw [pu_jConfig_inv]
  have hJV1 : fockJ (ket (R := NinthLoc6) v1Config) = ket (R := NinthLoc6) v1Config := by
    funext c; unfold fockJ ket
    if hc : c = v1Config then rw [hc, pu_jConfig_v1]
    else
      have hne : jConfig c ≠ v1Config := fun h0 => hc (by rw [← pu_jConfig_inv c, h0, pu_jConfig_v1])
      rw [ite_eq_right hne, ite_eq_right hc]
  have hJQ : ∀ (q : Int) (ψ : FockVec NinthLoc6 HoneycombConfig), InChargeSector q ψ → InChargeSector (-q) (fockJ ψ) :=
    fun q ψ hψ c hc => hψ (jConfig c) (by rw [pu_totalCharge_jConfig]; omega)
  have hJS : ∀ ψ, fockJ (fockStream ψ) = fockStream (fockJ ψ) := fun ψ => by
    funext c
    change ψ (streamConfigInv (jConfig c)) = ψ (jConfig (streamConfigInv c))
    have h1 : streamConfig (streamConfigInv (jConfig c)) = streamConfig (jConfig (streamConfigInv c)) := by
      rw [(thm_fock_honeycomb_config_symmetries _).2.1, ← pu_jConfig_streamConfig, (thm_fock_honeycomb_config_symmetries _).2.1]
    have h2 := congrArg streamConfigInv h1
    rw [(thm_fock_honeycomb_config_symmetries _).1, (thm_fock_honeycomb_config_symmetries _).1] at h2
    rw [h2]
  have hJK : ∀ ψ, fockJ (fockBounceK ψ) = fockBounceK (fockJ ψ) := fun ψ => by
    funext c; refine pu_globalOp_J_of_site (fun _ => True) (fun _ => Iff.rfl) ?_ ψ c (fun _ _ => trivial)
    intro g φ c' _
    refine congrFun ?_ c'
    have hOpp : ∀ (l : Fin 12) (x : HoneycombConfig),
        isOppSignLine ((jConfig x).lookup g) l = isOppSignLine (x.lookup (classSwapMat g)) l := fun l x => by
      rw [pu_lookup_jConfig]; simp only [isOppSignLine, conjFullDock, revFullDock]
      rw [(pu_line_geom l).1, (pu_line_geom l).2.1]
      cases x.lookup (classSwapMat g) (lineA l) with
      | empty =>
        cases x.lookup (classSwapMat g) (lineB l) with
        | empty => rfl
        | occ sB _ => cases sB <;> rfl
      | occ sA _ =>
        cases x.lookup (classSwapMat g) (lineB l) with
        | empty => cases sA <;> rfl
        | occ sB _ => cases sA <;> cases sB <;> rfl
    have hPh : ∀ (l : Fin 12) (x : HoneycombConfig),
        (if isOppSignLine ((jConfig x).lookup g) l = true then NinthLoc6.neg NinthLoc6.one else NinthLoc6.one) =
          (if isOppSignLine (x.lookup (classSwapMat g)) l = true then NinthLoc6.neg NinthLoc6.one else NinthLoc6.one) :=
      fun l x => by rw [hOpp l x]
    have hPm : ∀ (l : Fin 12) (x : HoneycombConfig),
        (if isOppSignLine ((jConfig x).lookup g) l = true then swapLineSlotsConfig g l (jConfig x) else jConfig x) =
          jConfig (if isOppSignLine (x.lookup (classSwapMat g)) l = true then swapLineSlotsConfig (classSwapMat g) l x else x) :=
      fun l x => by
        rw [hOpp l x]
        cases isOppSignLine (x.lookup (classSwapMat g)) l with
        | false => rfl
        | true => exact pu_swapLineSlotsConfig_jConfig g l x
    refine pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_
      (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_
      (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_
        pu_fockJ_id))))))))))) φ
    all_goals
      refine pu_fockJ_comp ?_ ?_
      · refine pu_fockJ_phase ?_; exact hPh _
      · refine pu_fockJ_perm ?_; exact hPm _
  have hJMPair : ∀ ψ, fockJ (fockMPair ψ) = fockMPair (fockJ ψ) := fun ψ => by
    funext c; refine pu_globalOp_J_of_site (fun _ => True) (fun _ => Iff.rfl) ?_ ψ c (fun _ _ => trivial)
    intro g φ c' _
    change (if isSoleIdentPairDock ((jConfig c').lookup g) = true then
        NinthLoc6.add (φ (jConfig c')) (NinthLoc6.mul NinthLoc6.pairHop (sumFin12 (fun m => φ (moveSolePairConfig g m (jConfig c')))))
      else φ (jConfig c')) =
      (if isSoleIdentPairDock (c'.lookup (classSwapMat g)) = true then
        NinthLoc6.add (φ (jConfig c')) (NinthLoc6.mul NinthLoc6.pairHop (sumFin12 (fun m => φ (jConfig (moveSolePairConfig (classSwapMat g) m c')))))
      else φ (jConfig c'))
    rw [pu_lookup_jConfig, (pu_jDock_preserves_solePair _).2.1]
    have hMove : (fun m => φ (moveSolePairConfig g m (jConfig c'))) =
        (fun m => φ (jConfig (moveSolePairConfig (classSwapMat g) m c'))) := by
      funext m; apply congrArg φ
      unfold moveSolePairConfig; rw [pu_jConfig_setDock, pu_classSwapMat_inv, pu_lookup_jConfig, (pu_jDock_preserves_solePair _).2.2 m]
    rw [hMove]
  have hJMeet : ∀ ψ, fockJ (fockMeet ψ) = fockMeet (fockJ ψ) := fun ψ => by
    funext c; refine pu_globalOp_J_of_site (fun _ => True) (fun _ => Iff.rfl) ?_ ψ c (fun _ _ => trivial)
    intro g φ c' _
    refine congrFun ?_ c'
    have hEqR : ∀ (l : Fin 12) (x : HoneycombConfig),
        isSameSignEqRoleLine ((jConfig x).lookup g) l = isSameSignEqRoleLine (x.lookup (classSwapMat g)) l := fun l x => by
      rw [pu_lookup_jConfig]; simp only [isSameSignEqRoleLine, conjFullDock, revFullDock]
      rw [(pu_line_geom l).1, (pu_line_geom l).2.1]
      cases x.lookup (classSwapMat g) (lineA l) with
      | empty =>
        cases x.lookup (classSwapMat g) (lineB l) with
        | empty => rfl
        | occ sB _ => cases sB <;> rfl
      | occ sA rA =>
        cases x.lookup (classSwapMat g) (lineB l) with
        | empty => cases sA <;> rfl
        | occ sB rB => cases sA <;> cases sB <;> cases rA <;> cases rB <;> decide
    have hPh : ∀ (l : Fin 12) (x : HoneycombConfig),
        (if isSameSignEqRoleLine ((jConfig x).lookup g) l = true then NinthLoc6.omega else NinthLoc6.one) =
          (if isSameSignEqRoleLine (x.lookup (classSwapMat g)) l = true then NinthLoc6.omega else NinthLoc6.one) :=
      fun l x => by rw [hEqR l x]
    have hDiffR : ∀ (l : Fin 12) (x : HoneycombConfig),
        isSameSignDiffRoleLine ((jConfig x).lookup g) l = isSameSignDiffRoleLine (x.lookup (classSwapMat g)) l := fun l x => by
      rw [pu_lookup_jConfig]; simp only [isSameSignDiffRoleLine, conjFullDock, revFullDock]
      rw [(pu_line_geom l).1, (pu_line_geom l).2.1]
      cases x.lookup (classSwapMat g) (lineA l) with
      | empty =>
        cases x.lookup (classSwapMat g) (lineB l) with
        | empty => rfl
        | occ sB _ => cases sB <;> rfl
      | occ sA rA =>
        cases x.lookup (classSwapMat g) (lineB l) with
        | empty => cases sA <;> rfl
        | occ sB rB => cases sA <;> cases sB <;> cases rA <;> cases rB <;> decide
    refine pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_
      (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_
      (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_
        pu_fockJ_id))))))))))) φ
    all_goals
      refine pu_fockJ_comp ?_ ?_
      · refine pu_fockJ_phase ?_; exact hPh _
      · refine pu_fockJ_block2 ?_ ?_
        · exact pu_swapLineRolesConfig_jConfig g _
        · exact hDiffR _
  have hJD : ∀ ψ, fockJ (fockHalfCoin ψ) = fockHalfCoin (fockJ ψ) := fun ψ => by
    funext c; refine pu_globalOp_J_of_site (fun _ => True) (fun _ => Iff.rfl) ?_ ψ c (fun _ _ => trivial)
    intro g φ c' _
    refine congrFun ?_ c'
    have hFull : ∀ (l : Fin 12) (x : HoneycombConfig),
        isFullLine ((jConfig x).lookup g) l = isFullLine (x.lookup (classSwapMat g)) l := fun l x => by
      rw [pu_lookup_jConfig]; simp only [isFullLine, conjFullDock, revFullDock]
      rw [(pu_line_geom l).1, (pu_line_geom l).2.1]
      cases x.lookup (classSwapMat g) (lineA l) with
      | empty =>
        cases x.lookup (classSwapMat g) (lineB l) with
        | empty => rfl
        | occ sB _ => cases sB <;> rfl
      | occ sA _ =>
        cases x.lookup (classSwapMat g) (lineB l) with
        | empty => cases sA <;> rfl
        | occ sB _ => cases sA <;> cases sB <;> rfl
    have hPh : ∀ (l : Fin 12) (x : HoneycombConfig),
        (if isFullLine ((jConfig x).lookup g) l = true then NinthLoc6.zeta6 else NinthLoc6.one) =
          (if isFullLine (x.lookup (classSwapMat g)) l = true then NinthLoc6.zeta6 else NinthLoc6.one) :=
      fun l x => by rw [hFull l x]
    have hLone : ∀ (l : Fin 12) (x : HoneycombConfig),
        isLoneLine ((jConfig x).lookup g) l = isLoneLine (x.lookup (classSwapMat g)) l := fun l x => by
      rw [pu_lookup_jConfig]; simp only [isLoneLine, conjFullDock, revFullDock]
      rw [(pu_line_geom l).1, (pu_line_geom l).2.1]
      cases x.lookup (classSwapMat g) (lineA l) with
      | empty => cases x.lookup (classSwapMat g) (lineB l) with | empty => rfl | occ sB _ => cases sB <;> rfl
      | occ sA _ => cases x.lookup (classSwapMat g) (lineB l) with | empty => cases sA <;> rfl | occ sB _ => cases sA <;> cases sB <;> rfl
    refine pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_
      (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_
      (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_ (pu_fockJ_comp ?_
        pu_fockJ_id))))))))))) φ
    all_goals
      refine pu_fockJ_comp ?_ ?_
      · refine pu_fockJ_phase ?_; exact hPh _
      · refine pu_fockJ_block2 ?_ ?_
        · exact pu_swapLineSlotsConfig_jConfig g _
        · exact hLone _
  have hJPhi : ∀ ψ, UnimodularState ψ → fockJ (fockPhiOdd χ ψ) = fockPhiOdd χ (fockJ ψ) := fun ψ hψ => by
    funext c
    cases hc : isUnimodularConfig c with
    | true =>
      refine pu_globalOp_J_of_site (fun g => isUnimodularMat5 g = true) (fun g => by rw [pu_isUnimodularMat5_classSwap]) ?_ ψ c
        (fun g hg => (pu_list_all_iff _ _).mp hc g hg)
      intro g φ c' hUni
      change NinthLoc6.mul (NinthLoc6.zeta6Pow (dockParity g * χ.chi ((jConfig c').lookup g))) (φ (jConfig c')) =
        NinthLoc6.mul (NinthLoc6.zeta6Pow (dockParity (classSwapMat g) * χ.chi (c'.lookup (classSwapMat g)))) (φ (jConfig c'))
      rw [pu_lookup_jConfig, hCodd, χ.chi_rev, pu_dockParity_classSwap g hUni, Int.mul_neg, Int.neg_mul]
    | false =>
      have hU1 : UnimodularState (fockPhiOdd χ ψ) := pu_globalOp_preserves_unimodular ψ hψ
      have hUJ : UnimodularState (fockJ ψ) := fun c' hc' => hψ (jConfig c') (by rw [pu_isUnimodularConfig_jConfig]; exact hc')
      have hU2 : UnimodularState (fockPhiOdd χ (fockJ ψ)) := pu_globalOp_preserves_unimodular (fockJ ψ) hUJ
      rw [show fockJ (fockPhiOdd χ ψ) c = NinthLoc6.zero from hU1 (jConfig c) (by rw [pu_isUnimodularConfig_jConfig]; exact hc),
          hU2 c hc]
  have hL1 : ∀ φ, UnimodularState φ → UnimodularState (fockPhiOdd χ φ) := fun φ h => pu_globalOp_preserves_unimodular φ h
  have hL2 : ∀ φ, UnimodularState φ → UnimodularState (fockHalfCoin φ) := fun φ h => pu_globalOp_preserves_unimodular φ h
  have hK_U : ∀ φ, UnimodularState φ → UnimodularState (fockBounceK φ) := fun φ h => pu_globalOp_preserves_unimodular φ h
  have hMP_U : ∀ φ, UnimodularState φ → UnimodularState (fockMPair φ) := fun φ h => pu_globalOp_preserves_unimodular φ h
  have hMt_U : ∀ φ, UnimodularState φ → UnimodularState (fockMeet φ) := fun φ h => pu_globalOp_preserves_unimodular φ h
  have hL3 : ∀ φ, UnimodularState φ → UnimodularState (fockScale2Core φ) := fun φ h => hMt_U _ (hMP_U _ (hK_U φ h))
  have hJS2 : ∀ φ, fockJ (fockScale2Core φ) = fockScale2Core (fockJ φ) :=
    pu_fockJ_comp hJMeet (pu_fockJ_comp hJMPair hJK)
  have hC1 := pu_fockJ_comp_uni (fun φ _ => hJD φ) hJPhi hL1
  have hC1U : ∀ φ, UnimodularState φ → UnimodularState ((FockUnitary.comp fockHalfCoinUnit (fockPhiOddUnit χ)).op φ) :=
    fun φ h => hL2 _ (hL1 φ h)
  have hC2 := pu_fockJ_comp_uni (fun φ _ => hJS2 φ) hC1 hC1U
  have hC2U : ∀ φ, UnimodularState φ → UnimodularState ((FockUnitary.comp fockScale2CoreUnit (FockUnitary.comp fockHalfCoinUnit (fockPhiOddUnit χ))).op φ) :=
    fun φ h => hL3 _ (hC1U φ h)
  have hC3 := pu_fockJ_comp_uni (fun φ _ => hJD φ) hC2 hC2U
  have hC3U : ∀ φ, UnimodularState φ → UnimodularState ((FockUnitary.comp fockHalfCoinUnit (FockUnitary.comp fockScale2CoreUnit (FockUnitary.comp fockHalfCoinUnit (fockPhiOddUnit χ)))).op φ) :=
    fun φ h => hL2 _ (hC2U φ h)
  have hC4 := pu_fockJ_comp_uni hJPhi hC3 hC3U
  have hC4U : ∀ φ, UnimodularState φ → UnimodularState ((FockUnitary.comp (fockPhiOddUnit χ) (FockUnitary.comp fockHalfCoinUnit (FockUnitary.comp fockScale2CoreUnit (FockUnitary.comp fockHalfCoinUnit (fockPhiOddUnit χ))))).op φ) :=
    fun φ h => hL1 _ (hC3U φ h)
  have hBeatU : ∀ ψ, UnimodularState ψ → UnimodularState (fockBeat χ ψ) := fun ψ hψ =>
    pu_fockStream_preserves_unimodular _ (hC4U ψ hψ)
  have hJBeat : ∀ ψ, UnimodularState ψ → fockJ (fockBeat χ ψ) = fockBeat χ (fockJ ψ) :=
    pu_fockJ_comp_uni (fun φ _ => hJS φ) hC4 hC4U
  have hIterU : ∀ (t : Nat) (ψ : FockVec NinthLoc6 HoneycombConfig), UnimodularState ψ → UnimodularState (iter (fockBeat χ) t ψ) := by
    intro t; induction t with
    | zero => intro _ hψ; exact hψ
    | succ k ih => intro ψ hψ; simp only [iter]; exact hBeatU _ (ih ψ hψ)
  have hJIter : ∀ (t : Nat) (ψ : FockVec NinthLoc6 HoneycombConfig), UnimodularState ψ →
      fockJ (iter (fockBeat χ) t ψ) = iter (fockBeat χ) t (fockJ ψ) := by
    intro t; induction t with
    | zero => intro _ _; rfl
    | succ k ih => intro ψ hψ; simp only [iter]; rw [hJBeat _ (hIterU k ψ hψ), ih ψ hψ]
  exact ⟨hJ2, hJV1, hJQ, hJS, hJK, hJMPair, hJMeet, hJD, hJPhi, hBeatU, hJBeat, hJIter⟩

private def pu_revSig (s : DockState) : DockState := fun i => s (oppSlot i)
private def pu_pSig (s : DockState) : DockState := fun i => s (paritySlot i)
private def pu_cpSig (s : DockState) : DockState := conjDock (pu_pSig s)
private def pu_wSig : DockState := fullDockToDockState chiralWitnessDock
private def pu_isPosOrb (s : DockState) : Bool :=
  decide (s = pu_wSig ∨ s = pu_revSig pu_wSig ∨ s = pu_cpSig pu_wSig ∨ s = pu_revSig (pu_cpSig pu_wSig))
private def pu_isNegOrb (s : DockState) : Bool :=
  decide (s = conjDock pu_wSig ∨ s = pu_revSig (conjDock pu_wSig) ∨ s = pu_pSig pu_wSig ∨ s = pu_revSig (pu_pSig pu_wSig))

/-- Headline Theorem 9 (Non-Vacuity of `UnimodularState` & `J` Neutrality vs. Failure of Pure `L` on Chiral `Φ_odd`):
    Certifies `|V_1⟩` and `|chiralWitnessConfig⟩` are `UnimodularState`s and `witnessChiralInvariant` is strictly
    `C`-odd (instantiating all-time `fockJ ∘ U^t = U^t ∘ fockJ` non-vacuously), while pure connected class-swap
    `fockL` alone FAILS to commute with `fockPhiOdd witnessChiralInvariant`. -/
theorem thm_pu_witness_C_odd_and_L_breaks_PhiOdd :
    UnimodularState (ket (R := NinthLoc6) v1Config) ∧
    UnimodularState (ket (R := NinthLoc6) chiralWitnessConfig) ∧
    (∀ d : FullDock, witnessChiralInvariant.chi (conjFullDock d) = -witnessChiralInvariant.chi d) ∧
    (∀ (t : Nat) (ψ : FockVec NinthLoc6 HoneycombConfig), UnimodularState ψ →
      fockJ (iter (fockBeat witnessChiralInvariant) t ψ) = iter (fockBeat witnessChiralInvariant) t (fockJ ψ)) ∧
    fockL (fockPhiOdd witnessChiralInvariant (ket (R := NinthLoc6) chiralWitnessConfig)) ≠
      fockPhiOdd witnessChiralInvariant (fockL (ket (R := NinthLoc6) chiralWitnessConfig)) := by
  have hWNe : chiralWitnessDock ≠ v1FullDock := fun h0 => SlotState.noConfusion (congrFun h0 ⟨0, by decide⟩)
  have hRWNe : revFullDock chiralWitnessDock ≠ v1FullDock := fun h0 => SlotState.noConfusion (congrFun h0 ⟨3, by decide⟩)
  have hActV1 : ∀ (g : Mat5) (d : FullDock), d ≠ v1FullDock → (v1Config.setDock g d).activeDocks = [g] := fun g d hne => by
    change (if d = v1FullDock then [] else [(g, d)]).map Prod.fst = [g]
    rw [ite_eq_right hne]; rfl
  have hUniV1 : UnimodularState (ket (R := NinthLoc6) v1Config) := fun c hc => by
    unfold ket
    have hne : c ≠ v1Config := fun h0 => by rw [h0] at hc; exact Bool.noConfusion hc
    rw [ite_eq_right hne]; rfl
  have hUniW : UnimodularState (ket (R := NinthLoc6) chiralWitnessConfig) := fun c hc => by
    unfold ket
    have hIW : isUnimodularConfig chiralWitnessConfig = true := by
      unfold isUnimodularConfig chiralWitnessConfig; rw [hActV1 mat5Id chiralWitnessDock hWNe]
      decide
    have hne : c ≠ chiralWitnessConfig := fun h0 => by rw [h0, hIW] at hc; exact Bool.noConfusion hc
    rw [ite_eq_right hne]; rfl
  have hCodd : ∀ d : FullDock, witnessChiralInvariant.chi (conjFullDock d) = -witnessChiralInvariant.chi d := fun d => by
    have hT : fullDockToDockState (conjFullDock d) = conjDock (fullDockToDockState d) := by
      funext i; unfold fullDockToDockState conjFullDock conjDock; dsimp only
      cases d i with | empty => rfl | occ s _ => cases s <;> rfl
    have hP1 : ∀ s : DockState, pu_isPosOrb (conjDock s) = pu_isNegOrb s := fun s => by
      have hCR : ∀ x : DockState, conjDock (pu_revSig x) = pu_revSig (conjDock x) := fun _ => rfl
      have hCP : ∀ x : DockState, conjDock (pu_cpSig x) = pu_pSig x := fun x => by
        funext i; unfold pu_cpSig conjDock pu_pSig; cases x (paritySlot i) <;> rfl
      have hIff1 : (conjDock s = pu_wSig ∨ conjDock s = pu_revSig pu_wSig ∨ conjDock s = pu_cpSig pu_wSig ∨ conjDock s = pu_revSig (pu_cpSig pu_wSig)) ↔
          (s = conjDock pu_wSig ∨ s = pu_revSig (conjDock pu_wSig) ∨ s = pu_pSig pu_wSig ∨ s = pu_revSig (pu_pSig pu_wSig)) := by
        constructor <;> intro h <;> rcases h with h1 | h2 | h3 | h4
        · exact Or.inl (by rw [← conjDock_involutive s, h1])
        · exact Or.inr (Or.inl (by rw [← conjDock_involutive s, h2, hCR]))
        · exact Or.inr (Or.inr (Or.inl (by rw [← conjDock_involutive s, h3, hCP])))
