{
  "name": "@cluesurf/vibe",
  "version": "1.2.0",
  "license": "MIT",
  "main": "./host/index.js",
  "type": "module",
  "scripts": {
    "make": "rm -rf host && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "test": "npx tsx --no-warnings=ExperimentalWarning test/run.ts",
    "test:full": "npx tsx --no-warnings=ExperimentalWarning test/run.ts && npx tsx --no-warnings=ExperimentalWarning test/test.ts",
    "call": "npx tsx --no-warnings=ExperimentalWarning",
    "host": "pnpm make && npm publish --access=public",
    "lint": "eslint \"code/**/*.ts\" \"test/**/*.ts\"",
    "format": "eslint --fix \"code/**/*.ts\" \"test/**/*.ts\" \"*.ts\" && prettier --write \"code/**/*.ts\" \"test/**/*.ts\" \"*.ts\""
  },
  "prettier": "@cluesurf/wash/flow.json",
  "devDependencies": {
    "@types/lodash": "^4.14.194",
    "@types/node": "^22.15.3",
    "concurrently": "^7.6.0",
    "eslint": "^9.26.0",
    "jiti": "^2.4.2",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.15",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@cluesurf/wash": "^0.10.2",
    "@termsurf/have": "^0.2.0",
    "@termsurf/kink": "^0.1.2",
    "chalk": "^5.6.2",
    "dayjs": "^1.11.8",
    "gifenc": "^1.0.3",
    "lodash": "^4.17.21",
    "webgpu": "^0.4.0"
  }
}
